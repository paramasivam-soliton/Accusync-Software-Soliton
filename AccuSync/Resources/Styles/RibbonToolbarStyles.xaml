<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- RibbonToolbarStyles.xaml
         Pill-grouped horizontal toolbar styles.
         Merged in App.xaml alongside PatientInformationStyles. -->

    <!-- TODO: Duplicate brush keys between this file and PatientInformationStyles.xaml
         (e.g. border grays, accent blues). Consolidate into a shared palette dictionary. -->

    <!-- Color Brushes -->
    <SolidColorBrush x:Key="ToolbarBackgroundBrush"      Color="#D4E9F9"/>
    <SolidColorBrush x:Key="ToolbarBorderBrush"          Color="#e5e7eb"/>
    <SolidColorBrush x:Key="ToolbarAccentBrush"          Color="#473089"/>
    <SolidColorBrush x:Key="ToolbarButtonHoverBrush"     Color="#e0e7ff"/>
    <SolidColorBrush x:Key="ToolbarIconDefaultBrush"     Color="#4b5563"/>
    <SolidColorBrush x:Key="ToolbarTextDefaultBrush"     Color="#4b5563"/>
    <SolidColorBrush x:Key="ToolbarGroupBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="ToolbarGroupLabelBrush"      Color="#6b7280"/>

    <!-- Ribbon Button -->
    <!-- Icon path data is passed via the Button's Tag property.
         Layout: icon stacked vertically above label for compact width. -->
    <Style x:Key="RibbonButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Center">
                            <Path x:Name="ButtonIcon"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  Fill="{StaticResource ToolbarIconDefaultBrush}"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,5"
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <TextBlock x:Name="ButtonLabel"
                                       Text="{TemplateBinding Content}"
                                       FontSize="14"
                                       FontWeight="Normal"
                                       Foreground="{StaticResource ToolbarTextDefaultBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ToolbarButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#d4d8e8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonIcon" Property="Fill" Value="#C4C8CC"/>
                            <Setter TargetName="ButtonLabel" Property="Foreground" Value="#C4C8CC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group Label (category name below the buttons) -->
    <Style x:Key="RibbonGroupLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource ToolbarGroupLabelBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- Horizontal divider line inside pill, between buttons and group label -->
    <Style x:Key="RibbonGroupDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="#E5E7EB"/>
        <Setter Property="Margin" Value="2,4,2,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- Dropdown -->
    <Style x:Key="RibbonDropdownStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#e5e7eb"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Search TextBox -->
    <!-- Right padding (28px) leaves room for a search icon overlay. -->
    <Style x:Key="RibbonSearchTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,4,28,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#d1d5db"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Resources>
            <!-- Targets the implicit Border inside the default TextBox template
                 to get rounded corners without a full ControlTemplate override. -->
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="6"/>
            </Style>
        </Style.Resources>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="#473089"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Toolbar Container -->
    <Style x:Key="RibbonContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ToolbarBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ToolbarBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="20,8,16,4"/>
    </Style>

    <SolidColorBrush x:Key="ContentAreaBackgroundBrush" Color="#D4E9F9"/>

    <!-- TODO: These header styles are not referenced anywhere. Remove if not needed. -->
    <Style x:Key="PageHeaderTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#111827"/>
    </Style>

    <Style x:Key="PageHeaderSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

</ResourceDictionary>