<UserControl x:Class="AccuSync.Views.SystemConfiguration.UserProfileConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AccuSync.Resources"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>

        <!-- TODO: FormTextAreaStyle is a local variant (FormComboBoxStyle now in shared CommonStyles.xaml) -->


        <Style x:Key="FormTextAreaStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#5C5149"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MinHeight" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="10,8,10,8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4b5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#f3f4f6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpinnerBtnStyle" TargetType="RepeatButton">
            <Setter Property="Background" Value="#fafafa"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#e5e7eb"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#d1d5db"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="#D4E9F9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="White" CornerRadius="15" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270"
                                      ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3A3A3C" Offset="0"/>
                                <GradientStop Color="#202124" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{x:Static res:Strings.UserProfileConfigView_Title}" FontSize="14"
                                   FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="24">

                        <!-- AccuSync Locking Time -->
                        <Border Margin="0,0,0,24">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static res:Strings.UserProfileConfigView_AccuSyncLockingTime}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#4b5563" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6"
                                                    Height="40" MinWidth="160" Background="White">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="28"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="LockingTimeText" Text="15 min"
                                                               FontSize="13" Foreground="#5C5149"
                                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    <Border Grid.Column="1" BorderBrush="#D1D5DB" BorderThickness="1,0,0,0">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <RepeatButton Grid.Row="0" Style="{StaticResource SpinnerBtnStyle}"
                                                                          Click="LockingTime_Up">
                                                                <Path Width="8" Height="5" Stretch="Uniform" Fill="#666"
                                                                      Data="M0,5 L4,0 L8,5Z"/>
                                                            </RepeatButton>
                                                            <Border Grid.Row="1" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0">
                                                                <RepeatButton Style="{StaticResource SpinnerBtnStyle}"
                                                                              Click="LockingTime_Down">
                                                                    <Path Width="8" Height="5" Stretch="Uniform" Fill="#666"
                                                                          Data="M0,0 L4,5 L8,0Z"/>
                                                                </RepeatButton>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Password Security Rule -->
                        <Border>
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static res:Strings.UserProfileConfigView_PasswordSecurityRule}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#4b5563" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="PasswordRuleCombo"
                                                  Style="{StaticResource FormComboBoxStyle}"
                                                  SelectedIndex="0"
                                                  SelectionChanged="PasswordRuleCombo_SelectionChanged">
                                            <ComboBoxItem Content="{x:Static res:Strings.UserProfileConfigView_None}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.UserProfileConfigView_Simple}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.UserProfileConfigView_Complex}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Read-only description — auto-populated from selected rule -->
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:Strings.UserProfileConfigView_PasswordRuleDescription}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#4b5563" Margin="0,0,0,6"/>
                                    <TextBox x:Name="PasswordDescriptionBox"
                                             Style="{StaticResource FormTextAreaStyle}"
                                             IsEnabled="False"
                                             IsReadOnly="True"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
