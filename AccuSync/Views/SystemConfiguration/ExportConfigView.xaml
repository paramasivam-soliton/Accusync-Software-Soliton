<!-- TODO: FormTextBoxStyle / FormTextAreaStyle are local variants of the shared CommonStyles.xaml styles — reconcile or keep intentionally. -->
<!-- TODO: Two-panel list/detail layout identical to other config views. Extract shared ListDetailShell. -->
<UserControl x:Class="AccuSync.Views.SystemConfiguration.ExportConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AccuSync.Resources"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>

        <!-- Brushes -->
        <SolidColorBrush x:Key="MidnightBrush"      Color="#002856"/>
        <SolidColorBrush x:Key="BrightBlueBrush"    Color="#005FBE"/>
        <SolidColorBrush x:Key="TextBrush"          Color="#5C5149"/>
        <SolidColorBrush x:Key="GrayBrush"          Color="#9EA2AC"/>
        <SolidColorBrush x:Key="BorderBrush"        Color="#D1D5DB"/>
        <SolidColorBrush x:Key="SectionUnderline"   Color="#D4E9F9"/>
        <SolidColorBrush x:Key="SelectedBgBrush"    Color="#D4E9F9"/>
        <SolidColorBrush x:Key="PurpleBrush"        Color="#473089"/>
        <SolidColorBrush x:Key="TextDefaultBrush"   Color="#4b5563"/>

        <!-- Form ComboBox -->

        <!-- Form TextBox -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#5C5149"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="10,0,10,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4b5563"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f3f4f6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Form TextArea -->
        <Style x:Key="FormTextAreaStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#5C5149"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MinHeight" Value="70"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="10,8,10,8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4b5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Browse Button -->
        <Style x:Key="BrowseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#5C5149"/>
            <Setter Property="BorderBrush" Value="#5C5149"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F3F0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E8E0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="#D4E9F9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Export Config List Panel -->
        <Border Grid.Column="0" Background="White" CornerRadius="15" Margin="0,0,10,0" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3A3A3C" Offset="0"/>
                            <GradientStop Color="#202124" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="{x:Static res:Strings.ExportConfigView_ExportConfigurations}" FontSize="14" FontWeight="Bold" Foreground="White"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ListPanel"/>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#D4E9F9"
                            HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Path Width="28" Height="28" Stretch="Uniform" Fill="#3A3A3C"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M9 16h6v-6h4l-7-7-7 7h4v6zm-4 2h14v2H5v-2z"/>
                    </Border>
                    <TextBlock Text="{x:Static res:Strings.ExportConfigView_NoExportConfigurations}" FontSize="13"
                               Foreground="#9EA2AC" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Export Config Detail Panel -->
        <Border Grid.Column="1" Background="White" CornerRadius="15" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3A3A3C" Offset="0"/>
                            <GradientStop Color="#202124" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock x:Name="DetailHeader" Text="—" FontSize="14" FontWeight="Bold" Foreground="White"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel" Margin="24" Visibility="Collapsed">

                        <Border BorderThickness="0,0,0,2" BorderBrush="{StaticResource SectionUnderline}"
                                Padding="0,0,0,8" Margin="0,0,0,16">
                            <TextBlock Text="{x:Static res:Strings.ExportConfigView_ExportConfigurationDetails}" FontSize="14"
                                       FontWeight="Bold" Foreground="{StaticResource TextDefaultBrush}"/>
                        </Border>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextDefaultBrush}" Margin="0,0,0,6">
                                <Run Text="{x:Static res:Strings.ExportConfigView_Name}"/><Run Text="*" Foreground="#dc3545"/>
                            </TextBlock>
                            <TextBox x:Name="NameBox" Style="{StaticResource FormTextBoxStyle}"
                                     TextChanged="Field_Changed"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{x:Static res:Strings.ExportConfigView_Description}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextDefaultBrush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="DescriptionBox" Style="{StaticResource FormTextAreaStyle}"
                                     TextChanged="Field_Changed"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextDefaultBrush}" Margin="0,0,0,6">
                                    <Run Text="{x:Static res:Strings.ExportConfigView_ExportFormat}"/><Run Text="*" Foreground="#dc3545"/>
                                </TextBlock>
                                <ComboBox x:Name="ExportFormatCombo" Style="{StaticResource FormComboBoxStyle}"
                                          SelectedIndex="0" SelectionChanged="ComboBox_Changed">
                                    <ComboBoxItem Content="{x:Static res:Strings.ExportConfigView_FormatAccuSyncJson}"/>
                                    <ComboBoxItem Content="{x:Static res:Strings.ExportConfigView_FormatAccuSyncXml}"/>
                                    <ComboBoxItem Content="{x:Static res:Strings.ExportConfigView_FormatHiTrack}"/>
                                    <ComboBoxItem Content="{x:Static res:Strings.ExportConfigView_FormatOz}"/>
                                    <ComboBoxItem Content="{x:Static res:Strings.ExportConfigView_FormatCsv}"/>
                                    <ComboBoxItem Content="{x:Static res:Strings.ExportConfigView_FormatAlgo5Xml}"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextDefaultBrush}" Margin="0,0,0,6">
                                    <Run Text="{x:Static res:Strings.ExportConfigView_ExportData}"/><Run Text="*" Foreground="#dc3545"/>
                                </TextBlock>
                                <ComboBox x:Name="ExportDataCombo" Style="{StaticResource FormComboBoxStyle}"
                                          SelectedIndex="0" SelectionChanged="ComboBox_Changed">
                                    <ComboBoxItem Content="{x:Static res:Strings.ExportConfigView_DataAllPatients}"/>
                                    <ComboBoxItem Content="{x:Static res:Strings.ExportConfigView_DataChangedPatients}"/>
                                    <ComboBoxItem Content="{x:Static res:Strings.ExportConfigView_DataNewTestsOnly}"/>
                                    <ComboBoxItem Content="{x:Static res:Strings.ExportConfigView_DataSelectedPatients}"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextDefaultBrush}" Margin="0,0,0,6">
                                <Run Text="{x:Static res:Strings.ExportConfigView_ExportFolder}"/><Run Text="*" Foreground="#dc3545"/>
                            </TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ExportFolderBox" Style="{StaticResource FormTextBoxStyle}"
                                         IsReadOnly="True" TextChanged="Field_Changed"/>
                                <Button Grid.Column="2" Style="{StaticResource BrowseButtonStyle}"
                                        Click="BrowseFolder_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="16" Height="16" Stretch="Uniform" Fill="#5C5149"
                                              Margin="0,0,6,0" VerticalAlignment="Center"
                                              Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/>
                                        <TextBlock Text="{x:Static res:Strings.ExportConfigView_Browse}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="DetailEmpty" Grid.Row="1" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="{x:Static res:Strings.ExportConfigView_SelectConfigToView}" FontSize="13"
                               Foreground="#9EA2AC" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
