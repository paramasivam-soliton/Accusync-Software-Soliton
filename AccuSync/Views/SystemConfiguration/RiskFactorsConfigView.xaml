<UserControl x:Class="AccuSync.Views.SystemConfiguration.RiskFactorsConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AccuSync.Resources"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>

        <!-- TODO: FormTextAreaStyle is a local variant (FormTextBoxStyle / FormComboBoxStyle now in shared CommonStyles.xaml) -->


        <Style x:Key="FormTextAreaStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#5C5149"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MinHeight" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="10,8,10,8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4b5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#f3f4f6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </UserControl.Resources>

    <Grid Background="#D4E9F9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Risk Factors List -->
        <Border Grid.Column="0" Background="White" CornerRadius="15" Margin="0,0,10,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="15,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3A3A3C" Offset="0"/>
                            <GradientStop Color="#202124" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="{x:Static res:Strings.RiskFactorsConfigView_RiskFactors}"
                               FontSize="14" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </Border>

                <ListView Grid.Row="1" x:Name="RiskFactorsListView"
                          BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Padding="8"
                          SelectionChanged="RiskFactorsListView_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="CardBorder"
                                                Background="White"
                                                BorderBrush="Transparent"
                                                BorderThickness="1.5"
                                                CornerRadius="8"
                                                Padding="14" Cursor="Hand">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#d0d4db"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#D4E9F9"/>
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#005FBE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#4b5563"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State — no risk factors exist -->
                <Border x:Name="EmptyListPanel" Grid.Row="1" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="80" Height="80" CornerRadius="20"
                                Background="#D4E9F9" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Width="36" Height="36" Stretch="Uniform" Fill="#005FBE"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.RiskFactorsConfigView_NoRiskFactorsAvailable}"
                                   FontSize="13" Foreground="#9EA2AC" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Risk Factor Detail -->
        <Border Grid.Column="1" Background="White" CornerRadius="15" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3A3A3C" Offset="0"/>
                            <GradientStop Color="#202124" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock x:Name="DetailHeaderText" Text="{x:Static res:Strings.RiskFactorsConfigView_RiskFactorDetailsHeader}"
                               FontSize="14" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Empty State — no risk factor selected -->
                <Border x:Name="EmptyDetailPanel" Grid.Row="1" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="80" Height="80" CornerRadius="20"
                                Background="#D4E9F9" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Width="36" Height="36" Stretch="Uniform" Fill="#005FBE"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.RiskFactorsConfigView_SelectRiskFactorToViewDetails}"
                                   FontSize="13" Foreground="#9EA2AC" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              x:Name="DetailFormPanel" Visibility="Collapsed">
                    <StackPanel Margin="24">

                        <!-- Risk Factor Details -->
                        <Border Margin="0,0,0,24">
                            <StackPanel>
                                <Border BorderThickness="0,0,0,2" BorderBrush="#D4E9F9"
                                        Padding="0,0,0,8" Margin="0,0,0,16">
                                    <TextBlock Text="{x:Static res:Strings.RiskFactorsConfigView_RiskFactorDetails}" FontSize="14"
                                               FontWeight="Bold" Foreground="#4b5563"/>
                                </Border>

                                <StackPanel Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{x:Static res:Strings.RiskFactorsConfigView_Name}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563"/>
                                        <TextBlock Text=" *" FontSize="13" Foreground="#dc3545" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBox x:Name="NameBox" Style="{StaticResource FormTextBoxStyle}"
                                             TextChanged="Field_TextChanged"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{x:Static res:Strings.RiskFactorsConfigView_Description}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#4b5563" Margin="0,0,0,6"/>
                                    <TextBox x:Name="DescriptionBox" Style="{StaticResource FormTextAreaStyle}"
                                             TextChanged="Field_TextChanged"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static res:Strings.RiskFactorsConfigView_Active}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#4b5563" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="ActiveCombo" Style="{StaticResource FormComboBoxStyle}"
                                                  SelectionChanged="Field_SelectionChanged">
                                            <ComboBoxItem Content="{x:Static res:Strings.RiskFactorsConfigView_Yes}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.RiskFactorsConfigView_No}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Translation -->
                        <Border Margin="0,0,0,24">
                            <StackPanel>
                                <Border BorderThickness="0,0,0,2" BorderBrush="#D4E9F9"
                                        Padding="0,0,0,8" Margin="0,0,0,16">
                                    <TextBlock Text="{x:Static res:Strings.RiskFactorsConfigView_Translation}" FontSize="14"
                                               FontWeight="Bold" Foreground="#4b5563"/>
                                </Border>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static res:Strings.RiskFactorsConfigView_Language}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#4b5563" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="TranslationLanguageCombo"
                                                  Style="{StaticResource FormComboBoxStyle}"
                                                  SelectedIndex="0"
                                                  SelectionChanged="Field_SelectionChanged">
                                            <ComboBoxItem Content="{x:Static res:Strings.RiskFactorsConfigView_English}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.RiskFactorsConfigView_French}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.RiskFactorsConfigView_Italian}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.RiskFactorsConfigView_German}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.RiskFactorsConfigView_Spanish}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{x:Static res:Strings.RiskFactorsConfigView_Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#4b5563" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TranslationNameBox" Style="{StaticResource FormTextBoxStyle}"
                                             TextChanged="Field_TextChanged"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="{x:Static res:Strings.RiskFactorsConfigView_Description}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#4b5563" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TranslationDescriptionBox" Style="{StaticResource FormTextAreaStyle}"
                                             TextChanged="Field_TextChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- System Information — read-only -->
                        <Border>
                            <StackPanel>
                                <Border BorderThickness="0,0,0,2" BorderBrush="#D4E9F9"
                                        Padding="0,0,0,8" Margin="0,0,0,16">
                                    <TextBlock Text="{x:Static res:Strings.RiskFactorsConfigView_SystemInformation}" FontSize="14"
                                               FontWeight="Bold" Foreground="#4b5563"/>
                                </Border>

                                <TextBox x:Name="SystemInfoBox"
                                         Style="{StaticResource FormTextAreaStyle}"
                                         IsEnabled="False"
                                         IsReadOnly="True"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
