<UserControl x:Class="AccuSync.Views.PatientsTests.ImportReview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AccuSync.Resources">

    <UserControl.Resources>
        <!-- TODO: Brush duplication — these keys overlap with at least four other dialogs. Consolidate into a shared resource dictionary. -->
        <!-- Brushes -->
        <SolidColorBrush x:Key="PurpleBrush" Color="#473089"/>
        <SolidColorBrush x:Key="PurpleHoverBrush" Color="#5A3DA8"/>
        <SolidColorBrush x:Key="LightBlueBrush" Color="#D4E9F9"/>
        <SolidColorBrush x:Key="MidnightBrush" Color="#002856"/>
        <SolidColorBrush x:Key="BrightBlueBrush" Color="#005FBE"/>
        <SolidColorBrush x:Key="TextBrush" Color="#5C5149"/>
        <SolidColorBrush x:Key="GrayBrush" Color="#9EA2AC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#e5e7eb"/>
        <SolidColorBrush x:Key="BgLightBrush" Color="#f8f9fa"/>
        <SolidColorBrush x:Key="BgLighterBrush" Color="#f3f4f6"/>
        <SolidColorBrush x:Key="BgFooterBrush" Color="#f9fafb"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#d1d5db"/>
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="#059669"/>
        <SolidColorBrush x:Key="SuccessLightBgBrush" Color="#f0fdf4"/>
        <SolidColorBrush x:Key="SuccessLightBrush" Color="#dcfce7"/>
        <SolidColorBrush x:Key="SuccessBorderBrush" Color="#bbf7d0"/>
        <SolidColorBrush x:Key="SuccessHeaderTextBrush" Color="#065f46"/>
        <SolidColorBrush x:Key="WarnBgBrush" Color="#fffbeb"/>
        <SolidColorBrush x:Key="WarnTextBrush" Color="#92400e"/>
        <SolidColorBrush x:Key="WarnBorderBrush" Color="#fde68a"/>
        <SolidColorBrush x:Key="WarnIconBrush" Color="#d97706"/>
        <SolidColorBrush x:Key="ErrorBgBrush" Color="#fef2f2"/>
        <SolidColorBrush x:Key="ErrorTextBrush" Color="#991b1b"/>
        <SolidColorBrush x:Key="ErrorBorderBrush" Color="#fecaca"/>
        <SolidColorBrush x:Key="ErrorIconBrush" Color="#dc2626"/>
        <SolidColorBrush x:Key="NewTestBgBrush" Color="#f0fdf4"/>
        <SolidColorBrush x:Key="BlueBadgeBgBrush" Color="#eff6ff"/>
        <SolidColorBrush x:Key="BlueBadgeBorderBrush" Color="#bfdbfe"/>
        <SolidColorBrush x:Key="BlueBadgeTextBrush" Color="#1e40af"/>

        <!-- Radio Button Style -->
        <Style x:Key="DupRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,3,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OuterCircle" Width="16" Height="16" CornerRadius="8"
                                BorderBrush="#D1D5DB" BorderThickness="2" Background="White">
                            <Ellipse x:Name="InnerDot" Width="8" Height="8"
                                     Fill="{StaticResource BrightBlueBrush}" Visibility="Collapsed"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterCircle" Property="BorderBrush"
                                        Value="{StaticResource BrightBlueBrush}"/>
                                <Setter TargetName="InnerDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="10" Background="White" ClipToBounds="True" MaxWidth="1100" HorizontalAlignment="Stretch">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" Opacity="0.08" ShadowDepth="2" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#3A3A3C"
                    CornerRadius="15,15,0,0" Padding="20,16">
                <TextBlock Text="{x:Static res:Strings.ImportReview_Import}" Foreground="White" FontWeight="Bold"
                           FontSize="12" VerticalAlignment="Center"/>
            </Border>

            <!-- Body -->
            <!-- NOTE: Step2Panel and Step3Panel occupy the same Grid cell. Visibility toggling in code-behind controls which is shown. -->
            <Grid Grid.Row="1">

                <!-- Step 2: Preview and Select -->
                <Grid x:Name="Step2Panel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="DetailPanelColumn" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <!-- Patient Table -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Select All Bar -->
                        <Border Grid.Row="0" Padding="24,10,24,10"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="SelectAllCheckBox" Grid.Column="0"
                                          Width="15" Height="15" VerticalAlignment="Center"
                                          Checked="SelectAllCheckBox_Changed"
                                          Unchecked="SelectAllCheckBox_Changed"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static res:Strings.ImportReview_SelectAll}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource MidnightBrush}"
                                               Cursor="Hand" MouseLeftButtonDown="SelectAllLabel_Click"/>
                                    <TextBlock x:Name="SelectionCountText" FontSize="12"
                                               Foreground="{StaticResource GrayBrush}" Margin="12,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Table Header -->
                        <Border Grid.Row="1" Background="{StaticResource BgLighterBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,2"
                                Padding="24,8,24,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ImportReview_Name}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}"/>
                                <TextBlock Grid.Column="2" Text="{x:Static res:Strings.ImportReview_DateOfBirth}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}"/>
                                <TextBlock Grid.Column="3" Text="{x:Static res:Strings.ImportReview_Gender}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}"/>
                                <TextBlock Grid.Column="4" Text="{x:Static res:Strings.ImportReview_PatientId}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}"/>
                                <TextBlock Grid.Column="5" Text="{x:Static res:Strings.ImportReview_Tests}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}"/>
                            </Grid>
                        </Border>

                        <!-- Table Body -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="PatientListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="RowBorder" Padding="24,9,24,9"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="PatientRow_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Width="15" Height="15" VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBlock x:Name="NameText" Text="{Binding Name}"
                                                               FontSize="13" FontWeight="Medium"
                                                               Foreground="{StaticResource MidnightBrush}"/>
                                                    <Border x:Name="StatusBadge" CornerRadius="10"
                                                            Padding="6,1" Margin="5,0,0,0"
                                                            VerticalAlignment="Center" Visibility="Collapsed">
                                                        <TextBlock x:Name="StatusBadgeText" FontSize="10"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" x:Name="DobText"
                                                           Text="{Binding DateOfBirth}" FontSize="13"
                                                           Foreground="{StaticResource TextBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" x:Name="GenderText"
                                                           Text="{Binding Gender}" FontSize="13"
                                                           Foreground="{StaticResource TextBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" x:Name="PidText"
                                                           Text="{Binding PatientId}" FontSize="12"
                                                           FontFamily="Consolas"
                                                           Foreground="{StaticResource GrayBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" x:Name="TestCountText"
                                                           Text="{Binding TestCount}" FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource TextBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background"
                                                        Value="{StaticResource LightBlueBrush}"/>
                                                <Setter TargetName="RowBorder" Property="BorderBrush"
                                                        Value="{StaticResource BrightBlueBrush}"/>
                                                <Setter TargetName="RowBorder" Property="BorderThickness"
                                                        Value="1,1,1,1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                <Setter TargetName="NameText" Property="Opacity" Value="0.35"/>
                                                <Setter TargetName="StatusBadge" Property="Opacity" Value="0.35"/>
                                                <Setter TargetName="DobText" Property="Opacity" Value="0.35"/>
                                                <Setter TargetName="GenderText" Property="Opacity" Value="0.35"/>
                                                <Setter TargetName="PidText" Property="Opacity" Value="0.35"/>
                                                <Setter TargetName="TestCountText" Property="Opacity" Value="0.35"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="New">
                                                <Setter TargetName="StatusBadge" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="StatusBadge" Property="Background"
                                                        Value="{StaticResource SuccessLightBrush}"/>
                                                <Setter TargetName="StatusBadge" Property="BorderBrush"
                                                        Value="{StaticResource SuccessBorderBrush}"/>
                                                <Setter TargetName="StatusBadge" Property="BorderThickness" Value="1"/>
                                                <Setter TargetName="StatusBadgeText" Property="Text" Value="{x:Static res:Strings.ImportReview_BadgeNew}"/>
                                                <Setter TargetName="StatusBadgeText" Property="Foreground"
                                                        Value="{StaticResource SuccessGreenBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Duplicate">
                                                <Setter TargetName="StatusBadge" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="StatusBadge" Property="Background"
                                                        Value="{StaticResource WarnBgBrush}"/>
                                                <Setter TargetName="StatusBadge" Property="BorderBrush"
                                                        Value="{StaticResource WarnBorderBrush}"/>
                                                <Setter TargetName="StatusBadge" Property="BorderThickness" Value="1"/>
                                                <Setter TargetName="StatusBadgeText" Property="Text" Value="{x:Static res:Strings.ImportReview_BadgeDuplicate}"/>
                                                <Setter TargetName="StatusBadgeText" Property="Foreground"
                                                        Value="{StaticResource WarnIconBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Test Detail Panel -->
                    <Border Grid.Column="1" x:Name="DetailPanel"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Panel Header -->
                            <Border Grid.Row="0" Padding="16,8"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                    Background="{StaticResource BgLighterBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DetailTestCountText" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource GrayBrush}"
                                               VerticalAlignment="Center">
                                        <Run Text="{x:Static res:Strings.ImportReview_TestRecordsPrefix}"/>
                                        <Run x:Name="DetailTestCountRun" Text="0"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                    <Button Grid.Column="1" Click="CloseDetailPanel_Click" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CloseDtlBorder" Background="Transparent"
                                                        CornerRadius="4" Width="24" Height="24">
                                                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                          Fill="{StaticResource GrayBrush}" Width="14" Height="14"
                                                          Stretch="Uniform" HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CloseDtlBorder" Property="Background"
                                                                Value="{StaticResource BorderBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Panel Content -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16,12,16,16">

                                    <!-- Duplicate Warning -->
                                    <Border x:Name="DupWarningPanel" Visibility="Collapsed"
                                            Background="{StaticResource WarnBgBrush}"
                                            BorderBrush="{StaticResource WarnBorderBrush}"
                                            BorderThickness="1" CornerRadius="6"
                                            Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Path Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"
                                                      Fill="{StaticResource WarnIconBrush}" Width="13" Height="13"
                                                      Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,6,0"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource WarnTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Text="{x:Static res:Strings.ImportReview_DuplicateWarning}"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <RadioButton x:Name="DupActionReplace" GroupName="DupAction"
                                                             Style="{StaticResource DupRadioStyle}"
                                                             Checked="DupAction_Changed"/>
                                                <StackPanel>
                                                    <TextBlock Text="{x:Static res:Strings.ImportReview_ReplaceExisting}" FontSize="12"
                                                               Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="{x:Static res:Strings.ImportReview_ReplaceExistingDesc}"
                                                               FontSize="10" Foreground="{StaticResource GrayBrush}"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <RadioButton x:Name="DupActionCreate" GroupName="DupAction"
                                                             Style="{StaticResource DupRadioStyle}"
                                                             Checked="DupAction_Changed"/>
                                                <StackPanel>
                                                    <TextBlock Text="{x:Static res:Strings.ImportReview_CreateNew}" FontSize="12"
                                                               Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="{x:Static res:Strings.ImportReview_CreateNewDesc}"
                                                               FontSize="10" Foreground="{StaticResource GrayBrush}"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <RadioButton x:Name="DupActionAddTests" GroupName="DupAction"
                                                             Style="{StaticResource DupRadioStyle}"
                                                             Checked="DupAction_Changed"/>
                                                <StackPanel>
                                                    <TextBlock Text="{x:Static res:Strings.ImportReview_AddTests}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock x:Name="DupAddTestsSubText" FontSize="10"
                                                               Foreground="{StaticResource GrayBrush}"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="DupActionSkip" GroupName="DupAction"
                                                             Style="{StaticResource DupRadioStyle}"
                                                             Checked="DupAction_Changed"/>
                                                <TextBlock Text="{x:Static res:Strings.ImportReview_SkipPatient}" FontSize="12"
                                                           Foreground="{StaticResource TextBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Test Table -->
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="8" ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Background="{StaticResource BgLighterBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1" Padding="10,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.ImportReview_Date}" FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource GrayBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ImportReview_Time}" FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource GrayBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{x:Static res:Strings.ImportReview_Ear}" FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource GrayBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="{x:Static res:Strings.ImportReview_Type}" FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource GrayBrush}"/>
                                                    <TextBlock Grid.Column="4" Text="{x:Static res:Strings.ImportReview_Result}" FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource GrayBrush}"
                                                               HorizontalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <ItemsControl Grid.Row="1" x:Name="TestItemsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="TestRowBorder" Padding="10,7"
                                                                Background="Transparent"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="90"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                    <ColumnDefinition Width="70"/>
                                                                    <ColumnDefinition Width="60"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                            VerticalAlignment="Center">
                                                                    <Ellipse x:Name="NewTestDot" Width="5" Height="5"
                                                                             Fill="{StaticResource SuccessGreenBrush}"
                                                                             Visibility="Collapsed"
                                                                             Margin="0,0,4,0"
                                                                             VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Date}" FontSize="12"
                                                                               Foreground="{StaticResource TextBrush}"/>
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="1" Text="{Binding Time}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource GrayBrush}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Ear}"
                                                                           FontSize="12"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding Type}"
                                                                           FontSize="12" FontWeight="Medium"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           VerticalAlignment="Center"/>

                                                                <Grid Grid.Column="4" HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center">
                                                                    <Path x:Name="PassIcon" Visibility="Collapsed"
                                                                          Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                                                          Fill="{StaticResource SuccessGreenBrush}"
                                                                          Width="14" Height="14" Stretch="Uniform"/>
                                                                    <Path x:Name="ReferIcon" Visibility="Collapsed"
                                                                          Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                                          Fill="{StaticResource ErrorIconBrush}"
                                                                          Width="12" Height="12" Stretch="Uniform"/>
                                                                    <TextBlock x:Name="IncompleteIcon"
                                                                               Visibility="Collapsed"
                                                                               Text="?" FontSize="14"
                                                                               FontWeight="Bold"
                                                                               Foreground="{StaticResource GrayBrush}"
                                                                               HorizontalAlignment="Center"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>

                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsExisting}" Value="False">
                                                                <Setter TargetName="TestRowBorder"
                                                                        Property="Background"
                                                                        Value="{StaticResource NewTestBgBrush}"/>
                                                                <Setter TargetName="NewTestDot"
                                                                        Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="Pass">
                                                                <Setter TargetName="PassIcon"
                                                                        Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="Refer">
                                                                <Setter TargetName="ReferIcon"
                                                                        Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="Incomplete">
                                                                <Setter TargetName="IncompleteIcon"
                                                                        Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>

                                    <StackPanel x:Name="NewTestLegend" Visibility="Collapsed"
                                                Orientation="Horizontal" Margin="0,8,0,0">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource SuccessGreenBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{x:Static res:Strings.ImportReview_NewTestRecords}" FontSize="10"
                                                   Foreground="{StaticResource GrayBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Step 3: Results -->
                <!-- TODO: Imported/Errors/Skipped sections share ~90% identical structure. Extract a shared ResultSection DataTemplate parameterized by header brush set. -->
                <ScrollViewer x:Name="Step3Panel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,24">

                        <!-- Success Summary -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Border Width="56" Height="56" CornerRadius="28"
                                    Background="{StaticResource SuccessLightBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                      Fill="#059669" Width="28" Height="28" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{x:Static res:Strings.ImportReview_ImportComplete}" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource MidnightBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ResultSummaryText" FontSize="13"
                                       Foreground="{StaticResource GrayBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Imported Section -->
                        <Border x:Name="ImportedSection" Visibility="Collapsed"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Margin="0,0,0,16" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource SuccessLightBgBrush}"
                                        Padding="16,10" BorderBrush="{StaticResource SuccessBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                                  Fill="#059669" Width="16" Height="16" Stretch="Uniform"/>
                                            <TextBlock Text="{x:Static res:Strings.ImportReview_Imported}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SuccessHeaderTextBrush}"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ImportedCountText" HorizontalAlignment="Right"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource SuccessHeaderTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ItemsControl Grid.Row="1" x:Name="ImportedList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="16,8" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource MidnightBrush}"
                                                               MinWidth="160"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PatientId}" FontSize="11"
                                                               FontFamily="Consolas"
                                                               Foreground="{StaticResource GrayBrush}"
                                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="3" x:Name="ResultBadge"
                                                            CornerRadius="10" Padding="8,2"
                                                            VerticalAlignment="Center" Visibility="Collapsed">
                                                        <TextBlock x:Name="ResultBadgeText" FontSize="10"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Badge}" Value="TESTS ADDED">
                                                    <Setter TargetName="ResultBadge" Property="Visibility"
                                                            Value="Visible"/>
                                                    <Setter TargetName="ResultBadge" Property="Background"
                                                            Value="{StaticResource WarnBgBrush}"/>
                                                    <Setter TargetName="ResultBadge" Property="BorderBrush"
                                                            Value="{StaticResource WarnBorderBrush}"/>
                                                    <Setter TargetName="ResultBadge" Property="BorderThickness"
                                                            Value="1"/>
                                                    <Setter TargetName="ResultBadgeText" Property="Text"
                                                            Value="{x:Static res:Strings.ImportReview_BadgeTestsAdded}"/>
                                                    <Setter TargetName="ResultBadgeText" Property="Foreground"
                                                            Value="{StaticResource WarnTextBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Badge}" Value="REPLACED">
                                                    <Setter TargetName="ResultBadge" Property="Visibility"
                                                            Value="Visible"/>
                                                    <Setter TargetName="ResultBadge" Property="Background"
                                                            Value="{StaticResource BlueBadgeBgBrush}"/>
                                                    <Setter TargetName="ResultBadge" Property="BorderBrush"
                                                            Value="{StaticResource BlueBadgeBorderBrush}"/>
                                                    <Setter TargetName="ResultBadge" Property="BorderThickness"
                                                            Value="1"/>
                                                    <Setter TargetName="ResultBadgeText" Property="Text"
                                                            Value="{x:Static res:Strings.ImportReview_BadgeReplaced}"/>
                                                    <Setter TargetName="ResultBadgeText" Property="Foreground"
                                                            Value="{StaticResource BlueBadgeTextBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Badge}" Value="NEW RECORD">
                                                    <Setter TargetName="ResultBadge" Property="Visibility"
                                                            Value="Visible"/>
                                                    <Setter TargetName="ResultBadge" Property="Background"
                                                            Value="{StaticResource BgLighterBrush}"/>
                                                    <Setter TargetName="ResultBadge" Property="BorderBrush"
                                                            Value="{StaticResource BorderBrush}"/>
                                                    <Setter TargetName="ResultBadge" Property="BorderThickness"
                                                            Value="1"/>
                                                    <Setter TargetName="ResultBadgeText" Property="Text"
                                                            Value="{x:Static res:Strings.ImportReview_BadgeNewRecord}"/>
                                                    <Setter TargetName="ResultBadgeText" Property="Foreground"
                                                            Value="{StaticResource TextBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- Errors Section -->
                        <Border x:Name="ErrorsSection" Visibility="Collapsed"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Margin="0,0,0,16" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource ErrorBgBrush}"
                                        Padding="16,10" BorderBrush="{StaticResource ErrorBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                                  Fill="{StaticResource ErrorIconBrush}" Width="16" Height="16"
                                                  Stretch="Uniform"/>
                                            <TextBlock Text="{x:Static res:Strings.ImportReview_Errors}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ErrorTextBrush}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ErrorsCountText" HorizontalAlignment="Right"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource ErrorTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ItemsControl Grid.Row="1" x:Name="ErrorsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="16,8" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource MidnightBrush}"
                                                               MinWidth="160"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PatientId}" FontSize="11"
                                                               FontFamily="Consolas"
                                                               Foreground="{StaticResource GrayBrush}"
                                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                                              Fill="{StaticResource ErrorIconBrush}" Width="12"
                                                              Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Detail}" FontSize="11"
                                                                   Foreground="{StaticResource ErrorIconBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- Skipped Section -->
                        <Border x:Name="SkippedSection" Visibility="Collapsed"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Margin="0,0,0,16" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource BgLighterBrush}"
                                        Padding="16,10" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11H7v-2h10v2z"
                                                  Fill="{StaticResource GrayBrush}" Width="16" Height="16"
                                                  Stretch="Uniform"/>
                                            <TextBlock Text="{x:Static res:Strings.ImportReview_Skipped}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource GrayBrush}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="SkippedCountText" HorizontalAlignment="Right"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource GrayBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ItemsControl Grid.Row="1" x:Name="SkippedList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="16,8" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource MidnightBrush}"
                                                               MinWidth="160"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PatientId}" FontSize="11"
                                                               FontFamily="Consolas"
                                                               Foreground="{StaticResource GrayBrush}"
                                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Detail}" FontSize="11"
                                                               Foreground="{StaticResource GrayBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Background="{StaticResource BgFooterBrush}" Padding="24,12">
                <Grid>
                    <!-- Step 2 Footer -->
                    <Grid x:Name="Step2Footer">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Click="BackButton_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BackBorder" Background="White"
                                            BorderBrush="{StaticResource ButtonBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="20,8">
                                        <TextBlock Text="{x:Static res:Strings.ImportReview_Back}" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BackBorder" Property="Background"
                                                    Value="{StaticResource BgLighterBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="2" Click="CancelImport_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="FtrCancelBorder" Background="White"
                                            BorderBrush="{StaticResource ButtonBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="20,8">
                                        <TextBlock Text="{x:Static res:Strings.ImportReview_Cancel}" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="FtrCancelBorder" Property="Background"
                                                    Value="{StaticResource BgLighterBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="ImportButton" Grid.Column="3" Click="ImportButton_Click"
                                Cursor="Hand" Margin="8,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ImportBorder" Background="{StaticResource PurpleBrush}"
                                            CornerRadius="6" Padding="20,8">
                                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="White" FontFamily="Segoe UI"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ImportBorder" Property="Background"
                                                    Value="{StaticResource PurpleHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Step 3 Footer -->
                    <StackPanel x:Name="Step3Footer" Visibility="Collapsed"
                                Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="DoneButton_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="DoneBorder" Background="{StaticResource PurpleBrush}"
                                            CornerRadius="6" Padding="24,8">
                                        <TextBlock Text="{x:Static res:Strings.ImportReview_Done}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="White" FontFamily="Segoe UI"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="DoneBorder" Property="Background"
                                                    Value="{StaticResource PurpleHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>