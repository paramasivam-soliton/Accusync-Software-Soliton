                            <Button Grid.Column="1" Content="{x:Static res:Strings.AdditionalInfoTab_Today}" Margin="4,0,0,0" Padding="8,6" Background="#f0f0f0" BorderBrush="#ddd" BorderThickness="1" Cursor="Hand" FontSize="12" Click="SetTodayReferralDate_Click" ToolTip="{x:Static res:Strings.AdditionalInfoTab_SetToTodaysDate}"/>
