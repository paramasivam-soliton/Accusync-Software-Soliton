                            <ComboBoxItem Content="{x:Static res:Strings.AdditionalInfoTab_CountryCanada}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.AdditionalInfoTab_CountryMexico}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.AdditionalInfoTab_CountryUnitedKingdom}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.AdditionalInfoTab_CountryGermany}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.AdditionalInfoTab_CountryFrance}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.AdditionalInfoTab_CountryItaly}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.AdditionalInfoTab_CountrySpain}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.AdditionalInfoTab_CountryChina}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.AdditionalInfoTab_CountryIndia}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.AdditionalInfoTab_CountryJapan}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.AdditionalInfoTab_CountrySouthKorea}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.AdditionalInfoTab_Other}"/>
