                    <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock Text="{x:Static res:Strings.AdditionalInfoTab_ZipCode}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <TextBox Text="{Binding CaregiverZipCode}" Style="{StaticResource FieldTextBox}" Padding="8,8,32,8"/>
                            <Button Style="{StaticResource InnerClearButton}" HorizontalAlignment="Right" Margin="0,0,4,0" Click="ClearCaregiverZipCode_Click" ToolTip="{x:Static res:Strings.AdditionalInfoTab_ClearField}" Visibility="{Binding CaregiverZipCode, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </Grid>
