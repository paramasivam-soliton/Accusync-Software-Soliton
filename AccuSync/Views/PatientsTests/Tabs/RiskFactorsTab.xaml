<UserControl x:Class="AccuSync.Views.PatientsTests.Tabs.RiskFactorsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AccuSync.Resources">

    <!-- RiskFactorsTab.xaml
         Tab 2 of PatientInformationView: bulk actions bar + 16 risk factor rows.
         Styles from PatientInformationStyles.xaml (merged in App.xaml).
         Button names must follow the convention {PropertyName}Yes/No/Unknown
         to match code-behind's FindName lookups in UpdateRiskFactorButtons. -->

    <UserControl.Resources>
        <Style x:Key="RiskBulkButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <!-- Header with bulk action buttons -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.RiskFactorsTab_RiskFactors}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,17,0">
                            <Button Content="{x:Static res:Strings.RiskFactorsTab_AllYes}" Background="#ECB623" Width="80" Style="{StaticResource RiskBulkButtonStyle}" Margin="0,0,8,0" Click="AllRisksYes_Click"/>
                            <Button Content="{x:Static res:Strings.RiskFactorsTab_AllNo}" Background="#429C10" Width="80" Style="{StaticResource RiskBulkButtonStyle}" Margin="0,0,8,0" Click="AllRisksNo_Click"/>
                            <Button Content="{x:Static res:Strings.RiskFactorsTab_AllUnknown}" Background="#6c757d" Width="90" Style="{StaticResource RiskBulkButtonStyle}" Click="AllRisksUnknown_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TODO: All 16 rows below are identical in structure — only the
                     display text, x:Name prefix, and Tag prefix differ. Generate
                     these from an ItemsControl bound to a risk factor definitions
                     list. This would cut ~350 lines of XAML and make adding a
                     17th factor a one-line data change. The x:Name convention for
                     FindName would need to move to a Tag-based or DataContext-based
                     lookup instead. -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,16,0,16">
                    <StackPanel x:Name="AllRiskFactors">

                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Static res:Strings.RiskFactorsTab_FamilyHistory}" FontSize="13" Foreground="{StaticResource NavyBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="FamilyHistoryYes" Width="80" Height="32" Margin="0,0,8,0" Click="SetRiskFactor_Click" Tag="FamilyHistory|Yes"><TextBlock><Run Text="✓ "/><Run Text="{x:Static res:Strings.RiskFactorsTab_Yes}"/></TextBlock></Button>
                                    <Button x:Name="FamilyHistoryNo" Width="80" Height="32" Margin="0,0,8,0" Click="SetRiskFactor_Click" Tag="FamilyHistory|No"><TextBlock><Run Text="✕ "/><Run Text="{x:Static res:Strings.RiskFactorsTab_No}"/></TextBlock></Button>
                                    <Button x:Name="FamilyHistoryUnknown" Width="90" Height="32" Click="SetRiskFactor_Click" Tag="FamilyHistory|Unknown"><TextBlock><Run Text="? "/><Run Text="{x:Static res:Strings.RiskFactorsTab_Unknown}"/></TextBlock></Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
