                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static res:Strings.FacesheetReview_Physician}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtPhysician" Style="{StaticResource ReviewTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{x:Static res:Strings.FacesheetReview_Medication}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtMedication" Style="{StaticResource ReviewTextBox}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,12" Background="White">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="{x:Static res:Strings.FacesheetReview_Back}" Style="{StaticResource FooterSecondaryButton}"
                            Margin="0,0,8,0" Click="BackButton_Click"/>
                    <Button Content="{x:Static res:Strings.FacesheetReview_Cancel}" Style="{StaticResource FooterSecondaryButton}"
                            Click="CancelButton_Click"/>
                </StackPanel>

                <Button HorizontalAlignment="Right" Click="ImportButton_Click"
                        Padding="20,8" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{StaticResource PurpleBrush}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="14" Height="14" Stretch="Uniform" Fill="White"
                                                      Margin="0,0,6,0" VerticalAlignment="Center"
                                                      Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                                <TextBlock Text="{x:Static res:Strings.FacesheetReview_ImportPatient}" Foreground="White"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>