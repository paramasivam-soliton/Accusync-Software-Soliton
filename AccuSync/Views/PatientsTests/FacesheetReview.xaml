                                            <Button Content="{x:Static res:Strings.FacesheetReview_Unknown}" Style="{StaticResource RiskToggleStyle}" Tag="Unknown" Click="RiskButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Additional tab -->
                <TabItem Header="{x:Static res:Strings.FacesheetReview_TabAdditional}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.FacesheetReview_MotherInformation}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource MidnightBrush}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static res:Strings.FacesheetReview_FirstName}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtMotherFirstName" Style="{StaticResource ReviewTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{x:Static res:Strings.FacesheetReview_LastName}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtMotherLastName" Style="{StaticResource ReviewTextBox}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static res:Strings.FacesheetReview_Dob}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtMotherDOB" Style="{StaticResource ReviewTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{x:Static res:Strings.FacesheetReview_Phone}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtMotherPhone" Style="{StaticResource ReviewTextBox}"/>
