                                    <Grid Margin="0,0,0,6" Tag="Ototoxic Medications">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.FacesheetReview_RiskOtotoxicMedications}"
                                                   FontSize="13" Foreground="{StaticResource HeadingBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="{x:Static res:Strings.FacesheetReview_Yes}" Style="{StaticResource RiskToggleStyle}" Tag="Yes" Click="RiskButton_Click"/>
                                            <Button Content="{x:Static res:Strings.FacesheetReview_No}" Style="{StaticResource RiskToggleStyle}" Tag="No" Click="RiskButton_Click"/>
                                            <Button Content="{x:Static res:Strings.FacesheetReview_Unknown}" Style="{StaticResource RiskToggleStyle}" Tag="Unknown" Click="RiskButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,6" Tag="Perinatal or Postnatal Infection">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.FacesheetReview_RiskPerinatalInfection}"
                                                   FontSize="13" Foreground="{StaticResource HeadingBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="{x:Static res:Strings.FacesheetReview_Yes}" Style="{StaticResource RiskToggleStyle}" Tag="Yes" Click="RiskButton_Click"/>
                                            <Button Content="{x:Static res:Strings.FacesheetReview_No}" Style="{StaticResource RiskToggleStyle}" Tag="No" Click="RiskButton_Click"/>
