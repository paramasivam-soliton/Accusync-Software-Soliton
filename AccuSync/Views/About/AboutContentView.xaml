<UserControl x:Class="AccuSync.Views.About.AboutContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AccuSync.Resources"
             Background="Transparent">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="500"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="15"
                Margin="0,0,20,0" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270"
                                  ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3A3A3C" Offset="0"/>
                            <GradientStop Color="#202124" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="{x:Static res:Strings.AboutContentView_AboutAccuSync}" FontSize="14" FontWeight="Bold" Foreground="White"/>
                </Border>

                <!-- Version and Build text are populated from assembly metadata in code-behind. -->
                <StackPanel Grid.Row="1" Margin="24">

                    <TextBlock x:Name="VersionText" Text="Version: 1.0.0"
                               FontSize="14" Foreground="#5C5149" Margin="0,0,0,8"/>

                    <TextBlock x:Name="BuildText" Text="Build: —"
                               FontSize="14" Foreground="#5C5149" Margin="0,0,0,24"/>

                    <Border BorderThickness="0,1,0,0" BorderBrush="#e5e7eb" Padding="0,20,0,0">
                        <TextBlock Text="{x:Static res:Strings.AboutContentView_Copyright}"
                                   FontSize="13" Foreground="#9EA2AC" HorizontalAlignment="Center"/>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>