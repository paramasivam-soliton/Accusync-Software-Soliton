<!-- TODO: View and Print quick-action buttons share identical ControlTemplates (only icon path differs). Extract a shared circular icon button style. -->
<!-- TODO: The purple rounded button template (Refresh, Close) is duplicated. Extract into a shared dialog button style. -->
<!-- NOTE: Badge Background/Foreground are string hex values, not Brushes. Works because WPF auto-converts,
     but would need explicit converters in a stricter binding context. -->
<local:CardListDialogBase x:Class="AccuSync.Views.Dashboard.Dialogs.AssignedPatientsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AccuSync.Views.Dashboard.Dialogs"
        xmlns:res="clr-namespace:AccuSync.Resources"
        Title="{x:Static res:Strings.AssignedPatientsDialog_Title}"
        Height="600"
        Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="25,20" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F8F9FA" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{x:Static res:Strings.AssignedPatientsDialog_AssignedToday}"
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#2C3E50"
                               VerticalAlignment="Center"/>

                    <Border x:Name="PatientCountBadge"
                            Grid.Column="1"
                            Background="#428FEC"
                            CornerRadius="14"
                            Padding="15,6"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="PatientCountText"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </Border>
                </Grid>

                <!-- Search Bar -->
                <Border Grid.Row="1"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1.5"
                        CornerRadius="18"
                        Height="36"
                        Padding="15,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Fill="#9CA3AF"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center"
                              Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalAlignment="Center"
                                 FontSize="13"
                                 Foreground="#111827"
                                 Text="{x:Static res:Strings.AssignedPatientsDialog_SearchPlaceholder}"
                                 GotFocus="SearchBox_GotFocus"
                                 LostFocus="SearchBox_LostFocus"
                                 TextChanged="SearchBox_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="Foreground" Value="#111827"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Content Area — three mutually exclusive states toggled in code-behind -->
        <Grid Grid.Row="1">
            <!-- Loading State -->
            <!-- TODO: Three skeleton cards are identical except opacity. Generate from ItemsControl or extract a keyed style. -->
            <ScrollViewer x:Name="LoadingView" 
                          VerticalScrollBarVisibility="Auto" 
                          Visibility="Collapsed"
                          Margin="20">
                <Border Background="White" CornerRadius="10" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                    </Border.Effect>

                    <StackPanel>
                        <Border Margin="0,0,0,15" Opacity="0.6">
                            <Grid Height="70">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Border Width="100" Height="12" Background="#E5E7EB" CornerRadius="6" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                    <Border Width="150" Height="10" Background="#E5E7EB" CornerRadius="5" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Border Width="120" Height="10" Background="#E5E7EB" CornerRadius="5" Margin="0,0,0,8"/>
                                    <Border Width="100" Height="8" Background="#E5E7EB" CornerRadius="4"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,0,0,15" Opacity="0.4">
                            <Grid Height="70">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Border Width="100" Height="12" Background="#E5E7EB" CornerRadius="6" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                    <Border Width="150" Height="10" Background="#E5E7EB" CornerRadius="5" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Border Width="120" Height="10" Background="#E5E7EB" CornerRadius="5" Margin="0,0,0,8"/>
                                    <Border Width="100" Height="8" Background="#E5E7EB" CornerRadius="4"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Opacity="0.2">
                            <Grid Height="70">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Border Width="100" Height="12" Background="#E5E7EB" CornerRadius="6" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                    <Border Width="150" Height="10" Background="#E5E7EB" CornerRadius="5" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Border Width="120" Height="10" Background="#E5E7EB" CornerRadius="5" Margin="0,0,0,8"/>
                                    <Border Width="100" Height="8" Background="#E5E7EB" CornerRadius="4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Empty State -->
            <Border x:Name="EmptyView" 
                    Visibility="Collapsed"
                    Margin="20">
                <Border Background="White" CornerRadius="10" Padding="40">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                    </Border.Effect>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="90" Height="90" Fill="#F3F4F6" HorizontalAlignment="Center"/>
                        <TextBlock Text="📋" FontSize="50" HorizontalAlignment="Center" Margin="0,-70,0,20"/>

                        <TextBlock Text="{x:Static res:Strings.AssignedPatientsDialog_NoPatientsAssigned}"
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#2C3E50" 
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,10"/>
                        <TextBlock Text="{x:Static res:Strings.AssignedPatientsDialog_NoPatientsLine1}"
                                   FontSize="13" 
                                   Foreground="#6B7280" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Static res:Strings.AssignedPatientsDialog_NoPatientsLine2}"
                                   FontSize="13" 
                                   Foreground="#6B7280" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <Button Content="{x:Static res:Strings.AssignedPatientsDialog_Refresh}"
                                Width="150"
                                Height="36"
                                Background="#6B4BA8"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Medium"
                                Cursor="Hand"
                                Click="RefreshButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="8"
                                                        Padding="20,8">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#5A3B8F"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Patient Cards -->
            <ScrollViewer x:Name="PatientListView" VerticalScrollBarVisibility="Auto" Visibility="Visible" Margin="20">
                <ItemsControl x:Name="PatientListItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" 
                                    CornerRadius="10" 
                                    Padding="20,15"
                                    Margin="0,0,0,10"
                                    Cursor="Hand"
                                    MouseEnter="PatientCard_MouseEnter"
                                    MouseLeave="PatientCard_MouseLeave"
                                    MouseLeftButtonDown="PatientCard_Click"
                                    Tag="{Binding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                                </Border.Effect>

                                <Grid>
                                    <Rectangle x:Name="AccentStrip"
                                               HorizontalAlignment="Left" 
                                               Width="4" 
                                               RadiusX="2" 
                                               RadiusY="2"
                                               Fill="{Binding AccentColor}"
                                               Margin="-20,-15,-20,-15"
                                               Opacity="0"/>

                                    <Grid Margin="10,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding MRN}" 
                                                           FontSize="14" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="#111827"
                                                           Margin="0,0,15,5"/>

                                                <ItemsControl Grid.Column="1" 
                                                              ItemsSource="{Binding Badges}"
                                                              VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding Background}" 
                                                                    CornerRadius="11" 
                                                                    Padding="10,4" 
                                                                    Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Text}" 
                                                                           FontSize="10" 
                                                                           Foreground="{Binding Foreground}" 
                                                                           FontWeight="SemiBold"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>

                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{Binding FirstName}" FontSize="13" Foreground="#6B7280"/>
                                                <Run Text=" " />
                                                <Run Text="{Binding LastName}" FontSize="13" Foreground="#6B7280"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,15,0">
                                                <TextBlock Text="{Binding DateOfBirth, StringFormat='DOB: {0:MM/dd/yyyy}'}" 
                                                           FontSize="11" 
                                                           Foreground="#6B7280"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding DateStatusLabel}" 
                                                           FontSize="10" 
                                                           Foreground="#9CA3AF"
                                                           Margin="0,2,0,0"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>

                                            <StackPanel x:Name="QuickActions" 
                                                        Grid.Column="1" 
                                                        Orientation="Horizontal"
                                                        Opacity="0">
                                                <Button Width="32" Height="32" 
                                                        Background="#F3F4F6"
                                                        BorderThickness="0"
                                                        Margin="0,0,5,0"
                                                        Cursor="Hand"
                                                        ToolTip="{x:Static res:Strings.AssignedPatientsDialog_ViewDetailsTooltip}"
                                                        Click="ViewButton_Click"
                                                        Tag="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" 
                                                                                CornerRadius="16">
                                                                            <Path Width="16" Height="16" 
                                                                                  Stretch="Uniform" 
                                                                                  Fill="#6B4BA8"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#6B4BA8"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Width="32" Height="32" 
                                                        Background="#F3F4F6"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="{x:Static res:Strings.AssignedPatientsDialog_PrintReportTooltip}"
                                                        Click="PrintButton_Click"
                                                        Tag="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" 
                                                                                CornerRadius="16">
                                                                            <Path Width="16" Height="16" 
                                                                                  Stretch="Uniform" 
                                                                                  Fill="#6B4BA8"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Data="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#6B4BA8"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="20" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Button Content="{x:Static res:Strings.AssignedPatientsDialog_Close}"
                    Width="100"
                    Height="36"
                    HorizontalAlignment="Right"
                    Background="#6B4BA8"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    FontWeight="Medium"
                    Cursor="Hand"
                    Click="CloseButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8"
                                            Padding="20,8">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A3B8F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Border>
    </Grid>
</local:CardListDialogBase>