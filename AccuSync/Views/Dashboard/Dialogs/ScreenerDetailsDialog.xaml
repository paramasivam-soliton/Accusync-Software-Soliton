<Window x:Class="AccuSync.Views.Dashboard.Dialogs.ScreenerDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AccuSync.Resources"
        Title="{x:Static res:Strings.ScreenerDetailsDialog_Title}"
        Height="700" 
        Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Glassmorphism Header -->
        <Border Grid.Row="0" Padding="25,20" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F8F9FA" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0"
                        Width="32" Height="32"
                        Background="#E5E7EB"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BackButton_Click"
                        ToolTip="{x:Static res:Strings.ScreenerDetailsDialog_BackToolTip}"
                        Margin="0,0,15,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="16">
                                            <Path Width="16" Height="16" 
                                                  Stretch="Uniform" 
                                                  Fill="#6B7280"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D1D5DB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Screener Info -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" 
                            CornerRadius="22"
                            Background="{Binding ScreenerColor}"
                            Margin="0,0,15,0">
                        <TextBlock Text="{Binding ScreenerInitials}" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ScreenerName"
                                   Text="{x:Static res:Strings.ScreenerDetailsDialog_ScreenerName}"
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#2C3E50"/>
                        <TextBlock x:Name="AssignedCountText"
                                   Text="{x:Static res:Strings.ScreenerDetailsDialog_AssignedCountText}"
                                   FontSize="12" 
                                   Foreground="#6B7280"/>
                    </StackPanel>
                </StackPanel>

                <!-- Summary Badges -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#D1FAE5"
                            CornerRadius="15"
                            Padding="12,6"
                            Margin="0,0,10,0">
                        <TextBlock x:Name="PassCountText"
                                   Text="{x:Static res:Strings.ScreenerDetailsDialog_PassCountText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#065F46"/>
                    </Border>

                    <Border Background="#FED7AA"
                            CornerRadius="15"
                            Padding="12,6">
                        <TextBlock x:Name="ReferCountText"
                                   Text="{x:Static res:Strings.ScreenerDetailsDialog_ReferCountText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#9A3412"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Patient List Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.ScreenerDetailsDialog_AssignedPatientsHeader}"
                           FontSize="16"
                           FontWeight="SemiBold" 
                           Foreground="#2C3E50" 
                           Margin="10,0,10,15"/>

                <ItemsControl x:Name="PatientListItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" 
                CornerRadius="10" 
                Padding="20,15"
                Margin="0,0,0,10"
                MouseEnter="PatientCard_MouseEnter"
                MouseLeave="PatientCard_MouseLeave">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                                </Border.Effect>

                                <Grid>
                                    <!-- Left Accent Border (Hidden by default) -->
                                    <Rectangle x:Name="AccentStrip"
                           HorizontalAlignment="Left" 
                           Width="4" 
                           RadiusX="2" 
                           RadiusY="2"
                           Fill="{Binding AccentColor}"
                           Margin="-20,-15,-20,-15"
                           Opacity="0"/>

                                    <Grid Margin="10,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Patient Info -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#111827">
                            <Run Text="{Binding MRN}"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding FirstName}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding LastName}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DOB, StringFormat='DOB: {0:MM/dd/yyyy}'}" 
                                   FontSize="11" 
                                   Foreground="#6B7280"
                                   Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Result Badge and Time -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border Background="{Binding ResultBackground}" 
                                CornerRadius="12" 
                                Padding="10,5"
                                Margin="0,0,0,5">
                                                <TextBlock Text="{Binding ResultText}" 
                                       FontSize="11" 
                                       Foreground="{Binding ResultForeground}" 
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding CompletionTime}" 
                                   FontSize="10" 
                                   Foreground="#9CA3AF"
                                   HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="20" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Button Content="{x:Static res:Strings.ScreenerDetailsDialog_CloseButton}"
                    Width="100"
                    Height="36"
                    HorizontalAlignment="Right"
                    Background="#6B4BA8"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    FontWeight="Medium"
                    Cursor="Hand"
                    Click="CloseButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8"
                                            Padding="20,8">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A3B8F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Border>
    </Grid>
</Window>