<Window x:Class="AccuSync.Views.Dashboard.Dialogs.ScreenerListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AccuSync.Resources"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="PurpleBrush" Color="#473089"/>
        <SolidColorBrush x:Key="PurpleHoverBrush" Color="#5A3DA8"/>
        <SolidColorBrush x:Key="LightBlueBrush" Color="#D4E9F9"/>
        <SolidColorBrush x:Key="BrightBlueBrush" Color="#005FBE"/>
        <SolidColorBrush x:Key="MidnightBrush" Color="#002856"/>
        <SolidColorBrush x:Key="TextBrush" Color="#5C5149"/>
        <SolidColorBrush x:Key="GrayBrush" Color="#9EA2AC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#e5e7eb"/>
        <SolidColorBrush x:Key="BgLighterBrush" Color="#f3f4f6"/>
        <SolidColorBrush x:Key="BgFooterBrush" Color="#f9fafb"/>
    </Window.Resources>

    <!-- Outer border: margin gives room for drop shadow -->
    <Border Margin="20" CornerRadius="12" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="0" Color="#000000"/>
        </Border.Effect>

        <!-- Inner border clips content to rounded corners -->
        <Border CornerRadius="12" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Search bar -->
                    <RowDefinition Height="*"/>
                    <!-- Screener list -->
                    <RowDefinition Height="Auto"/>
                    <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- ══════════════ HEADER ══════════════ -->
                <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="24,20,24,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <Path Grid.Column="0"
                                  Data="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"
                                  Fill="{StaticResource PurpleBrush}" Width="22" Height="22"
                                  Stretch="Uniform" VerticalAlignment="Center"/>

                            <!-- Title + Subtitle -->
                            <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{x:Static res:Strings.ScreenerListDialog_ScreeningsToday}" FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}"/>
                                <TextBlock x:Name="DateSubtitle" Text="{x:Static res:Strings.ScreenerListDialog_DateSubtitle}"
                                           FontSize="12"
                                           Foreground="{StaticResource GrayBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Count badge -->
                            <Border x:Name="CountBadge" Grid.Column="2"
                                    Background="{StaticResource MidnightBrush}"
                                    CornerRadius="12" Padding="12,5"
                                    VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="CountText" Text="{x:Static res:Strings.ScreenerListDialog_CountText}"
                                           FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </Border>

                            <!-- Close button -->
                            <Button Grid.Column="3" Click="CloseButton_Click"
                                    Width="32" Height="32" Cursor="Hand"
                                    VerticalAlignment="Center" ToolTip="{x:Static res:Strings.ScreenerListDialog_Close}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseBorder"
                                                Background="{StaticResource BgLighterBrush}"
                                                CornerRadius="6" Width="32" Height="32">
                                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                  Fill="{StaticResource TextBrush}" Width="18" Height="18"
                                                  Stretch="Uniform" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseBorder" Property="Background"
                                                        Value="{StaticResource BorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════════ SEARCH BAR ══════════════ -->
                <Border Grid.Row="1" Padding="24,14,24,0">
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1.5" CornerRadius="8" Height="38" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform"
                                  Fill="#9CA3AF" Margin="0,0,10,0" VerticalAlignment="Center"
                                  Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalAlignment="Center" FontSize="13"
                                     Foreground="#111827" Text="{x:Static res:Strings.ScreenerListDialog_SearchPlaceholder}"
                                     GotFocus="SearchBox_GotFocus"
                                     LostFocus="SearchBox_LostFocus"
                                     TextChanged="SearchBox_TextChanged">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter Property="Foreground" Value="#111827"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>
                </Border>

                <!-- ══════════════ SCREENER LIST / EMPTY STATE ══════════════ -->
                <Grid Grid.Row="2" MinHeight="200" MaxHeight="400">

                    <!-- Empty State -->
                    <Border x:Name="EmptyView" Visibility="Collapsed" Padding="24">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,20,0,20">
                            <Border Width="64" Height="64" CornerRadius="32"
                                    Background="{StaticResource BgLighterBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Path Width="28" Height="28" Stretch="Uniform" Fill="#3A3A3C"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                            </Border>
                            <TextBlock Text="{x:Static res:Strings.ScreenerListDialog_NoScreenersFound}" FontSize="16"
                                       FontWeight="SemiBold" Foreground="#2C3E50"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="{x:Static res:Strings.ScreenerListDialog_TryAdjustingSearch}"
                                       FontSize="13" Foreground="#6B7280"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Screener List -->
                    <ScrollViewer x:Name="ScreenerListView"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Visible">
                        <ItemsControl x:Name="ScreenerListItems" Margin="24,14,24,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#E5E7EB"
                                            BorderThickness="1" CornerRadius="8"
                                            Padding="16,14" Margin="0,0,0,8"
                                            Cursor="Hand"
                                            MouseEnter="ScreenerCard_MouseEnter"
                                            MouseLeave="ScreenerCard_MouseLeave">
                                        <Grid>
                                            <Grid Margin="4,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Avatar -->
                                                <Border Grid.Column="0"
                                                        Width="40" Height="40"
                                                        CornerRadius="20"
                                                        Background="{Binding AvatarColor}"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding Initials}"
                                                               FontSize="13" FontWeight="Bold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Name + Last Activity -->
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="#111827"/>
                                                    <TextBlock Text="{Binding LastActivity}"
                                                               FontSize="11"
                                                               Foreground="#9CA3AF"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Screening count badge -->
                                                <Border Grid.Column="2"
                                                        Background="{StaticResource LightBlueBrush}"
                                                        CornerRadius="14" Padding="14,6"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ScreeningCount}"
                                                               FontSize="15" FontWeight="Bold"
                                                               Foreground="{StaticResource BrightBlueBrush}"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ══════════════ FOOTER ══════════════ -->
                <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Background="{StaticResource BgFooterBrush}" Padding="24,16">
                    <Button Click="CloseButton_Click" Cursor="Hand"
                            HorizontalAlignment="Right">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBtnBorder"
                                        Background="{StaticResource PurpleBrush}"
                                        CornerRadius="6" Padding="24,10">
                                    <TextBlock Text="{x:Static res:Strings.ScreenerListDialog_Close}" FontSize="14"
                                               FontWeight="SemiBold" Foreground="White"
                                               FontFamily="Segoe UI"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBtnBorder" Property="Background"
                                                Value="{StaticResource PurpleHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>