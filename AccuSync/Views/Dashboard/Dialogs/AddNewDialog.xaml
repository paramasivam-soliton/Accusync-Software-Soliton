<!-- TODO: All four option cards are identical except for icon, label, and click handler.
     Extract a keyed OptionCard style or DataTemplate with ItemsControl — would replace ~160 lines with ~40. -->
<!-- TODO: The Border hover style (purple glow) is duplicated four times. Extract into a single keyed style. -->
<!-- TODO: Close button template duplicated across dialogs. Extract into shared style. -->
<!-- NOTE: This dialog uses a purple horizontal gradient header while other dialogs use dark gray vertical.
     Confirm this is intentional differentiation. -->
<Window x:Class="AccuSync.Views.Dashboard.Dialogs.AddNewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AccuSync.Resources"
        Title="{x:Static res:Strings.AddNewDialog_Title}"
        Height="320" 
        Width="650"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border CornerRadius="12" 
            Background="White"
            BorderBrush="#D1D5DB"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="3" BlurRadius="15" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#473089" Offset="0"/>
                            <GradientStop Color="#6B4BA8" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <Grid Margin="20,12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Static res:Strings.AddNewDialog_Title}"
                                       FontSize="18"
                                       FontWeight="Bold" 
                                       Foreground="White"/>
                            <TextBlock Text="{x:Static res:Strings.AddNewDialog_Subtitle}"
                                       FontSize="12" 
                                       Foreground="#E8D4F8"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button HorizontalAlignment="Right" 
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="CloseButton_Click"
                                Width="28" Height="28">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="6"
                                                        Padding="5">
                                                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                                                          Fill="White"
                                                          Stretch="Uniform"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#40FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Option Cards -->
            <Grid Grid.Row="1" Margin="20,16,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Clinical Records -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{x:Static res:Strings.AddNewDialog_ClinicalRecords}"
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="#374151"
                               Margin="0,0,0,10"/>

                    <Border Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="2"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0,0,0,10"
                            Cursor="Hand"
                            MouseLeftButtonDown="PatientOption_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#C084FC"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#C084FC" Direction="270" ShadowDepth="0" BlurRadius="12" Opacity="0.3"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" 
                                    Background="#404041" 
                                    CornerRadius="10" 
                                    Width="40" 
                                    Height="40"
                                    Margin="0,0,12,0">
                                <Path Width="20" Height="20" 
                                      Stretch="Uniform" 
                                      Fill="White"
                                      Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="{x:Static res:Strings.AddNewDialog_Patient}"
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       VerticalAlignment="Center"/>

                            <Path Grid.Column="2" 
                                  Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"
                                  Fill="#9CA3AF"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="2"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0,0,0,0"
                            Cursor="Hand"
                            MouseLeftButtonDown="UserOption_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#C084FC"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#C084FC" Direction="270" ShadowDepth="0" BlurRadius="12" Opacity="0.3"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" 
                                    Background="#404041" 
                                    CornerRadius="10" 
                                    Width="40" 
                                    Height="40"
                                    Margin="0,0,12,0">
                                <Path Width="20" Height="20" 
                                      Stretch="Uniform" 
                                      Fill="White"
                                      Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="{x:Static res:Strings.AddNewDialog_User}"
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       VerticalAlignment="Center"/>

                            <Path Grid.Column="2" 
                                  Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"
                                  Fill="#9CA3AF"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- System Configuration -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{x:Static res:Strings.AddNewDialog_SystemConfiguration}"
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="#374151"
                               Margin="0,0,0,10"/>

                    <Border Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="2"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0,0,0,10"
                            Cursor="Hand"
                            MouseLeftButtonDown="SiteOption_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#C084FC"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#C084FC" Direction="270" ShadowDepth="0" BlurRadius="12" Opacity="0.3"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" 
                                    Background="#404041" 
                                    CornerRadius="10" 
                                    Width="40" 
                                    Height="40"
                                    Margin="0,0,12,0">
                                <Path Width="20" Height="20" 
                                      Stretch="Uniform" 
                                      Fill="White"
                                      Data="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="{x:Static res:Strings.AddNewDialog_Site}"
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       VerticalAlignment="Center"/>

                            <Path Grid.Column="2" 
                                  Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"
                                  Fill="#9CA3AF"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="2"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0,0,0,0"
                            Cursor="Hand"
                            MouseLeftButtonDown="DeviceOption_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#C084FC"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#C084FC" Direction="270" ShadowDepth="0" BlurRadius="12" Opacity="0.3"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" 
                                    Background="#404041" 
                                    CornerRadius="10" 
                                    Width="40" 
                                    Height="40"
                                    Margin="0,0,12,0">
                                <Path Width="20" Height="20" 
                                      Stretch="Uniform" 
                                      Fill="White"
                                      Data="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="{x:Static res:Strings.AddNewDialog_Device}"
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       VerticalAlignment="Center"/>

                            <Path Grid.Column="2" 
                                  Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"
                                  Fill="#9CA3AF"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>