<Window x:Class="AccuSync.Views.Dashboard.Dialogs.ScreenerNotExportedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AccuSync.Resources"
        Title="{x:Static res:Strings.ScreenerNotExportedDialog_Title}"
        Height="600" 
        Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Glassmorphism Header -->
        <Border Grid.Row="0" Padding="25,20" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F8F9FA" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title and Badge Row -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{x:Static res:Strings.ScreenerNotExportedDialog_NotExportedPending}"
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#2C3E50"
                               VerticalAlignment="Center"/>

                    <!-- Screening Count Badge -->
                    <Border x:Name="ScreeningCountBadge"
                            Grid.Column="1"
                            Background="#DC2626"
                            CornerRadius="14"
                            Padding="15,6"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ScreeningCountText"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </Border>
                </Grid>

                <!-- Search Bar -->
                <Border Grid.Row="1"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1.5"
                        CornerRadius="18"
                        Height="36"
                        Padding="15,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Fill="#9CA3AF"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center"
                              Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalAlignment="Center"
                                 FontSize="13"
                                 Foreground="#111827"
                                 Text="{x:Static res:Strings.ScreenerNotExportedDialog_SearchPlaceholder}"
                                 GotFocus="SearchBox_GotFocus"
                                 LostFocus="SearchBox_LostFocus"
                                 TextChanged="SearchBox_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="Foreground" Value="#111827"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Screening List Content -->
        <Grid Grid.Row="1">
            <!-- Skeleton Loading State -->
            <ScrollViewer x:Name="LoadingView" 
                          VerticalScrollBarVisibility="Auto" 
                          Visibility="Collapsed"
                          Margin="20">
                <Border Background="White" CornerRadius="10" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Skeleton Cards -->
                        <Border Margin="0,0,0,15" Opacity="0.6">
                            <Grid Height="70">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Border Width="100" Height="12" Background="#E5E7EB" CornerRadius="6" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                    <Border Width="150" Height="10" Background="#E5E7EB" CornerRadius="5" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="80" Height="32" Background="#E5E7EB" CornerRadius="16" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Margin="0,0,0,15" Opacity="0.4">
                            <Grid Height="70">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Border Width="100" Height="12" Background="#E5E7EB" CornerRadius="6" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                    <Border Width="150" Height="10" Background="#E5E7EB" CornerRadius="5" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="80" Height="32" Background="#E5E7EB" CornerRadius="16" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Opacity="0.2">
                            <Grid Height="70">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Border Width="100" Height="12" Background="#E5E7EB" CornerRadius="6" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                    <Border Width="150" Height="10" Background="#E5E7EB" CornerRadius="5" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="80" Height="32" Background="#E5E7EB" CornerRadius="16" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Empty State -->
            <Border x:Name="EmptyView" 
                    Visibility="Collapsed"
                    Margin="20">
                <Border Background="White" CornerRadius="10" Padding="40">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                    </Border.Effect>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="90" Height="90" Fill="#F3F4F6" HorizontalAlignment="Center"/>
                        <TextBlock Text="✓" FontSize="50" HorizontalAlignment="Center" Margin="0,-70,0,20" Foreground="#10B981"/>

                        <TextBlock Text="{x:Static res:Strings.ScreenerNotExportedDialog_AllExported}"
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#2C3E50" 
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,10"/>
                        <TextBlock Text="{x:Static res:Strings.ScreenerNotExportedDialog_NoScreeningsWaiting}"
                                   FontSize="13" 
                                   Foreground="#6B7280" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Static res:Strings.ScreenerNotExportedDialog_GreatJob}"
                                   FontSize="13" 
                                   Foreground="#6B7280" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <Button Content="{x:Static res:Strings.ScreenerNotExportedDialog_Refresh}"
                                Width="150"
                                Height="36"
                                Background="#6B4BA8"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Medium"
                                Cursor="Hand"
                                Click="RefreshButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="8"
                                                        Padding="20,8">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#5A3B8F"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Screening List -->
            <ScrollViewer x:Name="ScreeningListView" VerticalScrollBarVisibility="Auto" Visibility="Visible" Margin="20">
                <ItemsControl x:Name="ScreeningListItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" 
                                    CornerRadius="10" 
                                    Padding="20,15"
                                    Margin="0,0,0,10"
                                    MouseEnter="ScreeningCard_MouseEnter"
                                    MouseLeave="ScreeningCard_MouseLeave">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                                </Border.Effect>

                                <Grid>
                                    <!-- Left Accent Border (Hidden by default) -->
                                    <Rectangle x:Name="AccentStrip"
                                               HorizontalAlignment="Left" 
                                               Width="4" 
                                               RadiusX="2" 
                                               RadiusY="2"
                                               Fill="#DC2626"
                                               Margin="-20,-15,-20,-15"
                                               Opacity="0"/>

                                    <Grid Margin="10,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Screening Info -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#111827">
                                                <Run Text="{Binding PatientId}"/>
                                                <Run Text=" — "/>
                                                <Run Text="{Binding PatientName}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="#6B7280" Margin="0,4,0,0">
                                                <Run Text="{x:Static res:Strings.ScreenerNotExportedDialog_CompletedLabel}"/>
                                                <Run Text="{Binding CompletedTime, StringFormat='yyyy-MM-dd HH:mm'}" FontWeight="SemiBold"/>
                                                <Run Text="{x:Static res:Strings.ScreenerNotExportedDialog_ResultLabel}"/>
                                                <Run Text="{Binding Result}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Export Button -->
                                        <Button Grid.Column="1"
                                                Height="36"
                                                Padding="18,0"
                                                Background="#6B4BA8"
                                                Foreground="White"
                                                BorderThickness="0"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                Tag="{Binding}"
                                                Click="ExportButton_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                        CornerRadius="8"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Path Width="16" Height="16" 
                                                                              Stretch="Uniform" 
                                                                              Fill="White"
                                                                              Margin="0,0,8,0"
                                                                              Data="M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L11 12.67V3h2z"/>
                                                                        <TextBlock Text="{x:Static res:Strings.ScreenerNotExportedDialog_Export}" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#5A3B8F"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="20" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Button Content="{x:Static res:Strings.ScreenerNotExportedDialog_Close}"
                    Width="100" 
                    Height="36"
                    HorizontalAlignment="Right"
                    Background="#6B4BA8"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    FontWeight="Medium"
                    Cursor="Hand"
                    Click="CloseButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8"
                                            Padding="20,8">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A3B8F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Border>
    </Grid>
</Window>