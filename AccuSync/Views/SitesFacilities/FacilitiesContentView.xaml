<!-- TODO: Two-panel layout, card container style, and empty states identical to other config views. Extract shared ListDetailShell. -->
<UserControl x:Class="AccuSync.Views.SitesFacilities.FacilitiesContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AccuSync.Resources"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- Form TextBox -->

        <!-- Multi-Line TextBox -->

        <!-- Form ComboBox -->
    </UserControl.Resources>

    <Grid Background="#D4E9F9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Facilities List Panel -->
        <Border Grid.Column="0" Background="White" CornerRadius="15" Margin="0,0,10,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="15,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3A3A3C" Offset="0"/>
                            <GradientStop Color="#202124" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="{x:Static res:Strings.FacilitiesContentView_Facilities}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Facility Cards -->
                <ListView Grid.Row="1" x:Name="FacilitiesListView"
                          BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Padding="8"
                          SelectionChanged="FacilitiesListView_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="CardBorder"
                                                Background="White"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10,12,0"
                                                Cursor="Hand">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Direction="270"
                                                                   ShadowDepth="1" BlurRadius="3" Opacity="0.08"/>
                                            </Border.Effect>
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#d0d4db"/>
                                                <Setter TargetName="CardBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="Black" Direction="270"
                                                                           ShadowDepth="4" BlurRadius="14" Opacity="0.12"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#D4E9F9"/>
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#005FBE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="#1a1a1a" Margin="0,0,0,2"/>

                                <TextBlock Text="{Binding Description}"
                                           FontSize="13" Foreground="#666"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,6"/>

                                <StackPanel Margin="0,6,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static res:Strings.FacilitiesContentView_Code}" FontSize="10" Foreground="#888"
                                                   FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding Code}" FontSize="12"
                                                   Foreground="#333" FontWeight="Medium"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State -->
                <Border x:Name="EmptyListPanel" Grid.Row="1" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="80" Height="80" CornerRadius="20"
                                Background="#D4E9F9" HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <Path Width="36" Height="36" Stretch="Uniform" Fill="#005FBE"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/>
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.FacilitiesContentView_NoFacilitiesAvailable}"
                                   FontSize="13" Foreground="#9EA2AC"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Facility Detail Panel -->
        <!-- TODO: Form field layout (label + required asterisk + input) repeated for every field. Extract FormField UserControl. -->
        <Border Grid.Column="1" Background="White" CornerRadius="15" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Detail Header -->
                <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3A3A3C" Offset="0"/>
                            <GradientStop Color="#202124" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DetailHeaderText" Text="{x:Static res:Strings.FacilitiesContentView_FacilityDetailsHeader}"
                                   FontSize="14" FontWeight="Bold" Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Detail Form -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              x:Name="DetailFormPanel" Visibility="Collapsed">
                    <StackPanel Margin="24">

                        <!-- Facility Details -->
                        <Border Margin="0,0,0,16">
                            <StackPanel>
                                <Border BorderThickness="0,0,0,2" BorderBrush="#D4E9F9"
                                        Padding="0,0,0,8" Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static res:Strings.FacilitiesContentView_FacilityDetails}" FontSize="14"
                                                   FontWeight="Bold" Foreground="#4b5563"/>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{x:Static res:Strings.FacilitiesContentView_Name}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#4b5563"/>
                                            <TextBlock Text=" *" FontSize="13"
                                                       Foreground="#dc3545" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBox x:Name="NameBox"
                                                 Style="{StaticResource FormTextBoxStyle}"
                                                 TextChanged="Field_Changed"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{x:Static res:Strings.FacilitiesContentView_CodeLabel}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#4b5563"/>
                                            <TextBlock Text=" *" FontSize="13"
                                                       Foreground="#dc3545" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBox x:Name="CodeBox"
                                                 Style="{StaticResource FormTextBoxStyle}"
                                                 TextChanged="Field_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{x:Static res:Strings.FacilitiesContentView_Site}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#4b5563"/>
                                            <TextBlock Text=" *" FontSize="13"
                                                       Foreground="#dc3545" FontWeight="Bold"/>
                                        </StackPanel>
                                        <ComboBox x:Name="SiteCombo"
                                                  Style="{StaticResource FormComboBoxStyle}"
                                                  SelectionChanged="Field_Changed"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Static res:Strings.FacilitiesContentView_LocationType}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#4b5563"
                                                   Margin="0,0,0,6"/>
                                        <ComboBox x:Name="LocationTypeCombo"
                                                  Style="{StaticResource FormComboBoxStyle}"
                                                  SelectionChanged="Field_Changed">
                                            <ComboBoxItem Content="{x:Static res:Strings.FacilitiesContentView_HomeVisit}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.FacilitiesContentView_Inpatient}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.FacilitiesContentView_Outpatient}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="{x:Static res:Strings.FacilitiesContentView_Description}" FontSize="13"
                                               FontWeight="SemiBold" Foreground="#4b5563"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="DescriptionBox"
                                             Style="{StaticResource FormTextAreaStyle}"
                                             TextChanged="Field_Changed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Empty State -->
                <Border x:Name="EmptyDetailPanel" Grid.Row="1" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="80" Height="80" CornerRadius="20"
                                Background="#D4E9F9" HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <Path Width="36" Height="36" Stretch="Uniform" Fill="#005FBE"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/>
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.FacilitiesContentView_SelectFacility}"
                                   FontSize="13" Foreground="#9EA2AC"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>

</UserControl>
