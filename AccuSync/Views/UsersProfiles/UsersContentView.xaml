<UserControl x:Class="AccuSync.Views.UsersProfiles.UsersContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AccuSync.Views.UsersProfiles"
             xmlns:res="clr-namespace:AccuSync.Resources"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- TODO: HeaderIconButtonStyle duplicated in PatientsView — extract to shared resource -->
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EyeToggleStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TODO: FormTextBoxStyle / FormComboBoxStyle / FormPasswordBoxStyle duplicated across 10+ config views — extract to shared resource -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#5C5149"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="10,0,10,0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#002856"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#f3f4f6"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#5C5149"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter Grid.Column="0" Margin="10,6"/>
                                                            <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#666"
                                                                  Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#002856"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,6,32,6" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border CornerRadius="6" MaxHeight="200"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Background="White" BorderThickness="1" BorderBrush="#D1D5DB">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.15"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#5C5149"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="White"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="10,0,36,0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#002856"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#D4E9F9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid x:Name="NormalUsersGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Users List -->
            <Border Grid.Column="0" Background="White" CornerRadius="15" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="15,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3A3A3C" Offset="0"/>
                                <GradientStop Color="#202124" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{x:Static res:Strings.UsersContentView_Users}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    </Border>

                    <ListView Grid.Row="1" x:Name="UsersListView"
                          BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Padding="8"
                          SelectionChanged="UsersListView_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="CardBorder"
                                                Background="White"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10,12,0"
                                                Cursor="Hand">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="Black" Direction="270"
                                                                   ShadowDepth="1" BlurRadius="3" Opacity="0.08"/>
                                                </Border.Effect>
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#d0d4db"/>
                                                    <Setter TargetName="CardBorder" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="Black" Direction="270"
                                                                           ShadowDepth="4" BlurRadius="14" Opacity="0.12"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="#D4E9F9"/>
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#005FBE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding LoginName}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="#1a1a1a" Margin="0,0,0,2"/>

                                    <TextBlock Text="{Binding DisplayName}"
                                           FontSize="13" Foreground="#666"
                                           Margin="0,0,0,6"/>

                                    <StackPanel Margin="0,6,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{x:Static res:Strings.UsersContentView_Profile}" FontSize="10" Foreground="#888"
                                                       FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding Profile}" FontSize="12"
                                                       Foreground="#333" FontWeight="Medium"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Static res:Strings.UsersContentView_StatusColumn}" FontSize="10" Foreground="#888"
                                                       FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- Green = Active, Red = Inactive -->
                                                    <Ellipse Width="8" Height="8" Margin="0,0,5,0"
                                                         VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#429C10"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                                        <Setter Property="Fill" Value="#dc3545"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Status}" FontSize="12"
                                                           Foreground="#333" FontWeight="Medium"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{x:Static res:Strings.UsersContentView_LockedColumn}" FontSize="10" Foreground="#888"
                                                       FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding LockedDisplay}" FontSize="12"
                                                       Foreground="#9E9E9E" FontWeight="Medium"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- User Detail -->
            <Border Grid.Column="1" Background="White" CornerRadius="15" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3A3A3C" Offset="0"/>
                                <GradientStop Color="#202124" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DetailHeaderText" Text="{x:Static res:Strings.UsersContentView_Admin}"
                                   FontSize="14" FontWeight="Bold" Foreground="White"
                                   VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24">

                            <!-- User Information -->
                            <Border Margin="0,0,0,28">
                                <StackPanel>
                                    <Border BorderThickness="0,0,0,2" BorderBrush="#D4E9F9"
                                        Padding="0,0,0,8" Margin="0,0,0,16">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{x:Static res:Strings.UsersContentView_UserInformation}" FontSize="14"
                                                   FontWeight="Bold" Foreground="#4b5563"/>
                                        </StackPanel>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="16"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{x:Static res:Strings.UsersContentView_LoginName}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#4b5563"/>
                                                <TextBlock Text=" *" FontSize="13"
                                                       Foreground="#dc3545" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBox x:Name="LoginNameBox"
                                                 Style="{StaticResource FormTextBoxStyle}"
                                                 TextChanged="Field_Changed"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{x:Static res:Strings.UsersContentView_ProfileLabel}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#4b5563"/>
                                                <TextBlock Text=" *" FontSize="13"
                                                       Foreground="#dc3545" FontWeight="Bold"/>
                                            </StackPanel>
                                            <ComboBox x:Name="ProfileCombo"
                                                  Style="{StaticResource FormComboBoxStyle}"
                                                  SelectionChanged="Field_Changed">
                                                <ComboBoxItem Content="{x:Static res:Strings.UsersContentView_ProfileAdministrator}"/>
                                                <ComboBoxItem Content="{x:Static res:Strings.UsersContentView_ProfileScreener}"/>
                                                <ComboBoxItem Content="{x:Static res:Strings.UsersContentView_ProfileSupervisor}"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="{x:Static res:Strings.UsersContentView_FirstName}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#4b5563"
                                                   Margin="0,0,0,6"/>
                                            <TextBox x:Name="FirstNameBox"
                                                 Style="{StaticResource FormTextBoxStyle}"
                                                 TextChanged="Field_Changed"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="{x:Static res:Strings.UsersContentView_LastName}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#4b5563"
                                                   Margin="0,0,0,6"/>
                                            <TextBox x:Name="LastNameBox"
                                                 Style="{StaticResource FormTextBoxStyle}"
                                                 TextChanged="Field_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- User Settings -->
                            <Border Margin="0,0,0,28">
                                <StackPanel>
                                    <Border BorderThickness="0,0,0,2" BorderBrush="#D4E9F9"
                                        Padding="0,0,0,8" Margin="0,0,0,16">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{x:Static res:Strings.UsersContentView_UserSettings}" FontSize="14"
                                                   FontWeight="Bold" Foreground="#4b5563"/>
                                        </StackPanel>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="16"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Password with eye toggle to show/hide -->
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="{x:Static res:Strings.UsersContentView_Password}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#4b5563"
                                                   Margin="0,0,0,6"/>
                                            <Grid>
                                                <PasswordBox x:Name="PasswordBox"
                                                         Style="{StaticResource FormPasswordBoxStyle}"
                                                         PasswordChanged="Password_Changed"/>
                                                <TextBox x:Name="PasswordTextBox"
                                                     Style="{StaticResource FormTextBoxStyle}"
                                                     Visibility="Collapsed"
                                                     TextChanged="PasswordText_Changed"/>
                                                <Button Style="{StaticResource EyeToggleStyle}"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,10,0"
                                                    Click="TogglePasswordVisibility_Click"
                                                    ToolTip="{x:Static res:Strings.UsersContentView_ShowHidePassword}">
                                                    <Path x:Name="PasswordEyeIcon"
                                                      Width="18" Height="18" Stretch="Uniform"
                                                      Fill="#9CA3AF"
                                                      Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Verification with eye toggle and match indicator -->
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="{x:Static res:Strings.UsersContentView_Verification}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#4b5563"
                                                   Margin="0,0,0,6"/>
                                            <Grid>
                                                <PasswordBox x:Name="VerifyBox"
                                                         Style="{StaticResource FormPasswordBoxStyle}"
                                                         PasswordChanged="Verify_Changed"/>
                                                <TextBox x:Name="VerifyTextBox"
                                                     Style="{StaticResource FormTextBoxStyle}"
                                                     Visibility="Collapsed"
                                                     TextChanged="VerifyText_Changed"/>
                                                <Button Style="{StaticResource EyeToggleStyle}"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,10,0"
                                                    Click="ToggleVerifyVisibility_Click"
                                                    ToolTip="{x:Static res:Strings.UsersContentView_ShowHideVerification}">
                                                    <Path x:Name="VerifyEyeIcon"
                                                      Width="18" Height="18" Stretch="Uniform"
                                                      Fill="#9CA3AF"
                                                      Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                                </Button>
                                            </Grid>
                                            <TextBlock x:Name="MatchIndicator"
                                                   FontSize="11" FontWeight="Medium"
                                                   Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="{x:Static res:Strings.UsersContentView_Language}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#4b5563"
                                                   Margin="0,0,0,6"/>
                                            <ComboBox x:Name="LanguageCombo"
                                                  Style="{StaticResource FormComboBoxStyle}"
                                                  SelectionChanged="Field_Changed">
                                                <ComboBoxItem Content="{x:Static res:Strings.UsersContentView_LanguageEnglish}" IsSelected="True"/>
                                                <ComboBoxItem Content="{x:Static res:Strings.UsersContentView_LanguageFrench}"/>
                                                <ComboBoxItem Content="{x:Static res:Strings.UsersContentView_LanguageItalian}"/>
                                                <ComboBoxItem Content="{x:Static res:Strings.UsersContentView_LanguageGerman}"/>
                                                <ComboBoxItem Content="{x:Static res:Strings.UsersContentView_LanguageSpanish}"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- System Information -->
                            <Border Margin="0,0,0,16">
                                <StackPanel>
                                    <Border BorderThickness="0,0,0,2" BorderBrush="#D4E9F9"
                                        Padding="0,0,0,8" Margin="0,0,0,16">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{x:Static res:Strings.UsersContentView_SystemInformation}" FontSize="14"
                                                   FontWeight="Bold" Foreground="#4b5563"/>
                                        </StackPanel>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Static res:Strings.UsersContentView_StatusLabel}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#4b5563"
                                                   Margin="0,0,0,6"/>
                                            <ComboBox x:Name="StatusCombo"
                                                  Style="{StaticResource FormComboBoxStyle}"
                                                  SelectionChanged="Field_Changed">
                                                <ComboBoxItem Content="{x:Static res:Strings.UsersContentView_StatusActive}" IsSelected="True"/>
                                                <ComboBoxItem Content="{x:Static res:Strings.UsersContentView_StatusInactive}"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Locked is read-only — set by failed login attempts -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{x:Static res:Strings.UsersContentView_LockedLabel}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#4b5563"
                                                   Margin="0,0,0,6"/>
                                            <Border Background="#f3f4f6" BorderBrush="#D1D5DB"
                                                BorderThickness="1" CornerRadius="6"
                                                Height="40" Padding="12,0">
                                                <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                    <Path Width="16" Height="16" Stretch="Uniform"
                                                      Fill="#9CA3AF" Margin="0,0,8,0"
                                                      Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6h2c0-1.66 1.34-3 3-3s3 1.34 3 3v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm0 12H6V10h12v10zm-6-3c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"/>
                                                    <TextBlock x:Name="LockedDisplay"
                                                           Text="{x:Static res:Strings.UsersContentView_NotLocked}" FontSize="13"
                                                           Foreground="#9CA3AF"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Empty State -->
                    <Border x:Name="EmptyStatePanel" Grid.Row="1" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="80" Height="80" CornerRadius="20"
                                Background="#D4E9F9" HorizontalAlignment="Center"
                                Margin="0,0,0,16">
