<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- UseWPF is needed: several Models (dashboard/dialog display models) use
         System.Windows types (Brush, Visibility) for XAML binding, and Helpers
         includes WPF-facing formatting utilities. Same trade-off already made
         for AccuSync.Presentation. -->
    <UseWPF>true</UseWPF>
    <Nullable>annotations</Nullable>
    <AssemblyName>AccuSync.Application</AssemblyName>
    <RootNamespace>AccuSync.Application</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>RELEASE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reserved for the future AccuSync.DeviceCommunication extraction —
         not yet used by any code in this project. -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
