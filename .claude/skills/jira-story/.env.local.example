# Copy this file to .env.local (same folder) and fill in your own values.
# .env.local is git-ignored — never commit real credentials.
#
# Generate a token at: https://id.atlassian.com/manage-profile/security/api-tokens

JIRA_BASE_URL=https://natus-jira.atlassian.net
JIRA_EMAIL=your.email@natus.com
JIRA_API_TOKEN=paste-your-atlassian-api-token-here
JIRA_PROJECT_KEY=ASWD
