<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- AccuSync.Adapters.DataParser -->
    <PackageVersion Include="Docnet.Core" Version="2.6.0" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="PdfPig" Version="0.1.15" />
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <PackageVersion Include="Tesseract" Version="5.2.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />

    <!-- AccuSync.Application -->
    <PackageVersion Include="System.IO.Ports" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.10" />

    <!-- AccuSync.EF -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />

    <!-- AccuSync.WPF -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />

    <!-- Tests -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
  </ItemGroup>

</Project>
