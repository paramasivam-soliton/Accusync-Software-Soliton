<!-- TODO: Spinner control (Border + RepeatButtons + arrows) is duplicated three times. Extract a NumericSpinner UserControl. -->
<!-- TODO: AssignCheckBoxStyle is the same filled-checkbox pattern from DeviceFieldSetupView. Share the style. -->
<UserControl x:Class="AccuSync.WPF.Views.DeviceManagement.DevicesContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AccuSync.WPF.Views.DeviceManagement"
             xmlns:res="clr-namespace:AccuSync.WPF.Resources"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>

        <!-- Form TextBox -->

        <!-- Form ComboBox -->

        <!-- Tab Button -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#f8f9fa"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Active Tab -->
        <Style x:Key="ActiveTabStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
            <Setter Property="Foreground" Value="#4b5563"/>
            <Setter Property="Background" Value="#fafafa"/>
            <Setter Property="BorderBrush" Value="#005FBE"/>
        </Style>

        <!-- Spinner RepeatButton -->
        <Style x:Key="SpinnerBtnStyle" TargetType="RepeatButton">
            <Setter Property="Background" Value="#fafafa"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#e5e7eb"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#d1d5db"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Assignment CheckBox -->
        <Style x:Key="AssignCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="box" Width="20" Height="20" CornerRadius="4"
                                Background="White" BorderBrush="#D1D5DB" BorderThickness="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="check" Visibility="Collapsed"
                                  Width="10" Height="8" Stretch="Uniform"
                                  Stroke="White" StrokeThickness="2"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M2,5 L5,8 L10,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#005FBE"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#005FBE"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#005FBE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="#D4E9F9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- Main Devices Content -->
        <Grid x:Name="NormalDevicesGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Device List Panel -->
            <Border Grid.Column="0" Background="White" CornerRadius="15" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="15,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3A3A3C" Offset="0"/>
                                <GradientStop Color="#202124" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{x:Static res:Strings.DevicesContentView_Devices}" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- Device Cards -->
                    <ListView Grid.Row="1" x:Name="DevicesListView"
                          BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Padding="8"
                          SelectionChanged="DevicesListView_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="CardBorder"
                                                Background="White" BorderBrush="#E0E0E0"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="12,10,12,0" Cursor="Hand">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="Black" Direction="270"
                                                                   ShadowDepth="1" BlurRadius="3" Opacity="0.08"/>
                                                </Border.Effect>
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#d0d4db"/>
                                                    <Setter TargetName="CardBorder" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="Black" Direction="270"
                                                                           ShadowDepth="4" BlurRadius="14" Opacity="0.12"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="#D4E9F9"/>
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#005FBE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="#1a1a1a" Margin="0,0,0,6"/>

                                    <StackPanel Margin="0,6,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{x:Static res:Strings.DevicesContentView_Serial}" FontSize="10" Foreground="#888"
                                                       FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding Serial}" FontSize="12"
                                                       Foreground="#333" FontWeight="Medium"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Static res:Strings.DevicesContentView_LastSeen}" FontSize="10" Foreground="#888"
                                                       FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding LastSeenDisplay}" FontSize="12"
                                                       Foreground="#333" FontWeight="Medium"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty State -->
                    <Border x:Name="EmptyListPanel" Grid.Row="1" Visibility="Visible">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="80" Height="80" CornerRadius="20"
                                Background="#D4E9F9" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Path Width="36" Height="36" Stretch="Uniform" Fill="#005FBE"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"/>
                            </Border>
                            <TextBlock Text="{x:Static res:Strings.DevicesContentView_NoDevicesAvailable}" FontSize="13" Foreground="#9EA2AC" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Device Detail Panel -->
            <Border Grid.Column="1" Background="White" CornerRadius="15" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Detail Header -->
                    <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3A3A3C" Offset="0"/>
                                <GradientStop Color="#202124" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DetailHeaderText" Text="{x:Static res:Strings.DevicesContentView_DeviceDetails}"
                                   FontSize="14" FontWeight="Bold" Foreground="White"
                                   VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty State -->
                    <Border x:Name="EmptyDetailPanel" Grid.Row="1" Visibility="Visible">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="80" Height="80" CornerRadius="20"
                                Background="#D4E9F9" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Path Width="36" Height="36" Stretch="Uniform" Fill="#005FBE"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"/>
                            </Border>
                            <TextBlock Text="{x:Static res:Strings.DevicesContentView_SelectDeviceToViewDetails}"
                                   FontSize="13" Foreground="#9EA2AC" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Detail Content -->
                    <Grid x:Name="DetailContent" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tab Bar -->
                        <Border Grid.Row="0" BorderBrush="#e5e7eb" BorderThickness="0,0,0,2" Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ConfigTab" Grid.Column="0" Content="{x:Static res:Strings.DevicesContentView_Configuration}"
                                    Style="{StaticResource ActiveTabStyle}" Click="ConfigTab_Click"/>
                                <Button x:Name="UsersTab" Grid.Column="1" Content="{x:Static res:Strings.DevicesContentView_UserAssignment}"
                                    Style="{StaticResource TabButtonStyle}" Click="UsersTab_Click"/>
                                <Button x:Name="FacilitiesTab" Grid.Column="2" Content="{x:Static res:Strings.DevicesContentView_Facilities}"
                                    Style="{StaticResource TabButtonStyle}" Click="FacilitiesTab_Click"/>
                            </Grid>
                        </Border>

                        <!-- Tab Content -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <!-- Tab 1: Configuration -->
                                <!-- TODO: Form field layout repeated ~12 times. Extract FormField UserControl. -->
                                <StackPanel x:Name="ConfigPanel" Margin="24" Visibility="Visible">

                                    <!-- Individual Setting -->
                                    <Border Margin="0,0,0,24">
                                        <StackPanel>
                                            <Border BorderThickness="0,0,0,2" BorderBrush="#D4E9F9"
                                                Padding="0,0,0,8" Margin="0,0,0,16">
                                                <TextBlock Text="{x:Static res:Strings.DevicesContentView_IndividualSetting}" FontSize="14"
                                                       FontWeight="Bold" Foreground="#4b5563"/>
                                            </Border>

                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="{x:Static res:Strings.DevicesContentView_Name}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563"/>
                                                        <TextBlock Text=" *" FontSize="13" Foreground="#dc3545" FontWeight="Bold"/>
                                                    </StackPanel>
                                                    <TextBox x:Name="NameBox" Style="{StaticResource FormTextBoxStyle}" TextChanged="Field_Changed"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="{x:Static res:Strings.DevicesContentView_SerialLabel}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563"/>
                                                        <TextBlock Text=" *" FontSize="13" Foreground="#dc3545" FontWeight="Bold"/>
                                                    </StackPanel>
                                                    <TextBox x:Name="SerialBox" Style="{StaticResource FormTextBoxStyle}" TextChanged="Field_Changed"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{x:Static res:Strings.DevicesContentView_Code}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                                    <TextBox x:Name="CodeBox" Style="{StaticResource FormTextBoxStyle}" TextChanged="Field_Changed"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{x:Static res:Strings.DevicesContentView_Site}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="SiteCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{x:Static res:Strings.DevicesContentView_Language}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="LanguageCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                                        <ComboBoxItem Content="{x:Static res:Strings.DevicesContentView_English}"/>
                                                        <ComboBoxItem Content="{x:Static res:Strings.DevicesContentView_French}"/>
                                                        <ComboBoxItem Content="{x:Static res:Strings.DevicesContentView_Italian}"/>
                                                        <ComboBoxItem Content="{x:Static res:Strings.DevicesContentView_German}"/>
                                                        <ComboBoxItem Content="{x:Static res:Strings.DevicesContentView_Spanish}"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Common Configuration -->
                                    <Border Margin="0,0,0,24">
                                        <StackPanel>
                                            <Border BorderThickness="0,0,0,2" BorderBrush="#D4E9F9"
                                                Padding="0,0,0,8" Margin="0,0,0,16">
                                                <TextBlock Text="{x:Static res:Strings.DevicesContentView_CommonConfiguration}" FontSize="14"
                                                       FontWeight="Bold" Foreground="#4b5563"/>
                                            </Border>

                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{x:Static res:Strings.DevicesContentView_TestResultTerms}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="TestResultTermsCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                                        <ComboBoxItem Content="{x:Static res:Strings.DevicesContentView_UsePassRefer}"/>
                                                        <ComboBoxItem Content="{x:Static res:Strings.DevicesContentView_UseClearResponseNoClearResponse}"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{x:Static res:Strings.DevicesContentView_PowerTimeout}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                                    <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Height="40" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="28"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="PowerTimeoutText" Text="5 min" FontSize="13" Foreground="#5C5149"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                            <Border Grid.Column="1" BorderBrush="#D1D5DB" BorderThickness="1,0,0,0">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="*"/>
                                                                        <RowDefinition Height="*"/>
                                                                    </Grid.RowDefinitions>
                                                                    <RepeatButton Grid.Row="0" Style="{StaticResource SpinnerBtnStyle}" Click="PowerTimeout_Up">
                                                                        <Path Width="8" Height="5" Stretch="Uniform" Fill="#666" Data="M0,5 L4,0 L8,5Z"/>
                                                                    </RepeatButton>
                                                                    <Border Grid.Row="1" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0">
                                                                        <RepeatButton Style="{StaticResource SpinnerBtnStyle}" Click="PowerTimeout_Down">
                                                                            <Path Width="8" Height="5" Stretch="Uniform" Fill="#666" Data="M0,0 L4,5 L8,0Z"/>
                                                                        </RepeatButton>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{x:Static res:Strings.DevicesContentView_DisplayTimeout}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                                    <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Height="40" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="28"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="DisplayTimeoutText" Text="3 min" FontSize="13" Foreground="#5C5149"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                            <Border Grid.Column="1" BorderBrush="#D1D5DB" BorderThickness="1,0,0,0">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="*"/>
                                                                        <RowDefinition Height="*"/>
                                                                    </Grid.RowDefinitions>
                                                                    <RepeatButton Grid.Row="0" Style="{StaticResource SpinnerBtnStyle}" Click="DisplayTimeout_Up">
                                                                        <Path Width="8" Height="5" Stretch="Uniform" Fill="#666" Data="M0,5 L4,0 L8,5Z"/>
                                                                    </RepeatButton>
                                                                    <Border Grid.Row="1" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0">
                                                                        <RepeatButton Style="{StaticResource SpinnerBtnStyle}" Click="DisplayTimeout_Down">
                                                                            <Path Width="8" Height="5" Stretch="Uniform" Fill="#666" Data="M0,0 L4,5 L8,0Z"/>
                                                                        </RepeatButton>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{x:Static res:Strings.DevicesContentView_CalibrationPause}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                                    <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Height="40" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="28"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="CalibrationPauseText" Text="10 min" FontSize="13" Foreground="#5C5149"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                            <Border Grid.Column="1" BorderBrush="#D1D5DB" BorderThickness="1,0,0,0">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="*"/>
                                                                        <RowDefinition Height="*"/>
                                                                    </Grid.RowDefinitions>
                                                                    <RepeatButton Grid.Row="0" Style="{StaticResource SpinnerBtnStyle}" Click="CalibrationPause_Up">
                                                                        <Path Width="8" Height="5" Stretch="Uniform" Fill="#666" Data="M0,5 L4,0 L8,5Z"/>
                                                                    </RepeatButton>
                                                                    <Border Grid.Row="1" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0">
                                                                        <RepeatButton Style="{StaticResource SpinnerBtnStyle}" Click="CalibrationPause_Down">
                                                                            <Path Width="8" Height="5" Stretch="Uniform" Fill="#666" Data="M0,0 L4,5 L8,0Z"/>
                                                                        </RepeatButton>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{x:Static res:Strings.DevicesContentView_DataDeletion}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="DataDeletionCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                                        <ComboBoxItem Content="{x:Static res:Strings.DevicesContentView_Manual}"/>
                                                        <ComboBoxItem Content="{x:Static res:Strings.DevicesContentView_AfterSuccessfulDownload}"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{x:Static res:Strings.DevicesContentView_ABRAutostart}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="ABRAutostartCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                                        <ComboBoxItem Content="{x:Static res:Strings.DevicesContentView_NoAutostart}"/>
                                                        <ComboBoxItem Content="{x:Static res:Strings.DevicesContentView_AutostartOnGreen}"/>
                                                        <ComboBoxItem Content="{x:Static res:Strings.DevicesContentView_AutostartOnGreenOrYellow}"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{x:Static res:Strings.DevicesContentView_TEOAEProbeFitAssistant}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="TEOAEProbeFitCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                                        <ComboBoxItem Content="{x:Static res:Strings.DevicesContentView_Enabled}"/>
                                                        <ComboBoxItem Content="{x:Static res:Strings.DevicesContentView_Disabled}"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- System Information -->
                                    <Border>
                                        <StackPanel>
                                            <Border BorderThickness="0,0,0,2" BorderBrush="#D4E9F9"
                                                Padding="0,0,0,8" Margin="0,0,0,16">
                                                <TextBlock Text="{x:Static res:Strings.DevicesContentView_SystemInformation}" FontSize="14"
                                                       FontWeight="Bold" Foreground="#4b5563"/>
                                            </Border>

                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{x:Static res:Strings.DevicesContentView_LastSeenLabel}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                                    <TextBox x:Name="LastSeenBox" Style="{StaticResource FormTextBoxStyle}" IsEnabled="False"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{x:Static res:Strings.DevicesContentView_LastUpdated}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                                    <TextBox x:Name="LastUpdatedBox" Style="{StaticResource FormTextBoxStyle}" IsEnabled="False"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{x:Static res:Strings.DevicesContentView_HardwareVersion}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                                    <TextBox x:Name="HardwareVersionBox" Style="{StaticResource FormTextBoxStyle}" IsEnabled="False"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{x:Static res:Strings.DevicesContentView_FirmwareVersion}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                                    <TextBox x:Name="FirmwareVersionBox" Style="{StaticResource FormTextBoxStyle}" IsEnabled="False"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Tab 2: User Assignment -->
                                <StackPanel x:Name="UsersPanel" Margin="24" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.DevicesContentView_LoginName}" FontSize="11" FontWeight="Bold"
                                               Foreground="#6B7280" Padding="14,10" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.DevicesContentView_CopyToDevice}" FontSize="11" FontWeight="Bold"
                                               Foreground="#6B7280" Padding="14,10" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="2" Background="#e5e7eb"/>
                                    <StackPanel x:Name="UserAssignmentRows"/>
                                </StackPanel>

                                <!-- Tab 3: Facilities -->
                                <StackPanel x:Name="FacilitiesPanel" Margin="24" Visibility="Collapsed">
                                    <Grid x:Name="FacilitiesTableHeader" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.DevicesContentView_Facility}" FontSize="11" FontWeight="Bold"
                                               Foreground="#6B7280" Padding="14,10" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.DevicesContentView_CopyToDevice}" FontSize="11" FontWeight="Bold"
                                               Foreground="#6B7280" Padding="14,10" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border x:Name="FacilitiesTableDivider" Height="2" Background="#e5e7eb" Visibility="Collapsed"/>
                                    <StackPanel x:Name="FacilityAssignmentRows"/>

                                    <!-- Empty State -->
                                    <Border x:Name="FacilitiesEmptyState" Visibility="Visible">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,48,0,48">
                                            <Border Width="80" Height="80" CornerRadius="20"
                                                Background="#D4E9F9" HorizontalAlignment="Center" Margin="0,0,0,16">
                                                <Path Width="36" Height="36" Stretch="Uniform" Fill="#005FBE"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/>
                                            </Border>
                                            <TextBlock Text="{x:Static res:Strings.DevicesContentView_NoFacilitiesAvailable}" FontSize="13" Foreground="#9EA2AC" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- NOTE: Overlay views occupy the same grid cell as NormalDevicesGrid. Visibility toggling controls which is shown. -->
        <views:ABRConfigurationView x:Name="ABRConfigurationControl" Visibility="Collapsed"/>
        <views:DPOAEConfigurationView x:Name="DPOAEConfigurationControl" Visibility="Collapsed"/>
        <views:DeviceFieldSetupView x:Name="FieldSetupConfigurationControl" Visibility="Collapsed"/>
    </Grid>
</UserControl>
