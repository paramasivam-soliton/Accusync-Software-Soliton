<!-- TODO: Two-panel list/detail layout, card container style, and empty states identical to ABRConfigurationView. Extract shared ListDetailShell. -->
<UserControl x:Class="AccuSync.WPF.Views.DeviceManagement.DPOAEConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AccuSync.WPF.Resources"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>

        <!-- Form TextBox -->

        <!-- Multi-Line TextBox -->

        <!-- Form ComboBox -->

        <!-- Frequency Toggle Button -->
        <Style x:Key="FreqToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#5C5149"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#D1D5DB" BorderThickness="1.5"
                                CornerRadius="6" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#005FBE"/>
                                <Setter TargetName="bd" Property="Background" Value="#f0f7ff"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#005FBE"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#005FBE"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="#D4E9F9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Protocols List Panel -->
        <Border Grid.Column="0" Background="White" CornerRadius="15" Margin="0,0,10,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="15,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3A3A3C" Offset="0"/>
                            <GradientStop Color="#202124" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_DpoaeProtocols}"
                               FontSize="14" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Protocol Cards -->
                <ListView Grid.Row="1" x:Name="ProtocolsListView"
                          BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Padding="8"
                          SelectionChanged="ProtocolsListView_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="CardBorder"
                                                Background="White" BorderBrush="#E0E0E0"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="12,10,12,0" Cursor="Hand">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Direction="270"
                                                                   ShadowDepth="1" BlurRadius="3" Opacity="0.08"/>
                                            </Border.Effect>
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#d0d4db"/>
                                                <Setter TargetName="CardBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="Black" Direction="270"
                                                                           ShadowDepth="4" BlurRadius="14" Opacity="0.12"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#D4E9F9"/>
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#005FBE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="#1a1a1a" Margin="0,0,0,2"/>

                                <TextBlock Text="{Binding Description}"
                                           FontSize="13" Foreground="#666"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,6"/>

                                <StackPanel Margin="0,6,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_CategoryLabel}" FontSize="10" Foreground="#888"
                                                       FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding Category}" FontSize="12"
                                                       Foreground="#333" FontWeight="Medium"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_StatusLabel}" FontSize="10" Foreground="#888"
                                                       FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding Status}" FontSize="12"
                                                       Foreground="{Binding StatusColor}" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State -->
                <Border x:Name="EmptyListPanel" Grid.Row="1" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="80" Height="80" CornerRadius="20"
                                Background="#D4E9F9" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Width="36" Height="36" Stretch="Uniform" Fill="#005FBE"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M5 9.2h3V19H5zM10.6 5h2.8v14h-2.8zm5.6 8H19v6h-2.8z"/>
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_NoProtocolsAvailable}"
                                   FontSize="13" Foreground="#9EA2AC" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Protocol Detail Panel -->
        <Border Grid.Column="1" Background="White" CornerRadius="15" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Detail Header -->
                <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3A3A3C" Offset="0"/>
                            <GradientStop Color="#202124" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock x:Name="DetailHeaderText" Text="{x:Static res:Strings.DPOAEConfigurationView_ProtocolDetails}"
                               FontSize="14" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Empty State -->
                <Border x:Name="EmptyDetailPanel" Grid.Row="1" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="80" Height="80" CornerRadius="20"
                                Background="#D4E9F9" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Width="36" Height="36" Stretch="Uniform" Fill="#005FBE"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M5 9.2h3V19H5zM10.6 5h2.8v14h-2.8zm5.6 8H19v6h-2.8z"/>
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_SelectProtocolToViewDetails}"
                                   FontSize="13" Foreground="#9EA2AC" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Detail Form -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              x:Name="DetailFormPanel" Visibility="Collapsed">
                    <StackPanel Margin="24">

                        <!-- Common Information -->
                        <Border Margin="0,0,0,24">
                            <StackPanel>
                                <Border BorderThickness="0,0,0,2" BorderBrush="#D4E9F9"
                                        Padding="0,0,0,8" Margin="0,0,0,16">
                                    <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_CommonInformation}" FontSize="14"
                                               FontWeight="Bold" Foreground="#4b5563"/>
                                </Border>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_Name}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563"/>
                                            <TextBlock Text=" *" FontSize="13" Foreground="#dc3545" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBox x:Name="NameBox" Style="{StaticResource FormTextBoxStyle}" TextChanged="Field_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_Category}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563"/>
                                            <TextBlock Text=" *" FontSize="13" Foreground="#dc3545" FontWeight="Bold"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CategoryCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                            <ComboBoxItem Content="{x:Static res:Strings.DPOAEConfigurationView_Basic}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.DPOAEConfigurationView_Enhanced}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_Description}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                        <TextBox x:Name="DescriptionBox" Style="{StaticResource FormTextAreaStyle}" TextChanged="Field_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                        <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_Status}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="StatusCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                            <ComboBoxItem Content="{x:Static res:Strings.DPOAEConfigurationView_Active}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.DPOAEConfigurationView_Inactive}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- DPOAE Configuration -->
                        <Border>
                            <StackPanel>
                                <Border BorderThickness="0,0,0,2" BorderBrush="#D4E9F9"
                                        Padding="0,0,0,8" Margin="0,0,0,16">
                                    <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_DpoaeConfiguration}" FontSize="14"
                                               FontWeight="Bold" Foreground="#4b5563"/>
                                </Border>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_L2}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="L2Combo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                            <ComboBoxItem Content="50 dB"/>
                                            <ComboBoxItem Content="55 dB"/>
                                            <ComboBoxItem Content="60 dB"/>
                                            <ComboBoxItem Content="65 dB"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_L1}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="L1Combo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                            <ComboBoxItem Content="{x:Static res:Strings.DPOAEConfigurationView_Auto}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.DPOAEConfigurationView_L2Plus10dB}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.DPOAEConfigurationView_L2Plus5dB}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_Frequencies}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                    <WrapPanel x:Name="FrequencyPanel" Orientation="Horizontal">
                                        <WrapPanel.Resources>
                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource FreqToggleStyle}"/>
                                        </WrapPanel.Resources>
                                        <ToggleButton x:Name="Freq1000" Content="1000 Hz" Margin="0,0,6,6" Checked="Freq_Changed" Unchecked="Freq_Changed"/>
                                        <ToggleButton x:Name="Freq1500" Content="1500 Hz" Margin="0,0,6,6" IsChecked="True" Checked="Freq_Changed" Unchecked="Freq_Changed"/>
                                        <ToggleButton x:Name="Freq2000" Content="2000 Hz" Margin="0,0,6,6" IsChecked="True" Checked="Freq_Changed" Unchecked="Freq_Changed"/>
                                        <ToggleButton x:Name="Freq3000" Content="3000 Hz" Margin="0,0,6,6" IsChecked="True" Checked="Freq_Changed" Unchecked="Freq_Changed"/>
                                        <ToggleButton x:Name="Freq4000" Content="4000 Hz" Margin="0,0,6,6" IsChecked="True" Checked="Freq_Changed" Unchecked="Freq_Changed"/>
                                        <ToggleButton x:Name="Freq5000" Content="5000 Hz" Margin="0,0,6,6" IsChecked="True" Checked="Freq_Changed" Unchecked="Freq_Changed"/>
                                        <ToggleButton x:Name="Freq6000" Content="6000 Hz" Margin="0,0,6,6" IsChecked="True" Checked="Freq_Changed" Unchecked="Freq_Changed"/>
                                    </WrapPanel>
                                </StackPanel>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_RetestFrequencies}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="RetestFreqCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                            <ComboBoxItem Content="{x:Static res:Strings.DPOAEConfigurationView_Yes}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.DPOAEConfigurationView_No}"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_PassCriterion}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="PassCriterionCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                            <ComboBoxItem Content="{x:Static res:Strings.DPOAEConfigurationView_PassCriterion1Of6}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.DPOAEConfigurationView_PassCriterion2Of6}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.DPOAEConfigurationView_PassCriterion3Of6}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.DPOAEConfigurationView_PassCriterion4Of6}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.DPOAEConfigurationView_PassCriterion5Of6}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.DPOAEConfigurationView_PassCriterion6Of6}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_AutoStop}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="AutoStopCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                            <ComboBoxItem Content="{x:Static res:Strings.DPOAEConfigurationView_Yes}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.DPOAEConfigurationView_No}"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_MinLevel}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="MinLevelCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                            <ComboBoxItem Content="{x:Static res:Strings.DPOAEConfigurationView_Off}"/>
                                            <ComboBoxItem Content="0 dB"/>
                                            <ComboBoxItem Content="-5 dB"/>
                                            <ComboBoxItem Content="-10 dB"/>
                                            <ComboBoxItem Content="-15 dB"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static res:Strings.DPOAEConfigurationView_Snr}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="SNRCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                            <ComboBoxItem Content="12 dB"/>
                                            <ComboBoxItem Content="9 dB"/>
                                            <ComboBoxItem Content="6 dB"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
