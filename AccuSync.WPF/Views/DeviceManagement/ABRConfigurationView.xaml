<UserControl x:Class="AccuSync.WPF.Views.DeviceManagement.ABRConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AccuSync.WPF.Resources"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>

        <!-- Form TextBox -->

        <!-- Multi-Line TextBox -->

        <!-- Form ComboBox -->

    </UserControl.Resources>

    <Grid Background="#D4E9F9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Protocols List Panel -->
        <Border Grid.Column="0" Background="White" CornerRadius="15" Margin="0,0,10,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="15,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3A3A3C" Offset="0"/>
                            <GradientStop Color="#202124" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="{x:Static res:Strings.ABRConfigurationView_AbrProtocols}"
                               FontSize="14" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Protocol Cards -->
                <ListView Grid.Row="1" x:Name="ProtocolsListView"
                          BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Padding="8"
                          SelectionChanged="ProtocolsListView_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="CardBorder"
                                                Background="White" BorderBrush="#E0E0E0"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="12,10,12,0" Cursor="Hand">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Direction="270"
                                                                   ShadowDepth="1" BlurRadius="3" Opacity="0.08"/>
                                            </Border.Effect>
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#d0d4db"/>
                                                <Setter TargetName="CardBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="Black" Direction="270"
                                                                           ShadowDepth="4" BlurRadius="14" Opacity="0.12"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#D4E9F9"/>
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#005FBE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="#1a1a1a" Margin="0,0,0,2"/>

                                <TextBlock Text="{Binding Description}"
                                           FontSize="13" Foreground="#666"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,6"/>

                                <StackPanel Margin="0,6,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Static res:Strings.ABRConfigurationView_CategoryLabel}" FontSize="10" Foreground="#888"
                                                       FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding Category}" FontSize="12"
                                                       Foreground="#333" FontWeight="Medium"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Static res:Strings.ABRConfigurationView_StatusLabel}" FontSize="10" Foreground="#888"
                                                       FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding Status}" FontSize="12"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State -->
                <Border x:Name="EmptyListPanel" Grid.Row="1" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="80" Height="80" CornerRadius="20"
                                Background="#D4E9F9" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Width="36" Height="36" Stretch="Uniform" Fill="#005FBE"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z"/>
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.ABRConfigurationView_NoProtocolsAvailable}"
                                   FontSize="13" Foreground="#9EA2AC" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Protocol Detail Panel -->
        <Border Grid.Column="1" Background="White" CornerRadius="15" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Detail Header -->
                <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3A3A3C" Offset="0"/>
                            <GradientStop Color="#202124" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock x:Name="DetailHeaderText" Text="{x:Static res:Strings.ABRConfigurationView_ProtocolDetails}"
                               FontSize="14" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Empty State -->
                <Border x:Name="EmptyDetailPanel" Grid.Row="1" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="80" Height="80" CornerRadius="20"
                                Background="#D4E9F9" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Width="36" Height="36" Stretch="Uniform" Fill="#005FBE"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z"/>
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.ABRConfigurationView_SelectProtocolToViewDetails}"
                                   FontSize="13" Foreground="#9EA2AC" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- TODO: Form field layout (label + required asterisk + input) is repeated for every field.
                     Extract a FormField UserControl or DataTemplate, same pattern as PatientDetailsTab. -->
                <!-- Detail Form -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              x:Name="DetailFormPanel" Visibility="Collapsed">
                    <StackPanel Margin="24">

                        <!-- Common Information -->
                        <Border Margin="0,0,0,24">
                            <StackPanel>
                                <Border BorderThickness="0,0,0,2" BorderBrush="#D4E9F9"
                                        Padding="0,0,0,8" Margin="0,0,0,16">
                                    <TextBlock Text="{x:Static res:Strings.ABRConfigurationView_CommonInformation}" FontSize="14"
                                               FontWeight="Bold" Foreground="#4b5563"/>
                                </Border>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{x:Static res:Strings.ABRConfigurationView_Name}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563"/>
                                            <TextBlock Text=" *" FontSize="13" Foreground="#dc3545" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBox x:Name="NameBox" Style="{StaticResource FormTextBoxStyle}" TextChanged="Field_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{x:Static res:Strings.ABRConfigurationView_Category}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563"/>
                                            <TextBlock Text=" *" FontSize="13" Foreground="#dc3545" FontWeight="Bold"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CategoryCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                            <ComboBoxItem Content="{x:Static res:Strings.ABRConfigurationView_Basic}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.ABRConfigurationView_Enhanced}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static res:Strings.ABRConfigurationView_Description}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                        <TextBox x:Name="DescriptionBox" Style="{StaticResource FormTextAreaStyle}" TextChanged="Field_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                        <TextBlock Text="{x:Static res:Strings.ABRConfigurationView_Status}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="StatusCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                            <ComboBoxItem Content="{x:Static res:Strings.ABRConfigurationView_Active}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.ABRConfigurationView_Inactive}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ABR Configuration -->
                        <Border>
                            <StackPanel>
                                <Border BorderThickness="0,0,0,2" BorderBrush="#D4E9F9"
                                        Padding="0,0,0,8" Margin="0,0,0,16">
                                    <TextBlock Text="{x:Static res:Strings.ABRConfigurationView_AbrConfiguration}" FontSize="14"
                                               FontWeight="Bold" Foreground="#4b5563"/>
                                </Border>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{x:Static res:Strings.ABRConfigurationView_AbrLevel}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563"/>
                                            <TextBlock Text=" *" FontSize="13" Foreground="#dc3545" FontWeight="Bold"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ABRLevelCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                            <ComboBoxItem Content="30 dB"/>
                                            <ComboBoxItem Content="35 dB"/>
                                            <ComboBoxItem Content="40 dB"/>
                                            <ComboBoxItem Content="45 dB"/>
                                            <ComboBoxItem Content="50 dB"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Static res:Strings.ABRConfigurationView_NotchFilter}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="NotchFilterCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                            <ComboBoxItem Content="50 Hz"/>
                                            <ComboBoxItem Content="60 Hz"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static res:Strings.ABRConfigurationView_StimulusDuringPause}" FontSize="13" FontWeight="SemiBold" Foreground="#4b5563" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="StimulusDuringPauseCombo" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Field_Changed">
                                            <ComboBoxItem Content="{x:Static res:Strings.ABRConfigurationView_Yes}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.ABRConfigurationView_No}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
