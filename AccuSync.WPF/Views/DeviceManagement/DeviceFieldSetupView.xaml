<!-- TODO: FormComboBoxStyle is the same template copied across ABRConfigurationView, CommentsConfigView, etc. Move to shared resource dictionary. -->
<!-- TODO: FilledCheckBoxStyle is reusable across table views — move to shared styles (SelectAllCheckBoxStyle now in CommonStyles.xaml). -->
<UserControl x:Class="AccuSync.WPF.Views.DeviceManagement.DeviceFieldSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AccuSync.WPF.Resources"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>

        <!-- Brushes -->
        <SolidColorBrush x:Key="MidnightBrush"     Color="#002856"/>
        <SolidColorBrush x:Key="TextBrush"          Color="#5C5149"/>
        <SolidColorBrush x:Key="BorderBrush"        Color="#D1D5DB"/>
        <SolidColorBrush x:Key="SectionUnderline"   Color="#D4E9F9"/>
        <SolidColorBrush x:Key="HeaderLabelBrush"   Color="#6B7280"/>
        <SolidColorBrush x:Key="AltRowBrush"        Color="#fafbfc"/>
        <SolidColorBrush x:Key="TextDefaultBrush"   Color="#4b5563"/>

        <!-- Form ComboBox -->
        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#5C5149"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter Grid.Column="0" Margin="10,6"/>
                                                            <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#666"
                                                                  Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#002856"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,6,32,6" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border CornerRadius="6" MaxHeight="200"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Background="White" BorderThickness="1" BorderBrush="#D1D5DB">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.15"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row-Level Checkbox -->
        <Style x:Key="FilledCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid HorizontalAlignment="Left">
                            <Border x:Name="UncheckedBox" Width="18" Height="18"
                                    CornerRadius="3" Background="White"
                                    BorderBrush="#D1D5DB" BorderThickness="2"/>
                            <Border x:Name="CheckedBox" Width="18" Height="18"
                                    CornerRadius="3" Background="#005FBE"
                                    BorderBrush="#005FBE" BorderThickness="2"
                                    Visibility="Collapsed">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 2 6 L 5 9 L 10 3"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="UncheckedBox" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="CheckedBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="UncheckedBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckedBox" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tri-State Checkbox for Select-All Headers -->

        <!-- Inline reset (x) button shown inside custom label TextBox -->
        <Style x:Key="InlineResetButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="ToolTip" Value="{x:Static res:Strings.DeviceFieldSetupView_ResetToDefault}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ResetBorder"
                                Background="Transparent"
                                CornerRadius="9"
                                Width="18" Height="18">
                            <Path x:Name="ResetIcon"
                                  Data="M4 4 L12 12 M12 4 L4 12"
                                  Stroke="#9EA2AC"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ResetBorder" Property="Background" Value="#f3f4f6"/>
                                <Setter TargetName="ResetIcon" Property="Stroke" Value="#5C5149"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ResetBorder" Property="Background" Value="#e5e7eb"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reset All Labels button -->
        <Style x:Key="ResetAllButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#5C5149"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White"
                                BorderBrush="#D1D5DB" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#f3f4f6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#e5e7eb"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB"/>
                                <Setter TargetName="Bd" Property="Background" Value="#f3f4f6"/>
                                <Setter Property="Foreground" Value="#9EA2AC"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="#D4E9F9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="900"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Single white panel — left-aligned, capped at 1200px -->
        <Border Grid.Column="0" Background="White" CornerRadius="15"
                Margin="0,0,20,0" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270"
                                  ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Dark header -->
                <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3A3A3C" Offset="0"/>
                            <GradientStop Color="#202124" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="{x:Static res:Strings.DeviceFieldSetupView_Title}" FontSize="14"
                               FontWeight="Bold" Foreground="White"/>
                </Border>

                <!-- Patient ID Configuration (fixed — does not scroll) -->
                <StackPanel Grid.Row="1" Margin="24,24,24,0">
                    <Border BorderThickness="0,0,0,2" BorderBrush="{StaticResource SectionUnderline}"
                            Padding="0,0,0,8" Margin="0,0,0,16">
                        <TextBlock Text="{x:Static res:Strings.DeviceFieldSetupView_PatientIdConfiguration}" FontSize="14"
                                   FontWeight="Bold" Foreground="{StaticResource TextDefaultBrush}"/>
                    </Border>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Static res:Strings.DeviceFieldSetupView_PatientIdRule}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextDefaultBrush}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="PatientIdRuleCombo"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      SelectedIndex="0"
                                      SelectionChanged="ComboBox_SelectionChanged">
                                <ComboBoxItem Content="{x:Static res:Strings.DeviceFieldSetupView_None}"/>
                                <ComboBoxItem Content="{x:Static res:Strings.DeviceFieldSetupView_NhspEngland}"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Border BorderThickness="0,0,0,2" BorderBrush="{StaticResource SectionUnderline}"
                            Padding="0,0,0,8" Margin="0,0,0,16">
                        <TextBlock Text="{x:Static res:Strings.DeviceFieldSetupView_PatientFieldConfiguration}" FontSize="14"
                                   FontWeight="Bold" Foreground="{StaticResource TextDefaultBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Field table (fills remaining height — only this section scrolls) -->
                <Border Grid.Row="2" Margin="24,0,24,24"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Reset All button bar -->
                        <Border Grid.Row="0" Background="#f8f9fa"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="16,7">
                            <Button x:Name="ResetAllLabelsButton"
                                    HorizontalAlignment="Right"
                                    Content="{x:Static res:Strings.DeviceFieldSetupView_ResetAllLabels}"
                                    Style="{StaticResource ResetAllButtonStyle}"
                                    IsEnabled="False"
                                    Click="ResetAllLabels_Click"/>
                        </Border>

                        <!-- Column headers -->
                        <Border Grid.Row="1" Background="#f8f9fa"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid Margin="16,10,34,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Static res:Strings.DeviceFieldSetupView_FieldName}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource HeaderLabelBrush}"/>
                                <TextBlock Grid.Column="1" Text="{x:Static res:Strings.DeviceFieldSetupView_CustomLabel}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource HeaderLabelBrush}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <CheckBox x:Name="ActiveSelectAllCb"
                                              Style="{StaticResource SelectAllCheckBoxStyle}"
                                              Click="ActiveSelectAll_Click"
                                              Margin="0,0,8,0"/>
                                    <TextBlock Text="{x:Static res:Strings.DeviceFieldSetupView_Active}" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource HeaderLabelBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <CheckBox x:Name="MandatorySelectAllCb"
                                              Style="{StaticResource SelectAllCheckBoxStyle}"
                                              Click="MandatorySelectAll_Click"
                                              Margin="0,0,8,0"/>
                                    <TextBlock Text="{x:Static res:Strings.DeviceFieldSetupView_Mandatory}" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource HeaderLabelBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Scrollable field rows — only scrollbar in the view -->
                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="FieldTableBody"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
