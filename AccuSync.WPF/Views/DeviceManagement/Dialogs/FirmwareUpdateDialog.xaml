<Window x:Class="AccuSync.WPF.Views.DeviceManagement.Dialogs.FirmwareUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AccuSync.WPF.Resources"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- TODO: Most of these brushes duplicate keys from PatientInformationStyles.xaml
             and RibbonToolbarStyles.xaml. Use merged dictionaries or app-level resources
             instead of redeclaring per-dialog. -->
        <SolidColorBrush x:Key="PurpleBrush" Color="#473089"/>
        <SolidColorBrush x:Key="PurpleHoverBrush" Color="#5A3DA8"/>
        <SolidColorBrush x:Key="LightBlueBrush" Color="#D4E9F9"/>
        <SolidColorBrush x:Key="BrightBlueBrush" Color="#005FBE"/>
        <SolidColorBrush x:Key="MidnightBrush" Color="#002856"/>
        <SolidColorBrush x:Key="TextBrush" Color="#5C5149"/>
        <SolidColorBrush x:Key="GrayBrush" Color="#9EA2AC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#e5e7eb"/>
        <SolidColorBrush x:Key="BgLightBrush" Color="#f8f9fa"/>
        <SolidColorBrush x:Key="BgLighterBrush" Color="#f3f4f6"/>
        <SolidColorBrush x:Key="BgFooterBrush" Color="#f9fafb"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#d1d5db"/>
        <SolidColorBrush x:Key="FilledBorderBrush" Color="#28a745"/>
    </Window.Resources>

    <!-- Outer border: margin provides space for the drop shadow to render
         without clipping against the window edge. -->
    <Border Margin="20" CornerRadius="12" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="0" Color="#000000"/>
        </Border.Effect>

        <Border CornerRadius="12" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header — draggable for window repositioning -->
                <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,20,24,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static res:Strings.FirmwareUpdateDialog_Title}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- TODO: Extract this close button template into a shared style —
                                 the same pattern is used across multiple dialogs. -->
                            <Button Grid.Column="1" Click="CloseButton_Click"
                                    Width="32" Height="32" Cursor="Hand"
                                    VerticalAlignment="Center" ToolTip="{x:Static res:Strings.FirmwareUpdateDialog_Close}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseBorder" Background="{StaticResource BgLighterBrush}"
                                                CornerRadius="6" Width="32" Height="32">
                                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                  Fill="{StaticResource TextBrush}" Width="18" Height="18"
                                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseBorder" Property="Background" Value="{StaticResource BorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Body -->
                <StackPanel Grid.Row="1" Margin="24,20,24,24">

                    <TextBlock Text="{x:Static res:Strings.FirmwareUpdateDialog_EnterFolderPath}"
                               FontSize="13" Foreground="{StaticResource GrayBrush}" Margin="0,0,0,20"/>

                    <TextBlock Margin="0,0,0,6">
                        <Run Text="{x:Static res:Strings.FirmwareUpdateDialog_Folder}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <Run Text=" *" FontSize="13" FontWeight="Bold" Foreground="#dc3545"/>
                    </TextBlock>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Path display — read-only because the value comes from the folder picker.
                             Green border when a folder is selected (via HasFolder binding). -->
                        <TextBox x:Name="FolderPathTextBox" Grid.Column="0"
                                 Height="40" FontSize="14" FontFamily="Segoe UI"
                                 IsReadOnly="True" Padding="10,0,10,0"
                                 VerticalContentAlignment="Center"
                                 Foreground="{StaticResource TextBrush}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFolder, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource FilledBorderBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <TextBlock x:Name="FolderPlaceholder" Grid.Column="0"
                                   Text="{x:Static res:Strings.FirmwareUpdateDialog_NoFolderSelected}"
                                   FontSize="14" FontFamily="Segoe UI"
                                   Foreground="#aaaaaa"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   IsHitTestVisible="False"/>

                        <Button Grid.Column="2" Click="BrowseButton_Click" Cursor="Hand" Height="40">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BrowseBorder" Background="White"
                                            BorderBrush="{StaticResource TextBrush}" BorderThickness="1.5"
                                            CornerRadius="6" Padding="16,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"
                                                  Fill="{StaticResource TextBrush}" Width="16" Height="16"
                                                  Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Static res:Strings.FirmwareUpdateDialog_Browse}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                                       FontFamily="Segoe UI"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BrowseBorder" Property="Background" Value="#f5f0ff"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Shown after folder selection — displays the firmware filename and size -->
                    <StackPanel x:Name="FileMetaPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="2,6,0,0">
                        <TextBlock x:Name="FileNameText" FontSize="11" FontWeight="Medium"
                                   Foreground="{StaticResource BrightBlueBrush}"/>
                        <TextBlock x:Name="FileSizeText" FontSize="11"
                                   Foreground="{StaticResource GrayBrush}" Margin="16,0,0,0"/>
                    </StackPanel>

                    <!-- Shown when the selected folder contains no recognizable firmware file -->
                    <TextBlock x:Name="NoFirmwareText" FontSize="11" FontWeight="Medium"
                               Visibility="Collapsed" Margin="2,6,0,0"
                               Foreground="#D9534F"
                               Text="{x:Static res:Strings.FirmwareUpdateDialog_NoFirmwareFound}"/>

                    <!-- Device info card — populated by code-behind with current device state -->
                    <Border Background="{StaticResource BgLighterBrush}" CornerRadius="8"
                            Padding="16,14" Margin="0,20,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static res:Strings.FirmwareUpdateDialog_ConnectedDevice}" FontSize="12" FontWeight="Medium"
                                           Foreground="{StaticResource GrayBrush}"/>
                                <TextBlock x:Name="DeviceNameText" Grid.Column="1" FontSize="13"
                                           FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static res:Strings.FirmwareUpdateDialog_CurrentFirmware}" FontSize="12" FontWeight="Medium"
                                           Foreground="{StaticResource GrayBrush}"/>
                                <TextBlock x:Name="CurrentFirmwareText" Grid.Column="1" FontSize="13"
                                           FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static res:Strings.FirmwareUpdateDialog_HardwareVersion}" FontSize="12" FontWeight="Medium"
                                           Foreground="{StaticResource GrayBrush}"/>
                                <TextBlock x:Name="HardwareVersionText" Grid.Column="1" FontSize="13"
                                           FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Background="{StaticResource BgFooterBrush}" Padding="24,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                        <Button Click="CancelButton_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CancelBorder" Background="White"
                                            BorderBrush="{StaticResource ButtonBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="24,10">
                                        <TextBlock Text="{x:Static res:Strings.FirmwareUpdateDialog_Cancel}" FontSize="14" FontWeight="Medium"
                                                   Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CancelBorder" Property="Background"
                                                    Value="{StaticResource BgLighterBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Disabled until a valid firmware folder is selected -->
                        <Button x:Name="UpdateButton" Click="UpdateButton_Click" Cursor="Hand"
                                Margin="10,0,0,0" IsEnabled="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="UpdateBorder" Background="{StaticResource PurpleBrush}"
                                            CornerRadius="6" Padding="24,10">
                                        <TextBlock Text="{x:Static res:Strings.FirmwareUpdateDialog_Update}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" FontFamily="Segoe UI"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="UpdateBorder" Property="Background"
                                                    Value="{StaticResource PurpleHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="UpdateBorder" Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>