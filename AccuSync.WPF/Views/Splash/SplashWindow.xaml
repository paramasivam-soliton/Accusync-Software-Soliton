<Window x:Class="AccuSync.WPF.Views.Splash.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AccuSync.WPF.Resources"
        Title="{x:Static res:Strings.SplashWindow_Title}"
        Height="400" 
        Width="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#D4E9F9" 
            BorderBrush="#428FEC" 
            BorderThickness="2"
            >
        <Border.Effect>
            <DropShadowEffect Color="#428FEC" 
                            Direction="0" 
                            ShadowDepth="0" 
                            BlurRadius="30" 
                            Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Image Grid.Row="0" 
                   Source="pack://application:,,,/Resources/Images/splash.png"
                   Stretch="UniformToFill"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1"
                      Text="{Binding StatusMessage}"
                      FontSize="20"
                      Foreground="#2C3E50"
                      FontFamily="Arial"
                      HorizontalAlignment="Center"/>

            <!-- Loading bar fills parent width via binding -->
            <Grid Grid.Row="2" Margin="20,0,20,20">
                <Border Background="#B8D9F2" 
                        CornerRadius="10"
                        Height="6">
                    <Border x:Name="LoadingBar"
                            Background="#005FBE"
                            CornerRadius="4"
                            HorizontalAlignment="Left">
                        <Border.Width>
                            <Binding Path="ActualWidth" 
                                    RelativeSource="{RelativeSource AncestorType=Border}"/>
                        </Border.Width>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>