<!-- TODO: Three password field groups are identical in structure. Extract a PasswordField UserControl. -->
<!-- TODO: Seven requirement rows are identical except binding and label. Generate from ItemsControl. -->
<!-- TODO: ModernTextBox and ModernPasswordBox styles are nearly identical. Consider a shared base. -->
<!-- NOTE: PasswordBox can't use data binding for Password (WPF security restriction),
     so PasswordChanged handlers in code-behind bridge to the ViewModel. -->
<Window x:Class="AccuSync.WPF.Views.Login.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AccuSync.WPF.Resources"
        Title="{x:Static res:Strings.ChangePasswordWindow_Title}"
        Height="550" 
        Width="850"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        FocusManager.FocusedElement="{Binding ElementName=OldPasswordBox}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderBrush" Value="#428FEC"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CaretBrush" Value="#428FEC"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderBrush" Value="#428FEC"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CaretBrush" Value="#428FEC"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PasswordToggleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8F4FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="Background" Value="#428FEC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="25"
                                Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5BA3F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#357ABD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#B0BEC5"/>
                                <Setter Property="Foreground" Value="#ECEFF1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#D4E9F9"
            BorderBrush="#428FEC"
            BorderThickness="2"
            CornerRadius="20"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#428FEC"
                            Direction="0"
                            ShadowDepth="0"
                            BlurRadius="40"
                            Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <!-- Close Button -->
            <Button Style="{StaticResource CloseButton}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,12,12,0"
                   Panel.ZIndex="1"
                   Click="CloseButton_Click"
                   ToolTip="{x:Static res:Strings.ChangePasswordWindow_Close}">
                <Path Width="14" Height="14"
                      Stretch="Uniform"
                      Fill="#5A6C7D"
                      Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
            </Button>

        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
                <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_Heading}"
                          FontSize="32"
                          FontWeight="Bold"
                          Foreground="#428FEC"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10"/>

                <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_Subtitle}"
                          FontSize="13"
                          Foreground="#5A6C7D"
                          FontWeight="Medium"
                          HorizontalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Password Fields -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ErrorMessage}"
                              Foreground="#E74C3C"
                              FontSize="12"
                              TextWrapping="Wrap"
                              FontWeight="Medium"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,15"
                              Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_CurrentPassword}"
                              FontSize="13"
                              Foreground="#2C3E50"
                              Margin="5,0,0,8"
                              FontWeight="SemiBold"/>
                    <Grid Margin="0,0,0,20">
                        <PasswordBox x:Name="OldPasswordBox"
                                    Style="{StaticResource ModernPasswordBox}"
                                    PasswordChanged="OldPasswordBox_PasswordChanged"
                                    TabIndex="0"/>

                        <TextBox x:Name="OldPasswordTextBox"
                                Text="{Binding OldPassword, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ModernTextBox}"
                                Visibility="Collapsed"
                                TabIndex="0"/>

                        <Button x:Name="OldPasswordToggleButton"
                               Style="{StaticResource PasswordToggleButton}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"
                               TabIndex="1"
                               Click="ToggleOldPasswordVisibility_Click"
                               ToolTip="{x:Static res:Strings.ChangePasswordWindow_ShowPassword}">
                            <Path x:Name="OldPasswordEyeIcon"
                                  Width="20" 
                                  Height="20"
                                  Stretch="Uniform"
                                  Fill="#428FEC"
                                  Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_NewPassword}"
                              FontSize="13"
                              Foreground="#2C3E50"
                              Margin="5,0,0,8"
                              FontWeight="SemiBold"/>
                    <Grid Margin="0,0,0,20">
                        <PasswordBox x:Name="NewPasswordBox"
                                    Style="{StaticResource ModernPasswordBox}"
                                    PasswordChanged="NewPasswordBox_PasswordChanged"
                                    TabIndex="2"/>

                        <TextBox x:Name="NewPasswordTextBox"
                                Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ModernTextBox}"
                                Visibility="Collapsed"
                                TabIndex="2"/>

                        <Button x:Name="NewPasswordToggleButton"
                               Style="{StaticResource PasswordToggleButton}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"
                               TabIndex="3"
                               Click="ToggleNewPasswordVisibility_Click"
                               ToolTip="{x:Static res:Strings.ChangePasswordWindow_ShowPassword}">
                            <Path x:Name="NewPasswordEyeIcon"
                                  Width="20" 
                                  Height="20"
                                  Stretch="Uniform"
                                  Fill="#428FEC"
                                  Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_ConfirmNewPassword}"
                              FontSize="13"
                              Foreground="#2C3E50"
                              Margin="5,0,0,8"
                              FontWeight="SemiBold"/>
                    <Grid Margin="0,0,0,25">
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                    Style="{StaticResource ModernPasswordBox}"
                                    PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                    TabIndex="4"/>

                        <TextBox x:Name="ConfirmPasswordTextBox"
                                Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ModernTextBox}"
                                Visibility="Collapsed"
                                TabIndex="4"/>

                        <Button x:Name="ConfirmPasswordToggleButton"
                               Style="{StaticResource PasswordToggleButton}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"
                               TabIndex="5"
                               Click="ToggleConfirmPasswordVisibility_Click"
                               ToolTip="{x:Static res:Strings.ChangePasswordWindow_ShowPassword}">
                            <Path x:Name="ConfirmPasswordEyeIcon"
                                  Width="20" 
                                  Height="20"
                                  Stretch="Uniform"
                                  Fill="#428FEC"
                                  Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                        </Button>
                    </Grid>

                    <Button Content="{x:Static res:Strings.ChangePasswordWindow_SavePassword}"
                           Command="{Binding SaveCommand}"
                           Style="{StaticResource SaveButton}"
                           IsEnabled="{Binding CanSave}"
                           HorizontalAlignment="Center"
                           Width="250"
                           TabIndex="6"
                           IsDefault="True"/>
                </StackPanel>

                <!-- Password Requirements Checklist -->
                <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="#428FEC"
                        BorderThickness="2"
                        CornerRadius="10"
                        Padding="25"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_PasswordRequirements}"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="#2C3E50"
                                  Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Width="18" Height="18" 
                                  Stretch="Uniform"
                                  Fill="{Binding HasMinimumLength, Converter={StaticResource BooleanToColorConverter}}"
                                  Data="{Binding HasMinimumLength, Converter={StaticResource BooleanToCheckIconConverter}}"
                                  Margin="0,0,10,0"/>
                            <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_ReqMinLength}"
                                      FontSize="12"
                                      Foreground="#5A6C7D"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Width="18" Height="18" 
                                  Stretch="Uniform"
                                  Fill="{Binding HasUpperCase, Converter={StaticResource BooleanToColorConverter}}"
                                  Data="{Binding HasUpperCase, Converter={StaticResource BooleanToCheckIconConverter}}"
                                  Margin="0,0,10,0"/>
                            <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_ReqUpperCase}"
                                      FontSize="12"
                                      Foreground="#5A6C7D"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Width="18" Height="18" 
                                  Stretch="Uniform"
                                  Fill="{Binding HasLowerCase, Converter={StaticResource BooleanToColorConverter}}"
                                  Data="{Binding HasLowerCase, Converter={StaticResource BooleanToCheckIconConverter}}"
                                  Margin="0,0,10,0"/>
                            <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_ReqLowerCase}"
                                      FontSize="12"
                                      Foreground="#5A6C7D"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Width="18" Height="18" 
                                  Stretch="Uniform"
                                  Fill="{Binding HasNumber, Converter={StaticResource BooleanToColorConverter}}"
                                  Data="{Binding HasNumber, Converter={StaticResource BooleanToCheckIconConverter}}"
                                  Margin="0,0,10,0"/>
                            <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_ReqNumber}"
                                      FontSize="12"
                                      Foreground="#5A6C7D"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Width="18" Height="18" 
                                  Stretch="Uniform"
                                  Fill="{Binding HasSpecialChar, Converter={StaticResource BooleanToColorConverter}}"
                                  Data="{Binding HasSpecialChar, Converter={StaticResource BooleanToCheckIconConverter}}"
                                  Margin="0,0,10,0"/>
                            <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_ReqSpecialChar}"
                                      FontSize="12"
                                      Foreground="#5A6C7D"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Width="18" Height="18" 
                                  Stretch="Uniform"
                                  Fill="{Binding PasswordsMatch, Converter={StaticResource BooleanToColorConverter}}"
                                  Data="{Binding PasswordsMatch, Converter={StaticResource BooleanToCheckIconConverter}}"
                                  Margin="0,0,10,0"/>
                            <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_ReqPasswordsMatch}"
                                      FontSize="12"
                                      Foreground="#5A6C7D"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" 
                                  Stretch="Uniform"
                                  Fill="{Binding NotSameAsOld, Converter={StaticResource BooleanToColorConverter}}"
                                  Data="{Binding NotSameAsOld, Converter={StaticResource BooleanToCheckIconConverter}}"
                                  Margin="0,0,10,0"/>
                            <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_ReqNotSameAsOld}"
                                      FontSize="12"
                                      Foreground="#5A6C7D"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        </Grid>
    </Border>
</Window>