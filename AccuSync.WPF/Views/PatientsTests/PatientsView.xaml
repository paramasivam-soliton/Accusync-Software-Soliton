<UserControl x:Class="AccuSync.WPF.Views.PatientsTests.PatientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AccuSync.WPF.Views.PatientsTests"
             xmlns:res="clr-namespace:AccuSync.WPF.Resources"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BulkActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        CornerRadius="4" 
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" 
                                Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectAllCheckBoxStyle" TargetType="CheckBox"
       BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <DataTemplate x:Key="DetailedCardTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <CheckBox HorizontalAlignment="Right" 
                  VerticalAlignment="Top"
                  Margin="0,-4,0,0"
                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                  Visibility="{Binding DataContext.CheckboxVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  IsHitTestVisible="False">
                    <CheckBox.RenderTransform>
                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                    </CheckBox.RenderTransform>
                </CheckBox>

                <Grid Grid.Row="0" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3A3A3C" Offset="0"/>
                                <GradientStop Color="#202124" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{Binding Initials}" FontSize="15" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1a1a1a" Margin="0,0,0,2">
                    <Run Text="{Binding LastName}"/><Run Text=", "/><Run Text="{Binding FirstName}"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static res:Strings.PatientsView_IdLabel}" FontSize="13" Foreground="#666"/>
                            <TextBlock Text="{Binding PatientId}" FontSize="13" Foreground="#666" Margin="0,0,8,0"/>
                            <TextBlock Text="&#x2022;" FontSize="13" Foreground="#666" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Gender}" FontSize="13" Foreground="#666"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static res:Strings.PatientsView_DateOfBirthLabel}" FontSize="10" Foreground="#888" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding BirthDate, StringFormat='{}{0:MM/dd/yyyy}'}" FontSize="12" Foreground="#333" FontWeight="Medium"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Static res:Strings.PatientsView_DateOfScreenLabel}" FontSize="10" Foreground="#888" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock FontSize="12" Foreground="#333" FontWeight="Medium">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding DateOfScreen, StringFormat='{}{0:MM/dd/yyyy}'}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DateOfScreen}" Value="{x:Null}">
                                            <Setter Property="Text" Value="--"/>
                                            <Setter Property="Foreground" Value="#9E9E9E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CompactCardTemplate">
            <Grid>
                <CheckBox HorizontalAlignment="Right" 
                  VerticalAlignment="Top"
                  Margin="0,-2,0,0"
                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                  Visibility="{Binding DataContext.CheckboxVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  IsHitTestVisible="False">
                    <CheckBox.RenderTransform>
                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                    </CheckBox.RenderTransform>
                </CheckBox>

                <StackPanel>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#1a1a1a"
                       TextTrimming="CharacterEllipsis">
                <Run Text="{Binding LastName}"/><Run Text=", "/><Run Text="{Binding FirstName}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{x:Static res:Strings.PatientsView_IdLabel}" FontSize="11" Foreground="#888"/>
                        <TextBlock Text="{Binding PatientId}" FontSize="11" Foreground="#888"/>
                        <TextBlock Text="  &#x2022;  " FontSize="11" Foreground="#888"/>
                        <TextBlock Text="{Binding Gender}" FontSize="11" Foreground="#888"/>
                        <TextBlock Text="  &#x2022;  " FontSize="11" Foreground="#888"/>
                        <TextBlock Text="{x:Static res:Strings.PatientsView_DobLabel}" FontSize="11" Foreground="#888"/>
                        <TextBlock Text="{Binding BirthDate, StringFormat='{}{0:MM/dd/yyyy}'}" FontSize="11" Foreground="#888"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="ExportOptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="8" 
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#6BA3D0"/>
                    <Setter Property="Background" Value="#F0F7FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#D4E9F9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid x:Name="NormalPanelsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" MinWidth="280" MaxWidth="500"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="3*" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="2*" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- Patients List Panel -->
            <Border Grid.Column="0" Background="White" CornerRadius="15" Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="15,9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3A3A3C" Offset="0"/>
                                <GradientStop Color="#202124" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="{x:Static res:Strings.PatientsView_Patients}"
                                       FontSize="14"
                                       FontWeight="Bold" 
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <!-- View toggle: swaps between Detailed and Compact -->
                            <Button x:Name="ViewToggleButton" 
                                    Grid.Column="1" 
                                    Style="{StaticResource HeaderIconButtonStyle}"
                                    Margin="0,0,6,0"
                                    ToolTip="{x:Static res:Strings.PatientsView_SwitchToCompactView}"
                                    Click="ViewToggle_Click">
                                <Path x:Name="ViewToggleIcon" 
                                      Width="18" Height="18" 
                                      Stretch="Uniform" 
                                      Fill="White"
                                      Data="M2,3 L16,3 L16,4.8 L2,4.8 Z M2,7 L16,7 L16,8.8 L2,8.8 Z M2,11 L16,11 L16,12.8 L2,12.8 Z M2,15 L16,15 L16,16.8 L2,16.8 Z"/>
                            </Button>

                            <Button x:Name="SelectionModeToggle" 
                                    Grid.Column="2" 
                                    Style="{StaticResource HeaderIconButtonStyle}"
                                    Margin="0,0,6,0"
                                    ToolTip="{x:Static res:Strings.PatientsView_SelectPatients}"
                                    Click="SelectionModeToggle_Click">
                                <Path Width="22" Height="22" 
                                      Stretch="Uniform" 
                                      Fill="White"
                                      Data="M3 10h11v2H3v-2zm0-4h11v2H3V6zm0 8h7v2H3v-2zm15.01-3.13l1.41-1.41 2.12 2.12-1.41 1.41-2.12-2.12zm-.71.71l-5.3 5.3V19h2.12l5.3-5.3-2.12-2.12z"/>
                            </Button>

                            <Button Grid.Column="3" 
                                    Style="{StaticResource HeaderIconButtonStyle}"
                                    ToolTip="{x:Static res:Strings.PatientsView_Refresh}"
                                    Click="RefreshPatients_Click">
                                <Path Width="18" Height="18" 
                                      Stretch="Uniform" 
                                      Fill="White"
                                      Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Search Bar -->
                    <Border Grid.Row="1" Background="White" Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <!-- NOTE: Uses hardcoded Text as placeholder instead of watermark adorner -->
                                <TextBox x:Name="SearchBox"
                                         Background="#F5F5F5"
                                         BorderBrush="#D1D5DB"
                                         BorderThickness="1"
                                         Padding="10,8,35,8"
                                         FontSize="13"
                                         VerticalContentAlignment="Center"
                                         Text="{x:Static res:Strings.PatientsView_SearchPlaceholder}"/>

                                <Button x:Name="ClearSearchButton"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,10,0"
                                        Padding="5"
                                        Cursor="Hand"
                                        Visibility="Collapsed"
                                        Click="ClearSearch_Click"
                                        ToolTip="{x:Static res:Strings.PatientsView_ClearSearch}">
                                    <Path Width="14" Height="14"
                                          Stretch="Uniform"
                                          Fill="#6B7280"
                                          Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                                </Button>
                            </Grid>

                            <Button Grid.Column="1"
                                    Margin="5,0,5,0"
                                    Cursor="Hand"
                                    ToolTip="{x:Static res:Strings.PatientsView_Search}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#3A3A3C"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="10"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" 
                                                            Background="{TemplateBinding Background}" 
                                                            CornerRadius="6" 
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#4A4A4D"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Path Width="16" Height="16"
                                      Stretch="Uniform"
                                      Fill="White"
                                      Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                            </Button>

                            <Button x:Name="FilterToggle"
                                    Grid.Column="2"
                                    Cursor="Hand"
                                    ToolTip="{x:Static res:Strings.PatientsView_FilterOptions}"
                                    Click="FilterToggle_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#f3f4f6"/>
                                        <Setter Property="BorderBrush" Value="#d1d5db"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Padding" Value="10"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" 
                                                            Background="{TemplateBinding Background}" 
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6" 
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#e5e7eb"/>
                                                            <Setter TargetName="border" Property="BorderBrush" Value="#9ca3af"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Path Width="16" Height="16"
                                      Stretch="Uniform"
                                      Fill="#4b5563"
                                      Data="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"/>
                            </Button>

                            <Popup x:Name="FilterPopup"
                                   PlacementTarget="{Binding ElementName=FilterToggle}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="True">
                                <Border Background="White"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="15"
                                        Width="250">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.2"/>
                                    </Border.Effect>

                                    <StackPanel>
                                        <TextBlock Text="{x:Static res:Strings.PatientsView_SelectFilters}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" 
                                                   Foreground="#2C3E50"
                                                   Margin="0,0,0,10"/>

                                        <CheckBox x:Name="ChkFirstName" Content="{x:Static res:Strings.PatientsView_FilterFirstName}" FontSize="13" Margin="0,5"/>
                                        <CheckBox x:Name="ChkLastName" Content="{x:Static res:Strings.PatientsView_FilterLastName}" FontSize="13" Margin="0,5"/>
                                        <CheckBox x:Name="ChkBirthDate" Content="{x:Static res:Strings.PatientsView_FilterBirthDate}" FontSize="13" Margin="0,5"/>
                                        <CheckBox x:Name="ChkPatientId" Content="{x:Static res:Strings.PatientsView_FilterPatientId}" FontSize="13" Margin="0,5"/>
                                        <CheckBox x:Name="ChkGender" Content="{x:Static res:Strings.PatientsView_FilterGender}" FontSize="13" Margin="0,5"/>

                                        <Grid Margin="0,15,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Content="{x:Static res:Strings.PatientsView_Cancel}" Click="FilterCancel_Click"
                                                    Background="#E5E7EB" Foreground="#2C3E50" BorderThickness="0"
                                                    Padding="10,8" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Grid.Column="2" Content="{x:Static res:Strings.PatientsView_Apply}" Click="FilterApply_Click"
                                                    Background="#3A3A3C" Foreground="White" BorderThickness="0"
                                                    Padding="10,8" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <!-- Dynamic Filter Fields -->
                    <Border x:Name="FilterFieldsPanel" Grid.Row="2" Background="White" Padding="15,10" Visibility="Collapsed">
                        <StackPanel x:Name="FilterFieldsContainer"/>
                    </Border>

                    <!-- Sort Controls -->
                    <Border Grid.Row="3" Background="White" Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.PatientsView_SortBy}" FontSize="13" Foreground="#666" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="SortComboBox" Grid.Column="1" FontSize="13" SelectionChanged="SortComboBox_SelectionChanged"
                                      Padding="10,6" BorderBrush="#DDD" BorderThickness="1">
                                <ComboBox.Resources>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBox">
                                                    <Grid>
                                                        <ToggleButton x:Name="ToggleButton" Grid.Column="2"
                                                                      Focusable="false"
                                                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                      ClickMode="Press">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                                        CornerRadius="6">
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <ContentPresenter Grid.Column="0" Margin="10,6"/>
                                                                                        <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#666" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Setter Property="Background" Value="White"/>
                                                                    <Setter Property="BorderBrush" Value="#DDD"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#6BA3D0"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>
                                                        <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                                          Margin="10,6,32,6" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                        <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                                            <Border CornerRadius="6" MaxHeight="200" MinWidth="{TemplateBinding ActualWidth}"
                                                                    Background="White" BorderThickness="1" BorderBrush="#DDD">
                                                                <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                                </ScrollViewer>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBoxItem Content="{x:Static res:Strings.PatientsView_SortLastNameAsc}" IsSelected="True"/>
                                <ComboBoxItem Content="{x:Static res:Strings.PatientsView_SortFirstNameAsc}"/>
                                <ComboBoxItem Content="{x:Static res:Strings.PatientsView_SortBirthDateNewest}"/>
                                <ComboBoxItem Content="{x:Static res:Strings.PatientsView_SortBirthDateOldest}"/>
                                <ComboBoxItem Content="{x:Static res:Strings.PatientsView_SortDateOfScreenRecent}"/>
                                <ComboBoxItem Content="{x:Static res:Strings.PatientsView_SortPatientId}"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Bulk Actions Bar -->
                    <Border x:Name="BulkActionsBar" Grid.Row="4" Background="#f8f9fa" Padding="10,8"
                        BorderThickness="0,0,0,1" BorderBrush="#e5e7eb" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                Style="{StaticResource BulkActionButtonStyle}"
                                Tag="#fee2e2"
                                Click="BulkDelete_Click"
                                ToolTip="{x:Static res:Strings.PatientsView_DeleteSelectedPatients}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="14" Height="14" Stretch="Uniform" Fill="#dc2626"
                                      VerticalAlignment="Center" Margin="0,0,5,0"
                                      Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                    <TextBlock Text="{x:Static res:Strings.PatientsView_Delete}" FontSize="12" Foreground="#dc2626"
                                       FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                Style="{StaticResource BulkActionButtonStyle}"
                                Tag="#f3f4f6"
                                Click="ClearSelection_Click"
                                ToolTip="{x:Static res:Strings.PatientsView_ClearSelection}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="12" Height="12" Stretch="Uniform" Fill="#9ca3af"
                                        VerticalAlignment="Center" Margin="0,0,4,0"
                                        Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                                    <TextBlock Text="{x:Static res:Strings.PatientsView_Clear}" FontSize="12" Foreground="#9ca3af"
                                        FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Patient Count Bar and List -->
                    <Border Grid.Row="5" Background="White" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="15,8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3A3A3C" Offset="0"/>
                                        <GradientStop Color="#202124" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="PatientCountText" Grid.Column="0" 
                                               Text="{x:Static res:Strings.PatientsView_PatientCount}" FontSize="12" Foreground="White"
                                               FontWeight="Medium" VerticalAlignment="Center"/>

                                    <CheckBox x:Name="SelectAllCheckBox" 
                                              Grid.Column="1"
                                              Style="{StaticResource SelectAllCheckBoxStyle}"
                                              Content="{x:Static res:Strings.PatientsView_SelectAll}"
                                              IsThreeState="True"
                                              Visibility="Collapsed"
                                              Click="SelectAll_Click"/>
                                </Grid>
                            </Border>

                            <ListView Grid.Row="1" x:Name="PatientsListView" BorderThickness="0" Background="Transparent"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="8"
                                      ItemTemplate="{StaticResource DetailedCardTemplate}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <EventSetter Event="PreviewMouseDown" Handler="ListViewItem_PreviewMouseDown"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="CardBorder" Background="White" BorderBrush="#E0E0E0" BorderThickness="1,1,1,1"
                                                            CornerRadius="8" Padding="10" Cursor="Hand">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="1" BlurRadius="3" Opacity="0.1"/>
                                                        </Border.Effect>

                                                        <Grid>
                                                            <ContentPresenter/>
                                                        </Grid>
                                                    </Border>

                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#d0d4db"/>
                                                            <Setter TargetName="CardBorder" Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="14" Opacity="0.12"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                        <!-- Active patient highlight — this is ListView selection, not the bulk checkbox -->
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="CardBorder" Property="Background" Value="#D4E9F9"/>
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#005FBE"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Pagination -->
                    <Border Grid.Row="6" Background="White" Padding="12,10" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0" CornerRadius="0,0,15,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="PaginationInfoText" Text="{x:Static res:Strings.PatientsView_PaginationInfo}" FontSize="12" Foreground="#666" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="PrevPageButton" Content="‹" Padding="8,4" FontSize="14" Margin="2" Click="PrevPage_Click"
                                        Background="White" BorderBrush="#DDD" BorderThickness="1" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <StackPanel x:Name="PageNumbersPanel" Orientation="Horizontal"/>

                                <Button x:Name="NextPageButton" Content="›" Padding="8,4" FontSize="14" Margin="2" Click="NextPage_Click"
                                        Background="White" BorderBrush="#DDD" BorderThickness="1" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static res:Strings.PatientsView_PerPage}" FontSize="12" Foreground="#666" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ItemsPerPageComboBox" FontSize="12" SelectionChanged="ItemsPerPage_Changed">
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="10" IsSelected="True"/>
                                    <ComboBoxItem Content="25"/>
                                    <ComboBoxItem Content="50"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter: Panel 1 ↔ Panel 2 -->
            <GridSplitter Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Patient Information Panel -->
            <Border Grid.Column="2" Background="White" CornerRadius="15" Margin="5,0,5,0" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                </Border.Effect>
                <local:PatientInformationView x:Name="PatientInfoPanel"/>
            </Border>

            <!-- Splitter: Panel 2 ↔ Panel 3 -->
            <GridSplitter Grid.Column="3" Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Test Results Panel -->
            <Border Grid.Column="4" Background="White" CornerRadius="15" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                </Border.Effect>
                <local:TestResultsView x:Name="TestResultsPanel"/>
            </Border>
        </Grid>

        <local:ImportReview x:Name="ImportReview" 
                              Visibility="Collapsed" Margin="20"/>
        <local:FacesheetReview x:Name="FacesheetReview" Visibility="Collapsed"/>

        <!-- Export Modal Overlay -->
        <Border x:Name="ExportModalOverlay" Background="#80000000" Visibility="Collapsed" MouseDown="ExportModalOverlay_MouseDown">
            <Border Background="White" Width="350" Height="Auto" CornerRadius="12" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="24" Opacity="0.3"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.PatientsView_ExportPatientList}" FontSize="18" FontWeight="SemiBold" Foreground="#1a1a1a" Margin="0,0,0,16"/>

                    <Button Style="{StaticResource ExportOptionButtonStyle}" Click="ExportCSV_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" Background="#F8F9FA" CornerRadius="8" Margin="0,0,12,0">
                                <TextBlock Text="{x:Static res:Strings.PatientsView_CsvBadge}" FontSize="14" FontWeight="SemiBold" Foreground="#5C5149" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Static res:Strings.PatientsView_CsvFileTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#1a1a1a"/>
                                <TextBlock Text="{x:Static res:Strings.PatientsView_CsvFileDescription}" FontSize="11" Foreground="#666"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource ExportOptionButtonStyle}" Click="ExportExcel_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" Background="#F8F9FA" CornerRadius="8" Margin="0,0,12,0">
                                <TextBlock Text="{x:Static res:Strings.PatientsView_XlsBadge}" FontSize="14" FontWeight="SemiBold" Foreground="#5C5149" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Static res:Strings.PatientsView_ExcelFileTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#1a1a1a"/>
                                <TextBlock Text="{x:Static res:Strings.PatientsView_ExcelFileDescription}" FontSize="11" Foreground="#666"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource ExportOptionButtonStyle}" Click="ExportPDF_Click" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" Background="#F8F9FA" CornerRadius="8" Margin="0,0,12,0">
                                <TextBlock Text="{x:Static res:Strings.PatientsView_PdfBadge}" FontSize="14" FontWeight="SemiBold" Foreground="#5C5149" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Static res:Strings.PatientsView_PdfDocumentTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#1a1a1a"/>
                                <TextBlock Text="{x:Static res:Strings.PatientsView_PdfDocumentDescription}" FontSize="11" Foreground="#666"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Content="{x:Static res:Strings.PatientsView_Cancel}" Click="CloseExportModal_Click" Padding="10" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                            Background="#E0E0E0" Foreground="#333" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>