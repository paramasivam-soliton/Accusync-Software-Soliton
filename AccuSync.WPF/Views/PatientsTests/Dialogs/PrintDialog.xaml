<Window x:Class="AccuSync.WPF.Views.PatientsTests.Dialogs.PrintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AccuSync.WPF.Resources"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- TODO: Same brush duplication as the other three dialogs. -->
        <SolidColorBrush x:Key="PurpleBrush" Color="#473089"/>
        <SolidColorBrush x:Key="PurpleHoverBrush" Color="#5A3DA8"/>
        <SolidColorBrush x:Key="LightBlueBrush" Color="#D4E9F9"/>
        <SolidColorBrush x:Key="BrightBlueBrush" Color="#005FBE"/>
        <SolidColorBrush x:Key="MidnightBrush" Color="#002856"/>
        <SolidColorBrush x:Key="TextBrush" Color="#5C5149"/>
        <SolidColorBrush x:Key="GrayBrush" Color="#9EA2AC"/>
        <SolidColorBrush x:Key="SkyBrush" Color="#428FEC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#e5e7eb"/>
        <SolidColorBrush x:Key="BgLighterBrush" Color="#f3f4f6"/>
        <SolidColorBrush x:Key="BgFooterBrush" Color="#f9fafb"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#d1d5db"/>
    </Window.Resources>

    <Border Margin="20" CornerRadius="12" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="0" Color="#000000"/>
        </Border.Effect>

        <Border CornerRadius="12" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header — draggable -->
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="24,20,24,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static res:Strings.PrintDialog_Title}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource MidnightBrush}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1" Click="CloseButton_Click"
                                Width="32" Height="32" Cursor="Hand" ToolTip="{x:Static res:Strings.PrintDialog_Close}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CloseBorder" Background="{StaticResource BgLighterBrush}"
                                            CornerRadius="6" Width="32" Height="32">
                                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                              Fill="{StaticResource TextBrush}" Width="18" Height="18"
                                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseBorder" Property="Background" Value="{StaticResource BorderBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body — two columns of selectable report cards.
                     Tag format is "Category|ReportType" (parsed in code-behind).
                     Both columns share the same five report types with identical icons. -->
                <!-- TODO: The 10 cards are identical in structure — only Tag, x:Name,
                     and label text differ. A DataTemplate with an ItemsControl per
                     column would replace ~200 lines of duplicated XAML. -->
                <Grid Grid.Row="1" Margin="24,20,24,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Basic reports -->
                    <StackPanel Grid.Column="0">
                        <Border BorderThickness="0,0,0,2" BorderBrush="{StaticResource LightBlueBrush}"
                                Padding="0,0,0,6" Margin="0,0,0,8">
                            <TextBlock Text="{x:Static res:Strings.PrintDialog_BasicReports}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>
                        </Border>

                        <Border x:Name="BasicBestTests" Tag="Basic|BestTests"
                                MouseLeftButtonDown="ReportCard_Click"
                                MouseEnter="ReportCard_MouseEnter" MouseLeave="ReportCard_MouseLeave"
                                BorderThickness="1" CornerRadius="8" Padding="12,10"
                                Cursor="Hand" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="BasicBestTestsIcon" Width="32" Height="32"
                                        CornerRadius="6" Margin="0,0,10,0">
                                    <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"
                                          Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Static res:Strings.PrintDialog_BestTests}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="BasicBestTEOAE" Tag="Basic|BestTEOAE"
                                MouseLeftButtonDown="ReportCard_Click"
                                MouseEnter="ReportCard_MouseEnter" MouseLeave="ReportCard_MouseLeave"
                                BorderThickness="1" CornerRadius="8" Padding="12,10"
                                Cursor="Hand" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="BasicBestTEOAEIcon" Width="32" Height="32"
                                        CornerRadius="6" Margin="0,0,10,0">
                                    <Path Data="M7 18h2V6H7v12zm4 4h2V2h-2v20zm-8-8h2v-4H3v4zm12 4h2V6h-2v12zm4-8v4h2v-4h-2z"
                                          Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Static res:Strings.PrintDialog_BestTeoaeTest}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="BasicBestDPOAE" Tag="Basic|BestDPOAE"
                                MouseLeftButtonDown="ReportCard_Click"
                                MouseEnter="ReportCard_MouseEnter" MouseLeave="ReportCard_MouseLeave"
                                BorderThickness="1" CornerRadius="8" Padding="12,10"
                                Cursor="Hand" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="BasicBestDPOAEIcon" Width="32" Height="32"
                                        CornerRadius="6" Margin="0,0,10,0">
                                    <Path Data="M5 9.2h3V19H5V9.2zM10.6 5h2.8v14h-2.8V5zm5.6 8H19v6h-2.8v-6z"
                                          Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Static res:Strings.PrintDialog_BestDpoaeTest}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="BasicBestABR" Tag="Basic|BestABR"
                                MouseLeftButtonDown="ReportCard_Click"
                                MouseEnter="ReportCard_MouseEnter" MouseLeave="ReportCard_MouseLeave"
                                BorderThickness="1" CornerRadius="8" Padding="12,10"
                                Cursor="Hand" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="BasicBestABRIcon" Width="32" Height="32"
                                        CornerRadius="6" Margin="0,0,10,0">
                                    <Path Data="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z"
                                          Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Static res:Strings.PrintDialog_BestAbrTest}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="BasicSelectedTests" Tag="Basic|SelectedTests"
                                MouseLeftButtonDown="ReportCard_Click"
                                MouseEnter="ReportCard_MouseEnter" MouseLeave="ReportCard_MouseLeave"
                                BorderThickness="1" CornerRadius="8" Padding="12,10"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="BasicSelectedTestsIcon" Width="32" Height="32"
                                        CornerRadius="6" Margin="0,0,10,0">
                                    <Path Data="M20 3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM10 17l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                                          Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Static res:Strings.PrintDialog_SelectedTests}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Detail reports — same five report types, same icons -->
                    <StackPanel Grid.Column="2">
                        <Border BorderThickness="0,0,0,2" BorderBrush="{StaticResource LightBlueBrush}"
                                Padding="0,0,0,6" Margin="0,0,0,8">
                            <TextBlock Text="{x:Static res:Strings.PrintDialog_DetailReports}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>
                        </Border>

                        <Border x:Name="DetailBestTests" Tag="Detail|BestTests"
                                MouseLeftButtonDown="ReportCard_Click"
                                MouseEnter="ReportCard_MouseEnter" MouseLeave="ReportCard_MouseLeave"
                                BorderThickness="1" CornerRadius="8" Padding="12,10"
                                Cursor="Hand" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="DetailBestTestsIcon" Width="32" Height="32"
                                        CornerRadius="6" Margin="0,0,10,0">
                                    <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"
                                          Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Static res:Strings.PrintDialog_BestTests}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="DetailBestTEOAE" Tag="Detail|BestTEOAE"
                                MouseLeftButtonDown="ReportCard_Click"
                                MouseEnter="ReportCard_MouseEnter" MouseLeave="ReportCard_MouseLeave"
                                BorderThickness="1" CornerRadius="8" Padding="12,10"
                                Cursor="Hand" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="DetailBestTEOAEIcon" Width="32" Height="32"
                                        CornerRadius="6" Margin="0,0,10,0">
                                    <Path Data="M7 18h2V6H7v12zm4 4h2V2h-2v20zm-8-8h2v-4H3v4zm12 4h2V6h-2v12zm4-8v4h2v-4h-2z"
                                          Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Static res:Strings.PrintDialog_BestTeoaeTest}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="DetailBestDPOAE" Tag="Detail|BestDPOAE"
                                MouseLeftButtonDown="ReportCard_Click"
                                MouseEnter="ReportCard_MouseEnter" MouseLeave="ReportCard_MouseLeave"
                                BorderThickness="1" CornerRadius="8" Padding="12,10"
                                Cursor="Hand" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="DetailBestDPOAEIcon" Width="32" Height="32"
                                        CornerRadius="6" Margin="0,0,10,0">
                                    <Path Data="M5 9.2h3V19H5V9.2zM10.6 5h2.8v14h-2.8V5zm5.6 8H19v6h-2.8v-6z"
                                          Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Static res:Strings.PrintDialog_BestDpoaeTest}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="DetailBestABR" Tag="Detail|BestABR"
                                MouseLeftButtonDown="ReportCard_Click"
                                MouseEnter="ReportCard_MouseEnter" MouseLeave="ReportCard_MouseLeave"
                                BorderThickness="1" CornerRadius="8" Padding="12,10"
                                Cursor="Hand" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="DetailBestABRIcon" Width="32" Height="32"
                                        CornerRadius="6" Margin="0,0,10,0">
                                    <Path Data="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z"
                                          Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Static res:Strings.PrintDialog_BestAbrTest}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="DetailSelectedTests" Tag="Detail|SelectedTests"
                                MouseLeftButtonDown="ReportCard_Click"
                                MouseEnter="ReportCard_MouseEnter" MouseLeave="ReportCard_MouseLeave"
                                BorderThickness="1" CornerRadius="8" Padding="12,10"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="DetailSelectedTestsIcon" Width="32" Height="32"
                                        CornerRadius="6" Margin="0,0,10,0">
                                    <Path Data="M20 3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM10 17l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                                          Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Static res:Strings.PrintDialog_SelectedTests}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Background="{StaticResource BgFooterBrush}" Padding="24,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="CancelButton_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CancelBorder" Background="White"
                                            BorderBrush="{StaticResource ButtonBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="24,10">
                                        <TextBlock Text="{x:Static res:Strings.PrintDialog_Cancel}" FontSize="14" FontWeight="Medium"
                                                   Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CancelBorder" Property="Background"
                                                    Value="{StaticResource BgLighterBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="PrintButton_Click" Cursor="Hand" Margin="10,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="PrintBorder" Background="{StaticResource PurpleBrush}"
                                            CornerRadius="6" Padding="24,10">
                                        <TextBlock Text="{x:Static res:Strings.PrintDialog_Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" FontFamily="Segoe UI"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PrintBorder" Property="Background"
                                                    Value="{StaticResource PurpleHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>