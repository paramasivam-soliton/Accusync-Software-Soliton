<Window x:Class="AccuSync.WPF.Views.PatientsTests.Dialogs.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AccuSync.WPF.Resources"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- TODO: Same brush duplication as FirmwareUpdateDialog and ImportFileDialog.
             Merge from a shared dialog resource dictionary. -->
        <SolidColorBrush x:Key="PurpleBrush" Color="#473089"/>
        <SolidColorBrush x:Key="PurpleHoverBrush" Color="#5A3DA8"/>
        <SolidColorBrush x:Key="LightBlueBrush" Color="#D4E9F9"/>
        <SolidColorBrush x:Key="BrightBlueBrush" Color="#005FBE"/>
        <SolidColorBrush x:Key="MidnightBrush" Color="#002856"/>
        <SolidColorBrush x:Key="TextBrush" Color="#5C5149"/>
        <SolidColorBrush x:Key="GrayBrush" Color="#9EA2AC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#e5e7eb"/>
        <SolidColorBrush x:Key="BgLightBrush" Color="#f8f9fa"/>
        <SolidColorBrush x:Key="BgLighterBrush" Color="#f3f4f6"/>
        <SolidColorBrush x:Key="BgFooterBrush" Color="#f9fafb"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#d1d5db"/>
    </Window.Resources>

    <!-- Outer margin provides space for the drop shadow -->
    <Border Margin="20" CornerRadius="12" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="0" Color="#000000"/>
        </Border.Effect>

        <Border CornerRadius="12" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header — draggable -->
                <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,20,24,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static res:Strings.ExportDialog_Title}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="CloseButton" Click="CloseButton_Click"
                                    Width="32" Height="32" Cursor="Hand"
                                    VerticalAlignment="Center" ToolTip="{x:Static res:Strings.ExportDialog_Close}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseBorder" Background="{StaticResource BgLighterBrush}"
                                                CornerRadius="6" Width="32" Height="32">
                                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                  Fill="{StaticResource TextBrush}" Width="18" Height="18"
                                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseBorder" Property="Background" Value="{StaticResource BorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                    <StackPanel Margin="24,20,24,24">

                        <TextBlock Text="{x:Static res:Strings.ExportDialog_ExportFormat}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="FormatComboBox" Height="40" FontSize="14" Padding="10,0"
                                  FontFamily="Segoe UI" SelectedIndex="0"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="{x:Static res:Strings.ExportDialog_FormatAccuSyncJson}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.ExportDialog_FormatAccuSyncXml}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.ExportDialog_FormatHiTrack}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.ExportDialog_FormatOz}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.ExportDialog_FormatCsv}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.ExportDialog_FormatAlgo5Xml}"/>
                        </ComboBox>

                        <TextBlock Text="{x:Static res:Strings.ExportDialog_Patients}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,20,0,6"/>

                        <!-- Scope cards — only one can be active at a time.
                             Selection logic is in code-behind (SelectScope). -->
                        <StackPanel x:Name="ScopeCardsPanel">

                            <!-- TODO: All four scope cards share the same layout
                                 (icon border + title text). Extract a reusable
                                 DataTemplate or UserControl to reduce duplication. -->

                            <Border x:Name="NewResultsCard" BorderThickness="1" CornerRadius="8"
                                    Padding="14,12" Cursor="Hand" Margin="0,0,0,6"
                                    MouseLeftButtonDown="NewResultsCard_Click"
                                    MouseEnter="ScopeCard_MouseEnter" MouseLeave="ScopeCard_MouseLeave">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="NewResultsIconBorder" Width="36" Height="36"
                                            CornerRadius="6" VerticalAlignment="Top" Margin="0,0,12,0">
                                        <Path Data="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12zM6 10h2v2H6v-2zm0 4h8v2H6v-2zm10 0h2v2h-2v-2zm-6-4h8v2h-8v-2z"
                                              Fill="{StaticResource BrightBlueBrush}" Width="18" Height="18"
                                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static res:Strings.ExportDialog_PatientsWithNewResults}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{StaticResource MidnightBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="AllPatientsCard" BorderThickness="1" CornerRadius="8"
                                    Padding="14,12" Cursor="Hand" Margin="0,0,0,6"
                                    MouseLeftButtonDown="AllPatientsCard_Click"
                                    MouseEnter="ScopeCard_MouseEnter" MouseLeave="ScopeCard_MouseLeave">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="AllPatientsIconBorder" Width="36" Height="36"
                                            CornerRadius="6" VerticalAlignment="Top" Margin="0,0,12,0">
                                        <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                              Fill="{StaticResource BrightBlueBrush}" Width="18" Height="18"
                                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static res:Strings.ExportDialog_AllPatients}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{StaticResource MidnightBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="DateRangeCard" BorderThickness="1" CornerRadius="8"
                                    Padding="14,12" Cursor="Hand" Margin="0,0,0,6"
                                    MouseLeftButtonDown="DateRangeCard_Click"
                                    MouseEnter="ScopeCard_MouseEnter" MouseLeave="ScopeCard_MouseLeave">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="DateRangeIconBorder" Width="36" Height="36"
                                            CornerRadius="6" VerticalAlignment="Top" Margin="0,0,12,0">
                                        <Path Data="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"
                                              Fill="{StaticResource BrightBlueBrush}" Width="18" Height="18"
                                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static res:Strings.ExportDialog_ByDateRange}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{StaticResource MidnightBrush}"/>

                                        <!-- Date pickers — shown only when this card is selected -->
                                        <Border x:Name="DateRangePanel" Visibility="Collapsed"
                                                Background="{StaticResource BgFooterBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,10,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{x:Static res:Strings.ExportDialog_From}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                                    <DatePicker x:Name="FromDatePicker" Height="36" FontSize="13"
                                                                FontFamily="Segoe UI"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{x:Static res:Strings.ExportDialog_To}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                                    <DatePicker x:Name="ToDatePicker" Height="36" FontSize="13"
                                                                FontFamily="Segoe UI"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="SelectedPatientsCard" BorderThickness="1" CornerRadius="8"
                                    Padding="14,12" Cursor="Hand"
                                    MouseLeftButtonDown="SelectedPatientsCard_Click"
                                    MouseEnter="ScopeCard_MouseEnter" MouseLeave="ScopeCard_MouseLeave">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SelectedPatientsIconBorder" Width="36" Height="36"
                                            CornerRadius="6" VerticalAlignment="Top" Margin="0,0,12,0">
                                        <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM17.99 9l-1.41-1.42-6.59 6.59-2.58-2.57-1.42 1.41 4 3.99z"
                                              Fill="{StaticResource BrightBlueBrush}" Width="18" Height="18"
                                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static res:Strings.ExportDialog_SelectedPatients}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{StaticResource MidnightBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- De-identification option -->
                        <Border Background="{StaticResource BgLightBrush}" CornerRadius="6"
                                Padding="16,12" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="DeidentifyCheckBox" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static res:Strings.ExportDialog_DeidentifyPatientRecords}" FontSize="13"
                                           Foreground="{StaticResource TextBrush}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Cursor="Hand"
                                           MouseLeftButtonDown="DeidentifyLabel_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Background="{StaticResource BgFooterBrush}" Padding="24,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                        <Button x:Name="CancelButton" Click="CancelButton_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CancelBorder" Background="White"
                                            BorderBrush="{StaticResource ButtonBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="24,10">
                                        <TextBlock Text="{x:Static res:Strings.ExportDialog_Cancel}" FontSize="14" FontWeight="Medium"
                                                   Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CancelBorder" Property="Background"
                                                    Value="{StaticResource BgLighterBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="ExportButton" Click="ExportButton_Click" Cursor="Hand" Margin="10,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ExportBorder" Background="{StaticResource PurpleBrush}"
                                            CornerRadius="6" Padding="24,10">
                                        <TextBlock Text="{x:Static res:Strings.ExportDialog_Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" FontFamily="Segoe UI"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ExportBorder" Property="Background"
                                                    Value="{StaticResource PurpleHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>