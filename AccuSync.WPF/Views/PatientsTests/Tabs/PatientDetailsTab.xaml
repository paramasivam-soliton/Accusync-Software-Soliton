<UserControl x:Class="AccuSync.WPF.Views.PatientsTests.Tabs.PatientDetailsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AccuSync.WPF.Resources"
             xmlns:helpers="clr-namespace:AccuSync.Application.Helpers;assembly=AccuSync.Application">

    <!-- PatientDetailsTab.xaml
         Tab 1 of PatientInformationView: demographics form + comments.
         Styles from PatientInformationStyles.xaml (merged in App.xaml). -->

    <StackPanel>

        <!-- Patient Information -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,16">
                    <TextBlock Text="{x:Static res:Strings.PatientDetailsTab_PatientInformation}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
                </Border>

                <!-- TODO: Each form row (label + input + clear button + optional copy/today button)
                     repeats the same XAML structure. A DataTemplate or custom FormField UserControl
                     would reduce the ~300 lines of repetitive markup. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Patient ID (required, with copy button) -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock FontSize="13" FontWeight="Medium" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6">
                            <Run Text="{x:Static res:Strings.PatientDetailsTab_PatientId}"/><Run Text="*" Foreground="#dc3545"/>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="PatientIdTextBox" Text="{Binding PatientId, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" Style="{StaticResource ValidatedTextBox}" Padding="8,8,32,8"/>
                                <Button Style="{StaticResource InnerClearButton}" HorizontalAlignment="Right" Margin="0,0,4,0" Click="ClearPatientId_Click" ToolTip="{x:Static res:Strings.PatientDetailsTab_ClearField}" Visibility="{Binding PatientId, Converter={StaticResource StringToVisibilityConverter}}"/>
                            </Grid>
                            <Button Grid.Column="1" Content="📋" Margin="4,0,0,0" Padding="8,6" Background="#f0f0f0" BorderBrush="#ddd" BorderThickness="1" Cursor="Hand" FontSize="12" Click="CopyPatientId_Click" ToolTip="{x:Static res:Strings.PatientDetailsTab_CopyToClipboard}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Hospital ID (required, with copy button) -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock FontSize="13" FontWeight="Medium" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6">
                            <Run Text="{x:Static res:Strings.PatientDetailsTab_HospitalId}"/><Run Text="*" Foreground="#dc3545"/>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="HospitalIdTextBox" Text="{Binding HospitalId, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" Style="{StaticResource ValidatedTextBox}" Padding="8,8,32,8"/>
                                <Button Style="{StaticResource InnerClearButton}" HorizontalAlignment="Right" Margin="0,0,4,0" Click="ClearHospitalId_Click" ToolTip="{x:Static res:Strings.PatientDetailsTab_ClearField}" Visibility="{Binding HospitalId, Converter={StaticResource StringToVisibilityConverter}}"/>
                            </Grid>
                            <Button Grid.Column="1" Content="📋" Margin="4,0,0,0" Padding="8,6" Background="#f0f0f0" BorderBrush="#ddd" BorderThickness="1" Cursor="Hand" FontSize="12" Click="CopyHospitalId_Click" ToolTip="{x:Static res:Strings.PatientDetailsTab_CopyToClipboard}"/>
                        </Grid>
                    </StackPanel>

                    <!-- First Name, Last Name (required) -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock Text="{x:Static res:Strings.PatientDetailsTab_FirstName}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" Padding="8,8,32,8"/>
                            <Button Style="{StaticResource InnerClearButton}" HorizontalAlignment="Right" Margin="0,0,4,0" Click="ClearFirstName_Click" ToolTip="{x:Static res:Strings.PatientDetailsTab_ClearField}" Visibility="{Binding FirstName, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock FontSize="13" FontWeight="Medium" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6">
                            <Run Text="{x:Static res:Strings.PatientDetailsTab_LastName}"/><Run Text="*" Foreground="#dc3545"/>
                        </TextBlock>
                        <Grid>
                            <TextBox x:Name="LastNameTextBox" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" Style="{StaticResource ValidatedTextBox}" Padding="8,8,32,8"/>
                            <Button Style="{StaticResource InnerClearButton}" HorizontalAlignment="Right" Margin="0,0,4,0" Click="ClearLastName_Click" ToolTip="{x:Static res:Strings.PatientDetailsTab_ClearField}" Visibility="{Binding LastName, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Date of Birth (with Today button), Gender -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock Text="{x:Static res:Strings.PatientDetailsTab_DateOfBirth}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="DateOfBirthPicker" Grid.Column="0" SelectedDate="{Binding DateOfBirth, UpdateSourceTrigger=PropertyChanged}" BorderBrush="#dddddd" BorderThickness="1" Padding="8,8" FontSize="14"/>
                            <Button Grid.Column="1" Content="{x:Static res:Strings.PatientDetailsTab_Today}" Margin="4,0,0,0" Padding="8,6" Background="#f0f0f0" BorderBrush="#ddd" BorderThickness="1" Cursor="Hand" FontSize="12" Click="SetTodayDateOfBirth_Click" ToolTip="{x:Static res:Strings.PatientDetailsTab_SetToTodaysDate}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock Text="{x:Static res:Strings.PatientDetailsTab_Gender}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6"/>
                        <ComboBox SelectedValue="{Binding Gender}" Style="{StaticResource FieldComboBox}">
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Male}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Female}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Other}"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Gestational Age, Weight -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock Text="{x:Static res:Strings.PatientDetailsTab_GestationalAgeWeeks}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6"/>
                        <ComboBox SelectedValue="{Binding GestationalAge}" Style="{StaticResource FieldComboBox}"
                                  ItemsSource="{x:Static helpers:ClinicalOptions.GestationalAgeWeeks}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock Text="{x:Static res:Strings.PatientDetailsTab_WeightGrams}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <TextBox Text="{Binding Weight}" Style="{StaticResource FieldTextBox}" Padding="8,8,32,8"/>
                            <Button Style="{StaticResource InnerClearButton}" HorizontalAlignment="Right" Margin="0,0,4,0" Click="ClearWeight_Click" ToolTip="{x:Static res:Strings.PatientDetailsTab_ClearField}" Visibility="{Binding Weight, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Height, Birth Location -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock Text="{x:Static res:Strings.PatientDetailsTab_HeightCm}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <TextBox Text="{Binding Height}" Style="{StaticResource FieldTextBox}" Padding="8,8,32,8"/>
                            <Button Style="{StaticResource InnerClearButton}" HorizontalAlignment="Right" Margin="0,0,4,0" Click="ClearHeight_Click" ToolTip="{x:Static res:Strings.PatientDetailsTab_ClearField}" Visibility="{Binding Height, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock Text="{x:Static res:Strings.PatientDetailsTab_BirthLocation}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6"/>
                        <ComboBox SelectedValue="{Binding BirthLocation}" Style="{StaticResource FieldComboBox}">
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Hospital}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Home}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_BirthCenter}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Other}"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Nationality, Screening Consent -->
                    <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock Text="{x:Static res:Strings.PatientDetailsTab_Nationality}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6"/>
                        <ComboBox SelectedValue="{Binding Nationality}" Style="{StaticResource FieldComboBox}">
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_American}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Canadian}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Mexican}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_British}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_German}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_French}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Italian}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Spanish}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Chinese}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Indian}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Japanese}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Korean}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Other}"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock Text="{x:Static res:Strings.PatientDetailsTab_ScreeningConsent}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6"/>
                        <ComboBox SelectedValue="{Binding ScreeningConsent}" Style="{StaticResource FieldComboBox}">
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Yes}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_No}"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Consent State, NICU -->
                    <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock Text="{x:Static res:Strings.PatientDetailsTab_ConsentState}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6"/>
                        <ComboBox SelectedValue="{Binding ConsentState}" Style="{StaticResource FieldComboBox}">
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_No}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Screening}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Full}"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock Text="{x:Static res:Strings.PatientDetailsTab_NICU}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6"/>
                        <ComboBox SelectedValue="{Binding NICU}" Style="{StaticResource FieldComboBox}">
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_No}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_Yes}"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Discharged (with Today button), Deceased (with Today button) -->
                    <StackPanel Grid.Row="7" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock Text="{x:Static res:Strings.PatientDetailsTab_Discharged}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0" SelectedDate="{Binding Discharged}" BorderBrush="#dddddd" BorderThickness="1" Padding="8,8" FontSize="14"/>
                            <Button Grid.Column="1" Content="{x:Static res:Strings.PatientDetailsTab_Today}" Margin="4,0,0,0" Padding="8,6" Background="#f0f0f0" BorderBrush="#ddd" BorderThickness="1" Cursor="Hand" FontSize="12" Click="SetTodayDischarged_Click" ToolTip="{x:Static res:Strings.PatientDetailsTab_SetToTodaysDate}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="7" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock Text="{x:Static res:Strings.PatientDetailsTab_Deceased}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0" SelectedDate="{Binding Deceased}" BorderBrush="#dddddd" BorderThickness="1" Padding="8,8" FontSize="14"/>
                            <Button Grid.Column="1" Content="{x:Static res:Strings.PatientDetailsTab_Today}" Margin="4,0,0,0" Padding="8,6" Background="#f0f0f0" BorderBrush="#ddd" BorderThickness="1" Cursor="Hand" FontSize="12" Click="SetTodayDeceased_Click" ToolTip="{x:Static res:Strings.PatientDetailsTab_SetToTodaysDate}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Tracking Consent -->
                    <StackPanel Grid.Row="8" Grid.Column="0" Margin="0,0,0,0">
                        <TextBlock Text="{x:Static res:Strings.PatientDetailsTab_TrackingConsent}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6"/>
                        <ComboBox SelectedValue="{Binding TrackingConsent}" Style="{StaticResource FieldComboBox}">
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_NoTracking}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_SimpleTracking}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PatientDetailsTab_FullTracking}"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Comments -->
        <Border x:Name="CommentsSection" Style="{StaticResource SectionCard}">
            <StackPanel>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,16">
                    <TextBlock Text="{x:Static res:Strings.PatientDetailsTab_Comments}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
                </Border>
                <TextBox x:Name="CommentsTextBox" Text="{Binding Comments, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="150" MaxHeight="300" MaxLength="1000"
                         VerticalScrollBarVisibility="Auto" TextChanged="CommentsTextBox_TextChanged"/>
                <Grid Margin="0,8,0,0">
                    <TextBlock Text="{x:Static res:Strings.PatientDetailsTab_AddNotesHint}" FontSize="12" Foreground="{StaticResource GrayBrush}" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="CommentsCharCounter" Text="{x:Static res:Strings.PatientDetailsTab_CharCounterDefault}" FontSize="12" Foreground="{StaticResource GrayBrush}" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>