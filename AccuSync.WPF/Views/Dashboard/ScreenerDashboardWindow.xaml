<Window x:Class="AccuSync.WPF.Views.Dashboard.ScreenerDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:patients="clr-namespace:AccuSync.WPF.Views.PatientsTests"
        xmlns:about="clr-namespace:AccuSync.WPF.Views.About"
        xmlns:local="clr-namespace:AccuSync.WPF.Views.Dashboard"
        xmlns:res="clr-namespace:AccuSync.WPF.Resources"
        Title="{x:Static res:Strings.ScreenerDashboardWindow_Title}"
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#D4E9F9">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- COL 0: Sidebar -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#473089" Offset="0"/>
                    <GradientStop Color="#6B4BA8" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="0,20,0,0">
                <StackPanel Margin="20,0,20,28" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static res:Strings.ScreenerDashboardWindow_AppName}" FontSize="22" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="NavDashboard" Background="#40FFFFFF"
                            Margin="15,0,15,10" Padding="12" CornerRadius="10" Cursor="Hand"
                            Visibility="Collapsed"
                            MouseEnter="NavItem_MouseEnter" MouseLeave="NavItem_MouseLeave"
                            MouseLeftButtonDown="NavDashboard_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                  Fill="White" Margin="0,0,10,0"
                                  Data="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ScreenerDashboardWindow_NavDashboard}" FontSize="14"
                                       FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border x:Name="NavPatients" Background="#1AFFFFFF"
                            Margin="15,0,15,10" Padding="12" CornerRadius="10" Cursor="Hand"
                            MouseEnter="NavItem_MouseEnter" MouseLeave="NavItem_MouseLeave"
                            MouseLeftButtonDown="NavPatients_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                  Fill="White" Margin="0,0,10,0"
                                  Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ScreenerDashboardWindow_NavPatients}" FontSize="14"
                                       FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border x:Name="NavAbout" Background="#1AFFFFFF"
                            Margin="15,0,15,10" Padding="12" CornerRadius="10" Cursor="Hand"
                            MouseEnter="NavItem_MouseEnter" MouseLeave="NavItem_MouseLeave"
                            MouseLeftButtonDown="NavAbout_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                  Fill="White" Margin="0,0,10,0"
                                  Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ScreenerDashboardWindow_NavAbout}" FontSize="14"
                                       FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border x:Name="NavSettings" Background="#1AFFFFFF"
                            Margin="15,0,15,10" Padding="12" CornerRadius="10" Cursor="Hand"
                            MouseEnter="NavItem_MouseEnter" MouseLeave="NavItem_MouseLeave"
                            MouseLeftButtonDown="NavSettings_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                  Fill="White" Margin="0,0,10,0"
                                  Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ScreenerDashboardWindow_NavSettings}" FontSize="14"
                                       FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Spacer -->
                <Border Height="20"/>

                <!-- Logout -->
                <Border Background="#26FFFFFF"
                            Margin="15,0,15,20" Padding="12" CornerRadius="10" Cursor="Hand"
                            MouseEnter="NavItem_MouseEnter" MouseLeave="NavItem_MouseLeave"
                            MouseLeftButtonDown="Logout_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                  Fill="White" Margin="0,0,10,0"
                                  Data="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>
                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ScreenerDashboardWindow_NavLogout}" FontSize="14"
                                       FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- COL 1: Main Content -->
        <Grid Grid.Column="1" Background="#D4E9F9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Hidden elements preserved for code-behind compatibility -->
            <TextBlock x:Name="HeaderTitle"   Visibility="Collapsed"/>
            <TextBlock x:Name="LastLoginText" Visibility="Collapsed"/>

            <!-- Row 0: Top divider -->
            <Border Grid.Row="0" Height="3" Background="#B8BCC5"/>

            <!-- Row 1: Greeting bar -->
            <Border Grid.Row="1" Background="#D4E9F9" Padding="24,12,24,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="GreetingText"
                               Text="☀️ Good Morning, Screener"
                               FontSize="18" FontWeight="SemiBold" Foreground="#002856"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DateText"
                               Text="Mar 5, 2026"
                               FontSize="13" Foreground="#9EA2AC" Margin="0,2,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Row 2: Bottom divider -->
            <Border Grid.Row="2" Height="3" Background="#B8BCC5" Margin="0,8,0,0"/>

            <!-- Row 3: Dashboard View -->
            <ScrollViewer x:Name="DashboardView" Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Visible">
                <Border Margin="20" MaxWidth="1100" Background="White" CornerRadius="15" ClipToBounds="True" HorizontalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2"
                                          BlurRadius="15" Opacity="0.12"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Dark panel header -->
                        <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#3A3A3C" Offset="0"/>
                                    <GradientStop Color="#202124" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <Path Width="17" Height="17" Stretch="Uniform" Fill="White" Margin="0,0,10,0"
                                      Data="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
                                <TextBlock Text="{x:Static res:Strings.ScreenerDashboardWindow_PanelHeader}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <!-- Panel body -->
                        <StackPanel Grid.Row="1" Margin="28">

                            <!-- ROW 1: Overview + Quick Actions -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Today's Overview -->
                                <StackPanel Grid.Column="0">
                                    <Border Margin="0,0,0,16" BorderBrush="#D4E9F9"
                                            BorderThickness="0,0,0,2" Padding="0,0,0,8">
                                        <TextBlock Text="{x:Static res:Strings.ScreenerDashboardWindow_TodaysOverview}" FontSize="14"
                                                   FontWeight="Bold" Foreground="#002856"/>
                                    </Border>
                                    <UniformGrid Columns="3" Rows="2">

                                        <!-- Assigned Today -->
                                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                                CornerRadius="10" Padding="16" Margin="0,0,6,12" Cursor="Hand"
                                                Tag="AssignedToday"
                                                MouseLeftButtonDown="StatCard_Click"
                                                MouseEnter="ActionCard_MouseEnter"
                                                MouseLeave="ActionCard_MouseLeave">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="44" Height="44" CornerRadius="12" Background="#428FEC"
                                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <Path Width="22" Height="22" Stretch="Uniform" Fill="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1z"/>
                                                </Border>
                                                <TextBlock Text="{x:Static res:Strings.ScreenerDashboardWindow_StatAssignedToday}" FontSize="11" FontWeight="Medium"
                                                           Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                <TextBlock x:Name="AssignedTodayValue" Text="5" FontSize="24"
                                                           FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Completed -->
                                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                                CornerRadius="10" Padding="16" Margin="6,0,6,12" Cursor="Hand"
                                                Tag="Completed"
                                                MouseLeftButtonDown="StatCard_Click"
                                                MouseEnter="ActionCard_MouseEnter"
                                                MouseLeave="ActionCard_MouseLeave">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="44" Height="44" CornerRadius="12" Background="#00AAA7"
                                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <Path Width="22" Height="22" Stretch="Uniform" Fill="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                                </Border>
                                                <TextBlock Text="{x:Static res:Strings.ScreenerDashboardWindow_StatCompleted}" FontSize="11" FontWeight="Medium"
                                                           Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                <TextBlock x:Name="CompletedValue" Text="3" FontSize="24"
                                                           FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Pending -->
                                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                                CornerRadius="10" Padding="16" Margin="6,0,0,12" Cursor="Hand"
                                                Tag="Pending"
                                                MouseLeftButtonDown="StatCard_Click"
                                                MouseEnter="ActionCard_MouseEnter"
                                                MouseLeave="ActionCard_MouseLeave">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="44" Height="44" CornerRadius="12" Background="#005FBE"
                                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <Path Width="22" Height="22" Stretch="Uniform" Fill="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/>
                                                </Border>
                                                <TextBlock Text="{x:Static res:Strings.ScreenerDashboardWindow_StatPending}" FontSize="11" FontWeight="Medium"
                                                           Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                <TextBlock x:Name="PendingValue" Text="2" FontSize="24"
                                                           FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Not Exported -->
                                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                                CornerRadius="10" Padding="16" Margin="0,0,6,0" Cursor="Hand"
                                                Tag="NotExported"
                                                MouseLeftButtonDown="StatCard_Click"
                                                MouseEnter="ActionCard_MouseEnter"
                                                MouseLeave="ActionCard_MouseLeave">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="44" Height="44" CornerRadius="12" Background="#9EA2AC"
                                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <Path Width="22" Height="22" Stretch="Uniform" Fill="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M9 16h6v-6h4l-7-7-7 7h4zm-4 2h14v2H5z"/>
                                                </Border>
                                                <TextBlock Text="{x:Static res:Strings.ScreenerDashboardWindow_StatNotExported}" FontSize="11" FontWeight="Medium"
                                                           Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                <TextBlock x:Name="NotExportedValue" Text="1" FontSize="24"
                                                           FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Referred (7D) -->
                                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                                CornerRadius="10" Padding="16" Margin="6,0,6,0" Cursor="Hand"
                                                Tag="Referred"
                                                MouseLeftButtonDown="StatCard_Click"
                                                MouseEnter="ActionCard_MouseEnter"
                                                MouseLeave="ActionCard_MouseLeave">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="44" Height="44" CornerRadius="12" Background="#002856"
                                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <Path Width="22" Height="22" Stretch="Uniform" Fill="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/>
                                                </Border>
                                                <TextBlock Text="{x:Static res:Strings.ScreenerDashboardWindow_StatReferred7D}" FontSize="11" FontWeight="Medium"
                                                           Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                <TextBlock x:Name="ReferredValue" Text="4" FontSize="24"
                                                           FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Pass (7D) -->
                                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                                CornerRadius="10" Padding="16" Margin="6,0,0,0" Cursor="Hand"
                                                Tag="Pass"
                                                MouseLeftButtonDown="StatCard_Click"
                                                MouseEnter="ActionCard_MouseEnter"
                                                MouseLeave="ActionCard_MouseLeave">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="44" Height="44" CornerRadius="12" Background="#008B96"
                                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <Path Width="22" Height="22" Stretch="Uniform" Fill="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                                </Border>
                                                <TextBlock Text="{x:Static res:Strings.ScreenerDashboardWindow_StatPass7D}" FontSize="11" FontWeight="Medium"
                                                           Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                <TextBlock x:Name="PassValue" Text="9" FontSize="24"
                                                           FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                    </UniformGrid>
                                </StackPanel>

                                <!-- Quick Actions -->
                                <StackPanel Grid.Column="2">
                                    <Border Margin="0,0,0,16" BorderBrush="#D4E9F9"
                                            BorderThickness="0,0,0,2" Padding="0,0,0,8">
                                        <TextBlock Text="{x:Static res:Strings.ScreenerDashboardWindow_QuickActions}" FontSize="14"
                                                   FontWeight="Bold" Foreground="#002856"/>
                                    </Border>
                                    <UniformGrid Columns="3" Rows="2">

                                        <!-- Add Patient -->
                                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                                CornerRadius="10" Padding="20,16" Margin="0,0,6,12" Cursor="Hand"
                                                Tag="AddPatient"
                                                MouseLeftButtonDown="QuickAction_Click"
                                                MouseEnter="ActionCard_MouseEnter"
                                                MouseLeave="ActionCard_MouseLeave">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="48" Height="48" CornerRadius="12" Background="#00AAA7"
                                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <Path Width="22" Height="22" Stretch="Uniform" Fill="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                                                </Border>
                                                <TextBlock Text="{x:Static res:Strings.ScreenerDashboardWindow_ActionAddPatient}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#111827" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Import -->
                                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                                CornerRadius="10" Padding="20,16" Margin="6,0,6,12" Cursor="Hand"
                                                Tag="Import"
                                                MouseLeftButtonDown="QuickAction_Click"
                                                MouseEnter="ActionCard_MouseEnter"
                                                MouseLeave="ActionCard_MouseLeave">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="48" Height="48" CornerRadius="12" Background="#428FEC"
                                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <Path Width="22" Height="22" Stretch="Uniform" Fill="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                                                </Border>
                                                <TextBlock Text="{x:Static res:Strings.ScreenerDashboardWindow_ActionImport}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#111827" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Export -->
                                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                                CornerRadius="10" Padding="20,16" Margin="6,0,0,12" Cursor="Hand"
                                                Tag="Export"
                                                MouseLeftButtonDown="QuickAction_Click"
                                                MouseEnter="ActionCard_MouseEnter"
                                                MouseLeave="ActionCard_MouseLeave">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="48" Height="48" CornerRadius="12" Background="#9EA2AC"
                                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <Path Width="22" Height="22" Stretch="Uniform" Fill="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M9 16h6v-6h4l-7-7-7 7h4zm-4 2h14v2H5z"/>
                                                </Border>
                                                <TextBlock Text="{x:Static res:Strings.ScreenerDashboardWindow_ActionExport}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#111827" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Reports -->
                                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                                CornerRadius="10" Padding="20,16" Margin="0,0,6,0" Cursor="Hand"
                                                Tag="Reports"
                                                MouseLeftButtonDown="QuickAction_Click"
                                                MouseEnter="ActionCard_MouseEnter"
                                                MouseLeave="ActionCard_MouseLeave">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="48" Height="48" CornerRadius="12" Background="#005FBE"
                                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <Path Width="22" Height="22" Stretch="Uniform" Fill="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                                                </Border>
                                                <TextBlock Text="{x:Static res:Strings.ScreenerDashboardWindow_ActionReports}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#111827" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- My Patients -->
                                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                                CornerRadius="10" Padding="20,16" Margin="6,0,6,0" Cursor="Hand"
                                                Tag="MyPatients"
                                                MouseLeftButtonDown="QuickAction_Click"
                                                MouseEnter="ActionCard_MouseEnter"
                                                MouseLeave="ActionCard_MouseLeave">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="48" Height="48" CornerRadius="12" Background="#473089"
                                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <Path Width="22" Height="22" Stretch="Uniform" Fill="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                                </Border>
                                                <TextBlock Text="{x:Static res:Strings.ScreenerDashboardWindow_ActionMyPatients}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#111827" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Empty 6th cell -->
                                        <Border/>

