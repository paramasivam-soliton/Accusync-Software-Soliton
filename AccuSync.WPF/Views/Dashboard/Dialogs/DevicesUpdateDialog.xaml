<!-- TODO: Brush keys duplicate ImportWorkspace and other dialogs. Move to shared resource dictionary. -->
<!-- TODO: Search bar, close button template, and purple footer button are the same as other dialogs. Extract shared styles. -->
<Window x:Class="AccuSync.WPF.Views.Dashboard.Dialogs.DevicesUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AccuSync.WPF.Resources"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="PurpleBrush" Color="#473089"/>
        <SolidColorBrush x:Key="PurpleHoverBrush" Color="#5A3DA8"/>
        <SolidColorBrush x:Key="LightBlueBrush" Color="#D4E9F9"/>
        <SolidColorBrush x:Key="BrightBlueBrush" Color="#005FBE"/>
        <SolidColorBrush x:Key="MidnightBrush" Color="#002856"/>
        <SolidColorBrush x:Key="DarkTealBrush" Color="#008B96"/>
        <SolidColorBrush x:Key="TextBrush" Color="#5C5149"/>
        <SolidColorBrush x:Key="GrayBrush" Color="#9EA2AC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#e5e7eb"/>
        <SolidColorBrush x:Key="BgLighterBrush" Color="#f3f4f6"/>
        <SolidColorBrush x:Key="BgFooterBrush" Color="#f9fafb"/>
    </Window.Resources>

    <Border Margin="20" CornerRadius="12" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="0" Color="#000000"/>
        </Border.Effect>

        <Border CornerRadius="12" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="24,20,24,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"
                                  Fill="{StaticResource PurpleBrush}" Width="22" Height="22"
                                  Stretch="Uniform" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{x:Static res:Strings.DevicesUpdateDialog_Title}" FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}"/>
                                <TextBlock Text="{x:Static res:Strings.DevicesUpdateDialog_UpdatesAvailable}" FontSize="12"
                                           Foreground="{StaticResource GrayBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border x:Name="CountBadge" Grid.Column="2"
                                    Background="{StaticResource DarkTealBrush}"
                                    CornerRadius="12" Padding="12,5"
                                    VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="CountText" Text="{x:Static res:Strings.DevicesUpdateDialog_DeviceCount}"
                                           FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </Border>

                            <Button Grid.Column="3" Click="CloseButton_Click"
                                    Width="32" Height="32" Cursor="Hand"
                                    VerticalAlignment="Center" ToolTip="{x:Static res:Strings.DevicesUpdateDialog_Close}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseBorder"
                                                Background="{StaticResource BgLighterBrush}"
                                                CornerRadius="6" Width="32" Height="32">
                                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                  Fill="{StaticResource TextBrush}" Width="18" Height="18"
                                                  Stretch="Uniform" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseBorder" Property="Background"
                                                        Value="{StaticResource BorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Search Bar -->
                <Border Grid.Row="1" Padding="24,14,24,0">
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1.5" CornerRadius="8" Height="38" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform"
                                  Fill="#9CA3AF" Margin="0,0,10,0" VerticalAlignment="Center"
                                  Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalAlignment="Center" FontSize="13"
                                     Foreground="#111827" Text="{x:Static res:Strings.DevicesUpdateDialog_SearchPlaceholder}"
                                     GotFocus="SearchBox_GotFocus"
                                     LostFocus="SearchBox_LostFocus"
                                     TextChanged="SearchBox_TextChanged">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter Property="Foreground" Value="#111827"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>
                </Border>

                <!-- List / Empty State -->
                <Grid Grid.Row="2" MinHeight="200" MaxHeight="400">

                    <Border x:Name="EmptyView" Visibility="Collapsed" Padding="24">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,20,0,20">
                            <Border Width="64" Height="64" CornerRadius="32"
                                    Background="{StaticResource BgLighterBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Path Width="28" Height="28" Stretch="Uniform" Fill="#3A3A3C"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                            </Border>
                            <TextBlock Text="{x:Static res:Strings.DevicesUpdateDialog_AllUpToDate}" FontSize="16"
                                       FontWeight="SemiBold" Foreground="#2C3E50"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="{x:Static res:Strings.DevicesUpdateDialog_LatestVersion}"
                                       FontSize="13" Foreground="#6B7280"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="DeviceListView"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Visible">
                        <ItemsControl x:Name="DeviceListItems" Margin="24,14,24,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#E5E7EB"
                                            BorderThickness="1" CornerRadius="8"
                                            Padding="16,14" Margin="0,0,0,8"
                                            Cursor="Hand"
                                            MouseEnter="DeviceCard_MouseEnter"
                                            MouseLeave="DeviceCard_MouseLeave">
                                        <Grid>
                                            <Grid Margin="4,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="36" Height="36"
                                                        CornerRadius="8"
                                                        Background="{StaticResource LightBlueBrush}"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,14,0">
                                                    <Path Width="18" Height="18" Stretch="Uniform"
                                                          Fill="{StaticResource BrightBlueBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"/>
                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DeviceName}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="#111827"
                                                               Margin="0,0,0,4"/>
                                                    <TextBlock FontSize="11" Foreground="#6B7280">
                                                        <Run Text="{x:Static res:Strings.DevicesUpdateDialog_CurrentLabel}"/>
                                                        <Run Text="{Binding CurrentVersion}"
                                                             FontWeight="SemiBold"/>
                                                        <Run Text="{x:Static res:Strings.DevicesUpdateDialog_RequiredLabel}"/>
                                                        <Run Text="{Binding RequiredVersion}"
                                                             FontWeight="SemiBold"
                                                             Foreground="{StaticResource DarkTealBrush}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Button Grid.Column="2" Cursor="Hand"
                                                        VerticalAlignment="Center"
                                                        Tag="{Binding}"
                                                        Click="UpdateButton_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="UpdBorder"
                                                                    Background="{StaticResource PurpleBrush}"
                                                                    CornerRadius="6" Padding="16,8">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Path Width="14" Height="14"
                                                                          Stretch="Uniform" Fill="White"
                                                                          Margin="0,0,6,0"
                                                                          VerticalAlignment="Center"
                                                                          Data="M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L11 12.67V3h2z"/>
                                                                    <TextBlock Text="{x:Static res:Strings.DevicesUpdateDialog_Update}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="White"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="UpdBorder"
                                                                            Property="Background"
                                                                            Value="{StaticResource PurpleHoverBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Background="{StaticResource BgFooterBrush}" Padding="24,16">
                    <Button Click="CloseButton_Click" Cursor="Hand"
                            HorizontalAlignment="Right">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBtnBorder"
                                        Background="{StaticResource PurpleBrush}"
                                        CornerRadius="6" Padding="24,10">
                                    <TextBlock Text="{x:Static res:Strings.DevicesUpdateDialog_Close}" FontSize="14"
                                               FontWeight="SemiBold" Foreground="White"
                                               FontFamily="Segoe UI"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBtnBorder" Property="Background"
                                                Value="{StaticResource PurpleHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>