<Window x:Class="AccuSync.WPF.Views.Dashboard.Dialogs.PatientListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AccuSync.WPF.Resources"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="PurpleBrush" Color="#473089"/>
        <SolidColorBrush x:Key="PurpleHoverBrush" Color="#5A3DA8"/>
        <SolidColorBrush x:Key="LightBlueBrush" Color="#D4E9F9"/>
        <SolidColorBrush x:Key="BrightBlueBrush" Color="#005FBE"/>
        <SolidColorBrush x:Key="MidnightBrush" Color="#002856"/>
        <SolidColorBrush x:Key="TextBrush" Color="#5C5149"/>
        <SolidColorBrush x:Key="GrayBrush" Color="#9EA2AC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#e5e7eb"/>
        <SolidColorBrush x:Key="BgLighterBrush" Color="#f3f4f6"/>
        <SolidColorBrush x:Key="BgFooterBrush" Color="#f9fafb"/>
    </Window.Resources>

    <!-- Outer border: margin gives room for drop shadow -->
    <Border Margin="20" CornerRadius="12" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="0" Color="#000000"/>
        </Border.Effect>

        <!-- Inner border clips content to rounded corners -->
        <Border CornerRadius="12" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Search bar -->
                    <RowDefinition Height="*"/>
                    <!-- Patient list -->
                    <RowDefinition Height="Auto"/>
                    <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- ══════════════ HEADER ══════════════ -->
                <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="24,20,24,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon + Title -->
                            <Path Grid.Column="0"
                                  Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                  Fill="{StaticResource PurpleBrush}" Width="22" Height="22"
                                  Stretch="Uniform" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                      VerticalAlignment="Center">
                                <TextBlock x:Name="DialogTitle"
                                           Text="{x:Static res:Strings.PatientListDialog_Title}" FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MidnightBrush}"/>
                                <TextBlock x:Name="DialogSubtitle"
                                           Text="{x:Static res:Strings.PatientListDialog_Subtitle}" FontSize="12"
                                           Foreground="{StaticResource GrayBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Count badge -->
                            <Border x:Name="CountBadge" Grid.Column="2"
                                    CornerRadius="12" Padding="12,5"
                                    VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="CountText"
                                           FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </Border>

                            <!-- Close button -->
                            <Button Grid.Column="3" Click="CloseButton_Click"
                                    Width="32" Height="32" Cursor="Hand"
                                    VerticalAlignment="Center" ToolTip="{x:Static res:Strings.PatientListDialog_CloseToolTip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseBorder"
                                                Background="{StaticResource BgLighterBrush}"
                                                CornerRadius="6" Width="32" Height="32">
                                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                  Fill="{StaticResource TextBrush}" Width="18" Height="18"
                                                  Stretch="Uniform" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseBorder" Property="Background"
                                                        Value="{StaticResource BorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════════ SEARCH BAR ══════════════ -->
                <Border Grid.Row="1" Padding="24,14,24,0">
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1.5" CornerRadius="8" Height="38" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform"
                                  Fill="#9CA3AF" Margin="0,0,10,0" VerticalAlignment="Center"
                                  Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalAlignment="Center" FontSize="13"
                                     Foreground="#111827" Text="{x:Static res:Strings.PatientListDialog_SearchPlaceholder}"
                                     GotFocus="SearchBox_GotFocus"
                                     LostFocus="SearchBox_LostFocus"
                                     TextChanged="SearchBox_TextChanged">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter Property="Foreground" Value="#111827"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>
                </Border>

                <!-- ══════════════ PATIENT LIST / EMPTY STATE ══════════════ -->
                <Grid Grid.Row="2" MinHeight="200" MaxHeight="400">

                    <!-- Empty State -->
                    <Border x:Name="EmptyView" Visibility="Collapsed" Padding="24">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,20,0,20">
                            <Border Width="64" Height="64" CornerRadius="32"
                                    Background="{StaticResource BgLighterBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Path Width="28" Height="28" Stretch="Uniform" Fill="#3A3A3C"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                            </Border>
                            <TextBlock Text="{x:Static res:Strings.PatientListDialog_NoPatientsFound}" FontSize="16"
                                       FontWeight="SemiBold" Foreground="#2C3E50"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="{x:Static res:Strings.PatientListDialog_AdjustSearchHint}"
                                       FontSize="13" Foreground="#6B7280"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Patient List -->
                    <ScrollViewer x:Name="PatientListView"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Visible">
                        <ItemsControl x:Name="PatientListItems" Margin="24,14,24,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#E5E7EB"
                                            BorderThickness="1" CornerRadius="8"
                                            Padding="16,14" Margin="0,0,0,8"
                                            Cursor="Hand"
                                            MouseEnter="PatientCard_MouseEnter"
                                            MouseLeave="PatientCard_MouseLeave">
                                        <Grid>
                                            <Grid Margin="4,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Patient Info -->
                                                <StackPanel Grid.Column="0"
                                                            VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding MRN}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#111827"
                                                                   Margin="0,0,12,0"/>

                                                        <!-- Risk factor badges -->
                                                        <ItemsControl ItemsSource="{Binding RiskFactors}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{Binding Background}"
                                                                            CornerRadius="10"
                                                                            Padding="8,3"
                                                                            Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding Text}"
                                                                                   FontSize="10"
                                                                                   Foreground="{Binding Foreground}"
                                                                                   FontWeight="SemiBold"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <TextBlock FontSize="13" Foreground="#6B7280">
                                                        <Run Text="{Binding FirstName}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding LastName}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Right side: dates -->
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding DOB, StringFormat='DOB: {0:MM/dd/yyyy}'}"
                                                               FontSize="11" Foreground="#6B7280"
                                                               HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding LastScreenDate, StringFormat='Last screen: {0:MM/dd/yyyy}'}"
                                                               FontSize="10" Foreground="#9CA3AF"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ══════════════ FOOTER ══════════════ -->
                <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Background="{StaticResource BgFooterBrush}" Padding="24,16">
                    <Button Click="CloseButton_Click" Cursor="Hand"
                            HorizontalAlignment="Right">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBtnBorder"
                                        Background="{StaticResource PurpleBrush}"
                                        CornerRadius="6" Padding="24,10">
                                    <TextBlock Text="{x:Static res:Strings.PatientListDialog_CloseButton}" FontSize="14"
                                               FontWeight="SemiBold" Foreground="White"
                                               FontFamily="Segoe UI"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBtnBorder" Property="Background"
                                                Value="{StaticResource PurpleHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>