<!-- TODO: Search bar is a near-exact copy of AssignedPatientsDialog. Extract a shared SearchBar UserControl. -->
<!-- TODO: Filter and footer button templates reuse the same rounded-border pattern across multiple dialogs. Extract shared styles. -->
<Window x:Class="AccuSync.WPF.Views.Dashboard.Dialogs.AssignScreeningsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AccuSync.WPF.Resources"
        Title="{x:Static res:Strings.AssignScreeningsDialog_Title}"
        Height="750" 
        Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="25,20" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F8F9FA" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Width="32" Height="32"
                            Background="#E5E7EB"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BackButton_Click"
                            ToolTip="{x:Static res:Strings.AssignScreeningsDialog_BackTooltip}"
                            Margin="0,0,15,0"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="16">
                                                <Path Width="16" Height="16" 
                                                      Stretch="Uniform" 
                                                      Fill="#6B7280"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#D1D5DB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static res:Strings.AssignScreeningsDialog_AssignPatients}"
                                   FontSize="18"
                                   FontWeight="Bold" 
                                   Foreground="#2C3E50"/>
                        <TextBlock x:Name="SubtitleText"
                                   Text="{x:Static res:Strings.AssignScreeningsDialog_Subtitle}"
                                   FontSize="12" 
                                   Foreground="#6B7280"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border x:Name="SelectionBadge"
                            Grid.Column="2"
                            Background="#E0F2FE"
                            CornerRadius="15"
                            Padding="15,6"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="SelectionCountText"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#0369A1"/>
                    </Border>
                </Grid>

                <!-- Search and Filters -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1.5"
                            CornerRadius="18"
                            Height="36"
                            Padding="15,0"
                            Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Fill="#9CA3AF"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"
                                  Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>

                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalAlignment="Center"
                                     FontSize="13"
                                     Foreground="#111827"
                                     Text="{x:Static res:Strings.AssignScreeningsDialog_SearchPlaceholder}"
                                     GotFocus="SearchBox_GotFocus"
                                     LostFocus="SearchBox_LostFocus"
                                     TextChanged="SearchBox_TextChanged">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter Property="Foreground" Value="#111827"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>

                    <Button x:Name="HighPriorityButton"
                            Grid.Column="1"
                            Content="{x:Static res:Strings.AssignScreeningsDialog_HighPriority}"
                            Height="36"
                            Padding="15,0"
                            Background="#6B4BA8"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Margin="0,0,10,0"
                            Click="HighPriorityFilter_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="14"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="AllPatientsButton"
                            Grid.Column="2"
                            Content="{x:Static res:Strings.AssignScreeningsDialog_AllPatients}"
                            Height="36"
                            Padding="15,0"
                            Background="White"
                            Foreground="#6B7280"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1.5"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="AllPatientsFilter_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="14"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Patient List -->
        <!-- TODO: Card selection state is driven by computed model properties (CardBackground, CheckboxBackground, etc.).
             Verify the model raises PropertyChanged when toggled so bindings update. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
            <StackPanel>
                <TextBlock x:Name="PatientCountText"
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Foreground="#6B7280" 
                           Margin="10,0,10,15"/>

                <ItemsControl x:Name="PatientListItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding CardBackground}" 
                                    BorderBrush="{Binding CardBorder}"
                                    BorderThickness="{Binding CardBorderThickness}"
                                    CornerRadius="10" 
                                    Padding="20,15"
                                    Margin="0,0,0,10"
                                    MouseLeftButtonDown="PatientCard_Click"
                                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="24" Height="24"
                                            CornerRadius="4"
                                            Background="{Binding CheckboxBackground}"
                                            BorderBrush="{Binding CheckboxBorder}"
                                            BorderThickness="2"
                                            VerticalAlignment="Center"
                                            Margin="0,0,15,0">
                                        <Path x:Name="CheckMark"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              Stroke="White"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Visibility="{Binding CheckmarkVisibility}"
                                              Data="M20 6L9 17l-5-5"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#111827">
                                            <Run Text="{Binding MRN}"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding FirstName}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding LastName}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,2,0,0">
                                            <Run Text="{x:Static res:Strings.AssignScreeningsDialog_DobLabel}"/>
                                            <Run Text="{Binding DOB, StringFormat='{}{0:MM/dd/yyyy}'}"/>
                                            <Run Text="{x:Static res:Strings.AssignScreeningsDialog_WaitingLabel}"/>
                                            <Run Text="{Binding WaitTime}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Background="{Binding PriorityBackground}"
                                            CornerRadius="11"
                                            Padding="10,4"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding PriorityVisibility}">
                                        <TextBlock Text="{Binding PriorityText}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding PriorityForeground}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="20" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid>
                <Button Content="{x:Static res:Strings.AssignScreeningsDialog_Cancel}"
                        Width="100"
                        Height="36"
                        HorizontalAlignment="Left"
                        Background="White"
                        Foreground="#6B7280"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1.5"
                        FontSize="13"
                        FontWeight="Medium"
                        Cursor="Hand"
                        Click="CancelButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="20,8">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="AssignButton"
                        Width="200" 
                        Height="36"
                        HorizontalAlignment="Right"
                        Background="#6B4BA8"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Medium"
                        Cursor="Hand"
                        IsEnabled="False"
                        Click="AssignButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8"
                                                Padding="20,8">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Opacity" Value="0.5"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="True">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#5A3B8F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>