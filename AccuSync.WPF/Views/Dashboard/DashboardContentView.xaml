<!-- TODO: All dashboard numbers and the stats table are hardcoded placeholders. Wire to actual queries. -->
<UserControl x:Class="AccuSync.WPF.Views.Dashboard.DashboardContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AccuSync.WPF.Resources"
             Background="#D4E9F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Divider -->
        <Border Grid.Row="0" Height="3" Background="#B8BCC5"/>

        <!-- Greeting Bar -->
        <Border Grid.Row="1" Background="#D4E9F9" Padding="24,12,24,8">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="GreetingText"
                           Text="☀️ Good Morning, Admin"
                           FontSize="18" FontWeight="SemiBold" Foreground="#002856"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="DateText"
                           Text="Feb 17, 2026"
                           FontSize="13" Foreground="#9EA2AC" Margin="0,2,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Bottom Divider -->
        <Border Grid.Row="2" Height="3" Background="#B8BCC5" Margin="0,8,0,0"/>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border MaxWidth="1100" Margin="20"
                    Background="White" CornerRadius="15" ClipToBounds="True"
                    HorizontalAlignment="Stretch">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2"
                                      BlurRadius="15" Opacity="0.12"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel Header -->
                    <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="15">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3A3A3C" Offset="0"/>
                                <GradientStop Color="#202124" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform" Fill="White"
                                  Margin="0,0,10,0"
                                  Data="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
                            <TextBlock Text="{x:Static res:Strings.DashboardContentView_Dashboard}" FontSize="14" FontWeight="Bold"
                                       Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="28">

                        <!-- Overview and Quick Actions -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Overview -->
                            <StackPanel Grid.Column="0">
                                <Border Margin="0,0,0,16" BorderBrush="#D4E9F9"
                                        BorderThickness="0,0,0,2" Padding="0,0,0,8">
                                    <TextBlock Text="{x:Static res:Strings.DashboardContentView_Overview}" FontSize="14" FontWeight="Bold"
                                               Foreground="#002856"/>
                                </Border>

                                <ItemsControl x:Name="StatCardsItems">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" Rows="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#E0E0E0"
                                                    BorderThickness="1" CornerRadius="10"
                                                    Padding="16" Margin="{Binding CardMargin, Converter={StaticResource StringToThicknessConverter}}" Cursor="Hand"
                                                    Tag="{Binding Tag}"
                                                    MouseLeftButtonDown="StatCard_Click"
                                                    MouseEnter="ActionCard_MouseEnter"
                                                    MouseLeave="ActionCard_MouseLeave">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="44" Height="44" CornerRadius="12"
                                                            Background="{Binding IconBackground}"
                                                            HorizontalAlignment="Center" Margin="0,0,0,10">
                                                        <Path Width="22" Height="22" Stretch="Uniform"
                                                              Fill="White" HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Data="{Binding IconData}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}" FontSize="11"
                                                               FontWeight="Medium" Foreground="#9CA3AF"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding Value}" FontSize="24"
                                                               FontWeight="Bold" Foreground="#111827"
                                                               HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Quick Actions -->
                            <StackPanel Grid.Column="2">
                                <Border Margin="0,0,0,16" BorderBrush="#D4E9F9"
                                        BorderThickness="0,0,0,2" Padding="0,0,0,8">
                                    <TextBlock Text="{x:Static res:Strings.DashboardContentView_QuickActions}" FontSize="14"
                                               FontWeight="Bold" Foreground="#002856"/>
                                </Border>

                                <ItemsControl x:Name="QuickActionItems">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" Rows="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#E0E0E0"
                                                    BorderThickness="1" CornerRadius="10"
                                                    Padding="20,16" Margin="{Binding CardMargin, Converter={StaticResource StringToThicknessConverter}}" Cursor="Hand"
                                                    Tag="{Binding Tag}"
                                                    MouseLeftButtonDown="QuickAction_Click"
                                                    MouseEnter="ActionCard_MouseEnter"
                                                    MouseLeave="ActionCard_MouseLeave">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="48" Height="48" CornerRadius="12"
                                                            Background="{Binding IconBackground}"
                                                            HorizontalAlignment="Center" Margin="0,0,0,10">
                                                        <Path Width="22" Height="22" Stretch="Uniform"
                                                              Fill="White" HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Data="{Binding IconData}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}" FontSize="13"
                                                               FontWeight="SemiBold" Foreground="#111827"
                                                               HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                        <!-- Statistics / Weekly Trend -->
                        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                            <Border Margin="0,0,0,16" BorderBrush="#D4E9F9"
                                    BorderThickness="0,0,0,2" Padding="0,0,0,8">
                                <TextBlock Text="{x:Static res:Strings.DashboardContentView_StatisticsWeeklyTrend}" FontSize="14"
                                           FontWeight="Bold" Foreground="#002856"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="{x:Static res:Strings.DashboardContentView_AverageSessionTime}" FontSize="14"
                                           Foreground="#5A6C7D" Margin="0,0,20,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="7.8 min" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#2C3E50" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{x:Static res:Strings.DashboardContentView_StatsPerUser}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#2C3E50" Margin="0,0,0,12"/>

                            <!-- TODO: Stats table is fully hardcoded. Bind to a data source. -->
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8"
                                    ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.ColumnSpan="4"
                                            Background="#F9FAFB"
                                            BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"/>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.DashboardContentView_ColumnUser}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#6B7280" Padding="14,10"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static res:Strings.DashboardContentView_ColumnTests}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#6B7280" Padding="14,10"
                                               TextAlignment="Right"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static res:Strings.DashboardContentView_ColumnRefers}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#6B7280" Padding="14,10"
                                               TextAlignment="Right"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Static res:Strings.DashboardContentView_ColumnPasses}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#6B7280" Padding="14,10"
                                               TextAlignment="Right"/>

                                    <Border Grid.Row="1" Grid.ColumnSpan="4"
                                            BorderBrush="#f0f0f0" BorderThickness="0,0,0,1"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Screener A"
                                               FontSize="13" Foreground="#2C3E50" Padding="14,10"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="18"
                                               FontSize="13" Foreground="#2C3E50" Padding="14,10"
                                               TextAlignment="Right"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="4"
                                               FontSize="13" Foreground="#2C3E50" Padding="14,10"
                                               TextAlignment="Right"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="14"
                                               FontSize="13" Foreground="#2C3E50" Padding="14,10"
                                               TextAlignment="Right"/>

                                    <Border Grid.Row="2" Grid.ColumnSpan="4"
                                            BorderBrush="#f0f0f0" BorderThickness="0,0,0,1"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Screener B"
                                               FontSize="13" Foreground="#2C3E50" Padding="14,10"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="12"
                                               FontSize="13" Foreground="#2C3E50" Padding="14,10"
                                               TextAlignment="Right"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="3"
                                               FontSize="13" Foreground="#2C3E50" Padding="14,10"
                                               TextAlignment="Right"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="9"
                                               FontSize="13" Foreground="#2C3E50" Padding="14,10"
                                               TextAlignment="Right"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Screener C"
                                               FontSize="13" Foreground="#2C3E50" Padding="14,10"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="15"
                                               FontSize="13" Foreground="#2C3E50" Padding="14,10"
                                               TextAlignment="Right"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="5"
                                               FontSize="13" Foreground="#2C3E50" Padding="14,10"
                                               TextAlignment="Right"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="10"
                                               FontSize="13" Foreground="#2C3E50" Padding="14,10"
                                               TextAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>