<UserControl x:Class="AccuSync.WPF.Views.SystemConfiguration.SystemConfigContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AccuSync.WPF.Views.SystemConfiguration"
             xmlns:res="clr-namespace:AccuSync.WPF.Resources"
             Background="Transparent">

    <UserControl.Resources>
        <SolidColorBrush x:Key="MidnightBrush"      Color="#002856"/>
        <SolidColorBrush x:Key="PurpleBrush"        Color="#473089"/>
        <SolidColorBrush x:Key="TextBrush"          Color="#5C5149"/>
        <SolidColorBrush x:Key="LabelBrush"         Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderBrush"        Color="#D1D5DB"/>
        <SolidColorBrush x:Key="BgLightBrush"       Color="#f8f9fa"/>
        <SolidColorBrush x:Key="FilledBorderBrush"  Color="#28a745"/>
        <SolidColorBrush x:Key="SectionUnderline"   Color="#D4E9F9"/>
        <SolidColorBrush x:Key="GrayBrush"          Color="#9EA2AC"/>
        <SolidColorBrush x:Key="TextDefaultBrush"   Color="#4b5563"/>

        <Style x:Key="BrowseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#5C5149"/>
            <Setter Property="BorderBrush" Value="#5C5149"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F3F0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E8E0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RestoreButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#f3f4f6"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#e5e7eb"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#d1d5db"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#D4E9F9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <Grid x:Name="NormalConfigGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="900"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="15" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270"
                                      ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3A3A3C" Offset="0"/>
                                <GradientStop Color="#202124" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{x:Static res:Strings.SystemConfigContentView_Title}" FontSize="14"
                                   FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- ScrollViewer inside the panel — scrollbar appears within the white card -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24">

                            <!-- Language Configuration -->
                            <Border Margin="0,0,0,24">
                                <StackPanel>
                                    <Border BorderThickness="0,0,0,2" BorderBrush="{StaticResource SectionUnderline}"
                                        Padding="0,0,0,8" Margin="0,0,0,16">
                                        <TextBlock Text="{x:Static res:Strings.SystemConfigContentView_LanguageConfiguration}" FontSize="14"
                                               FontWeight="Bold" Foreground="{StaticResource TextDefaultBrush}"/>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Static res:Strings.SystemConfigContentView_SystemLanguage}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextDefaultBrush}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="SystemLanguageCombo"
                                                  Style="{StaticResource FormComboBoxStyle}"
                                                  SelectedIndex="0"
                                                  SelectionChanged="ComboBox_SelectionChanged">
                                                <ComboBoxItem Content="{x:Static res:Strings.SystemConfigContentView_English}"/>
                                                <ComboBoxItem Content="{x:Static res:Strings.SystemConfigContentView_French}"/>
                                                <ComboBoxItem Content="{x:Static res:Strings.SystemConfigContentView_Italian}"/>
                                                <ComboBoxItem Content="{x:Static res:Strings.SystemConfigContentView_German}"/>
                                                <ComboBoxItem Content="{x:Static res:Strings.SystemConfigContentView_Spanish}"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Data Confirmation -->
                            <Border Margin="0,0,0,24">
                                <StackPanel>
                                    <Border BorderThickness="0,0,0,2" BorderBrush="{StaticResource SectionUnderline}"
                                        Padding="0,0,0,8" Margin="0,0,0,16">
                                        <TextBlock Text="{x:Static res:Strings.SystemConfigContentView_DataConfirmation}" FontSize="14"
                                               FontWeight="Bold" Foreground="{StaticResource TextDefaultBrush}"/>
                                    </Border>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Static res:Strings.SystemConfigContentView_ConfirmationOfSaving}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextDefaultBrush}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="ConfirmSaveCombo"
                                                  Style="{StaticResource FormComboBoxStyle}"
                                                  SelectedIndex="0"
                                                  SelectionChanged="ComboBox_SelectionChanged">
                                                <ComboBoxItem Content="{x:Static res:Strings.SystemConfigContentView_Yes}"/>
                                                <ComboBoxItem Content="{x:Static res:Strings.SystemConfigContentView_No}"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{x:Static res:Strings.SystemConfigContentView_ConfirmDelete}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextDefaultBrush}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="ConfirmDeleteCombo"
                                                  Style="{StaticResource FormComboBoxStyle}"
                                                  SelectedIndex="0"
                                                  SelectionChanged="ComboBox_SelectionChanged">
                                                <ComboBoxItem Content="{x:Static res:Strings.SystemConfigContentView_Yes}"/>
                                                <ComboBoxItem Content="{x:Static res:Strings.SystemConfigContentView_No}"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Static res:Strings.SystemConfigContentView_DataModificationWarning}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextDefaultBrush}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="DataModWarningCombo"
                                                  Style="{StaticResource FormComboBoxStyle}"
                                                  SelectedIndex="0"
                                                  SelectionChanged="ComboBox_SelectionChanged">
                                                <ComboBoxItem Content="{x:Static res:Strings.SystemConfigContentView_Yes}"/>
                                                <ComboBoxItem Content="{x:Static res:Strings.SystemConfigContentView_No}"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Report Configuration -->
                            <Border>
                                <StackPanel>
                                    <Border BorderThickness="0,0,0,2" BorderBrush="{StaticResource SectionUnderline}"
                                        Padding="0,0,0,8" Margin="0,0,0,16">
                                        <TextBlock Text="{x:Static res:Strings.SystemConfigContentView_ReportConfiguration}" FontSize="14"
                                               FontWeight="Bold" Foreground="{StaticResource TextDefaultBrush}"/>
                                    </Border>

                                    <!-- Hospital Logo — supports drag-and-drop or file browse -->
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{x:Static res:Strings.SystemConfigContentView_HospitalLogo}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDefaultBrush}" Margin="0,0,0,6"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Empty state — shown when no logo is loaded -->
                                            <Border x:Name="LogoPreviewBorder"
                                                Grid.Column="0"
                                                Height="120"
                                                Background="#f9fafb"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                AllowDrop="True"
                                                DragEnter="Logo_DragEnter"
                                                DragLeave="Logo_DragLeave"
                                                Drop="Logo_Drop">
                                                <StackPanel x:Name="LogoEmptyState"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <Path Width="36" Height="36" Stretch="Uniform"
                                                      Fill="{StaticResource GrayBrush}" Opacity="0.5"
                                                      HorizontalAlignment="Center"
                                                      Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                                                    <TextBlock Text="{x:Static res:Strings.SystemConfigContentView_NoLogoSelected}" FontSize="12"
                                                           Foreground="{StaticResource GrayBrush}"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                    <TextBlock Text="{x:Static res:Strings.SystemConfigContentView_DragAndDropOrClickBrowse}" FontSize="11"
                                                           Foreground="{StaticResource GrayBrush}" Opacity="0.7"
                                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Selected state — overlays empty state when a logo is loaded -->
                                            <Border x:Name="LogoSelectedState"
                                                Grid.Column="0"
                                                Height="120"
                                                Background="#f9fafb"
                                                BorderBrush="{StaticResource FilledBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Visibility="Collapsed"
                                                Padding="8"
                                                AllowDrop="True"
                                                DragEnter="Logo_DragEnter"
                                                DragLeave="Logo_DragLeave"
                                                Drop="Logo_Drop">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Image x:Name="LogoImage" Grid.Row="0"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="LogoFileInfo" Grid.Row="1"
                                                       FontSize="11"
                                                       Foreground="{StaticResource GrayBrush}"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Margin="0,4,0,0"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Button x:Name="BrowseButton"
                                                    Style="{StaticResource BrowseButtonStyle}"
                                                    Click="Browse_Click" Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Width="16" Height="16" Stretch="Uniform"
                                                          Fill="#5C5149" Margin="0,0,6,0"
                                                          VerticalAlignment="Center"
                                                          Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/>
                                                        <TextBlock Text="{x:Static res:Strings.SystemConfigContentView_Browse}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="RestoreDefaultButton"
                                                    Style="{StaticResource RestoreButtonStyle}"
                                                    Click="RestoreDefault_Click"
                                                    IsEnabled="False">
                                                    <TextBlock Text="{x:Static res:Strings.SystemConfigContentView_RestoreDefault}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Static res:Strings.SystemConfigContentView_PaperFormat}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextDefaultBrush}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="PaperFormatCombo"
                                                  Style="{StaticResource FormComboBoxStyle}"
                                                  SelectedIndex="0"
                                                  SelectionChanged="ComboBox_SelectionChanged">
                                                <ComboBoxItem Content="{x:Static res:Strings.SystemConfigContentView_PaperFormatA4}"/>
                                                <ComboBoxItem Content="{x:Static res:Strings.SystemConfigContentView_PaperFormatLetter}"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Sub-config takeover views — collapsed by default, shown via sidebar navigation -->
        <local:RiskFactorsConfigView x:Name="RiskFactorsView" Visibility="Collapsed"/>
        <local:CommentsConfigView x:Name="CommentsView" Visibility="Collapsed"/>
        <local:FieldSetupConfigView x:Name="FieldSetupView" Visibility="Collapsed"/>
        <local:UserProfileConfigView x:Name="UserProfileConfigView" Visibility="Collapsed"/>
        <local:SiteFacilityConfigView x:Name="SiteFacilityConfigView" Visibility="Collapsed"/>
        <local:ImportConfigView x:Name="ImportConfigView" Visibility="Collapsed"/>
        <local:ExportConfigView x:Name="ExportConfigView" Visibility="Collapsed"/>
    </Grid>
</UserControl>
