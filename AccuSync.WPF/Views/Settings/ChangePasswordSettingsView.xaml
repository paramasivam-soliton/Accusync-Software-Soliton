<UserControl x:Class="AccuSync.WPF.Views.Settings.ChangePasswordSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AccuSync.WPF.Resources"
             Background="Transparent">

    <StackPanel>
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="#dc3545"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- New Password -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="{x:Static res:Strings.SettingsContentView_Password}" FontSize="13" FontWeight="SemiBold"
                           Foreground="#4b5563" Margin="0,0,0,6"/>
                <Grid>
                    <PasswordBox x:Name="NewPasswordMasked"
                                 Style="{StaticResource FormPasswordBoxStyle}"
                                 PasswordChanged="NewPasswordMasked_PasswordChanged"/>
                    <TextBox x:Name="NewPasswordPlain"
                             Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Visibility="Collapsed"/>
                    <Button x:Name="NewPasswordToggle"
                            Style="{StaticResource EyeToggleButton}"
                            HorizontalAlignment="Right" Margin="0,0,4,0"
                            Click="ToggleNewPasswordVisibility_Click">
                        <Path x:Name="NewPasswordEyeIcon" Width="16" Height="16"
                              Stretch="Uniform" Fill="#6B7280"
                              Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Verification -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="{x:Static res:Strings.SettingsContentView_Verification}" FontSize="13" FontWeight="SemiBold"
                           Foreground="#4b5563" Margin="0,0,0,6"/>
                <Grid>
                    <PasswordBox x:Name="ConfirmPasswordMasked"
                                 Style="{StaticResource FormPasswordBoxStyle}"
                                 PasswordChanged="ConfirmPasswordMasked_PasswordChanged"/>
                    <TextBox x:Name="ConfirmPasswordPlain"
                             Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Visibility="Collapsed"/>
                    <Button x:Name="ConfirmPasswordToggle"
                            Style="{StaticResource EyeToggleButton}"
                            HorizontalAlignment="Right" Margin="0,0,4,0"
                            Click="ToggleConfirmPasswordVisibility_Click">
                        <Path x:Name="ConfirmPasswordEyeIcon" Width="16" Height="16"
                              Stretch="Uniform" Fill="#6B7280"
                              Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Password Requirements Checklist -->
        <StackPanel Margin="0,16,0,20">
            <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_PasswordRequirements}"
                       FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,10"/>

            <UniformGrid Columns="2" Rows="3">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{Binding HasMinimumLength, Converter={StaticResource BooleanToColorConverter}}"
                          Data="{Binding HasMinimumLength, Converter={StaticResource BooleanToCheckIconConverter}}"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_ReqMinLength}" FontSize="12" Foreground="#5A6C7D" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{Binding HasUpperCase, Converter={StaticResource BooleanToColorConverter}}"
                          Data="{Binding HasUpperCase, Converter={StaticResource BooleanToCheckIconConverter}}"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_ReqUpperCase}" FontSize="12" Foreground="#5A6C7D" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{Binding HasLowerCase, Converter={StaticResource BooleanToColorConverter}}"
                          Data="{Binding HasLowerCase, Converter={StaticResource BooleanToCheckIconConverter}}"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_ReqLowerCase}" FontSize="12" Foreground="#5A6C7D" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{Binding HasNumber, Converter={StaticResource BooleanToColorConverter}}"
                          Data="{Binding HasNumber, Converter={StaticResource BooleanToCheckIconConverter}}"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_ReqNumber}" FontSize="12" Foreground="#5A6C7D" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{Binding HasSpecialChar, Converter={StaticResource BooleanToColorConverter}}"
                          Data="{Binding HasSpecialChar, Converter={StaticResource BooleanToCheckIconConverter}}"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_ReqSpecialChar}" FontSize="12" Foreground="#5A6C7D" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{Binding PasswordsMatch, Converter={StaticResource BooleanToColorConverter}}"
                          Data="{Binding PasswordsMatch, Converter={StaticResource BooleanToCheckIconConverter}}"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="{x:Static res:Strings.ChangePasswordWindow_ReqPasswordsMatch}" FontSize="12" Foreground="#5A6C7D" VerticalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </StackPanel>
</UserControl>
