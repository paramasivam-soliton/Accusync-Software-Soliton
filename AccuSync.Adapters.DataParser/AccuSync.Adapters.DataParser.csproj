<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- -windows (not UseWPF) is needed: OCR/QR parsing depends on
         System.Drawing.Common. No type here references WPF/PresentationFramework —
         IQrCodeGenerator returns raw PNG bytes; the View layer converts to BitmapImage. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>annotations</Nullable>
    <AssemblyName>AccuSync.Adapters.DataParser</AssemblyName>
    <RootNamespace>AccuSync.Adapters.DataParser</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>RELEASE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\OCR\tessdata\eng.traineddata" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\OCR\tessdata\eng.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- The only project in the solution allowed to know about these
         file-format/OCR/QR libraries. -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccuSync.Application\AccuSync.Application.csproj" />
  </ItemGroup>

</Project>
