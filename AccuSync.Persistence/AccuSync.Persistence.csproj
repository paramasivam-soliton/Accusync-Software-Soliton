<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>annotations</Nullable>
    <AssemblyName>AccuSync.Persistence</AssemblyName>
    <RootNamespace>AccuSync.Persistence</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>RELEASE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provider-agnostic: EF Core + Relational only. No provider package here —
         that is AccuSync.SQLite's job. This project must compile and run without
         knowing which database engine is in use. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needs IUserRepository, IUnitOfWork, IClock, IEncryptionService, and the User model. -->
    <ProjectReference Include="..\AccuSync.Application\AccuSync.Application.csproj" />
  </ItemGroup>

</Project>
