<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- UseWPF is needed for now: RelayCommand uses CommandManager, SplashViewModel calls
         Application.Current.Shutdown(), and PatientViewModel exposes a BitmapImage property.
         These are the few remaining WPF-specific touch points in this layer; everything else
         (ICommand, INotifyPropertyChanged, ObservableCollection<T>) is plain BCL and portable. -->
    <UseWPF>true</UseWPF>
    <Nullable>annotations</Nullable>
    <AssemblyName>AccuSync.Presentation</AssemblyName>
    <RootNamespace>AccuSync.Presentation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Application: still needed for QRCodeHelper and other non-abstraction helpers.
         Core: User entity + IUserService/IAuthenticationService/IEncryptionService. -->
    <ProjectReference Include="..\AccuSync.Application\AccuSync.Application.csproj" />
    <ProjectReference Include="..\AccuSync.Core\AccuSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets tests call the internal async methods behind each RelayCommand (e.g.
         LoginViewModel.SignInAsync) directly, instead of racing ICommand.Execute's
         async-void fire-and-forget. -->
    <InternalsVisibleTo Include="AccuSync.Presentation.Tests" />
  </ItemGroup>

</Project>
