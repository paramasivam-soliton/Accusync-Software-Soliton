<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- UseWPF is needed for now: RelayCommand uses CommandManager, SplashViewModel calls
         Application.Current.Shutdown(), and PatientViewModel exposes a BitmapImage property.
         These are the few remaining WPF-specific touch points in this layer; everything else
         (ICommand, INotifyPropertyChanged, ObservableCollection<T>) is plain BCL and portable. -->
    <UseWPF>true</UseWPF>
    <Nullable>annotations</Nullable>
    <AssemblyName>AccuSync.Presentation</AssemblyName>
    <RootNamespace>AccuSync.Presentation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccuSync.Application\AccuSync.Application.csproj" />
  </ItemGroup>

</Project>
